{
  "schema_version": "phase2-ledger-v1",
  "purpose": "Condition-neutral, blinded run evidence; quality is separate from diagnostics.",
  "required_fields": [
    "run_id", "blind_pair_id", "task_id", "family", "task_identity",
    "test_receipts", "timestamps", "quality", "diagnostics", "cost", "latency"
  ],
  "opaque_identifiers": {
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9]{16}$", "meaning": "Opaque per-run identifier."},
    "blind_pair_id": {"type": "string", "pattern": "^pair-[a-z0-9]{16}$", "meaning": "Opaque join key shared only by the paired observations."}
  },
  "task_identity": {
    "required": ["suite_version", "task_id", "prompt_sha256", "fixture_sha256", "oracle_sha256", "reset_sha256"],
    "condition_independent": true,
    "hash_algorithm": "sha256"
  },
  "test_receipts": {
    "type": "array",
    "item_required": ["name", "command", "exit_code", "started_at", "finished_at"],
    "exit_code_type": "integer"
  },
  "timestamps": {"required": ["started_at", "finished_at"], "format": "UTC ISO-8601"},
  "quality": {
    "required": ["oracle_exit_code", "oracle_passed", "protected_paths_preserved"],
    "excludes": ["model", "arm", "condition", "diagnostic_results", "cost", "latency"]
  },
  "diagnostics": {
    "required": ["codebase_memory", "git", "cortex_mcp", "lifecycle", "transport"],
    "excluded_from_quality": true,
    "hard_stop_fields": ["cortex_mcp", "lifecycle", "transport"]
  },
  "cost": {
    "fields": ["input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens", "currency_cost"],
    "missing_value": "null",
    "missing_reason_field": "unavailable_reason",
    "null_is_zero": false
  },
  "latency": {
    "fields": ["wall_seconds"],
    "missing_value": "null",
    "missing_reason_field": "unavailable_reason",
    "null_is_zero": false
  },
  "blinded_scoring": {
    "join_on": ["blind_pair_id", "task_id"],
    "scorer_inputs": ["task_id", "family", "task_identity", "test_receipts", "quality"],
    "excluded_from_scorer_inputs": ["run_id", "diagnostics", "cost", "latency"],
    "no_condition_mapping": true,
    "reveal_authority": "coordinator"
  }
}
