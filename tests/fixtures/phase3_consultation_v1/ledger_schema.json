{
  "schema_version": "phase3-consultation-ledger-v1",
  "purpose": "Blinded, condition-neutral consultation-effect evidence; protocol and quality are separate from diagnostics and availability.",
  "required_top_level": ["suite_version", "records"],
  "record_count": 30,
  "pair_count": 15,
  "required_record_fields": ["run_id", "blind_pair_id", "case_id", "family", "kind", "repeat", "task_identity", "terminal_receipt", "quality", "consultation", "cost", "latency", "diagnostics"],
  "opaque_identifiers": {
    "run_id": {"pattern": "^run-[a-z0-9]{16}$", "meaning": "Opaque run identifier."},
    "blind_pair_id": {"pattern": "^pair-[a-z0-9]{16}$", "meaning": "Opaque pair join key shared by exactly two rows."}
  },
  "task_identity": {
    "required": ["suite_version", "case_id", "prompt_sha256", "fixture_sha256", "oracle_sha256", "reset_sha256", "dependency_envelope_sha256", "payload_identity"],
    "condition_independent": true,
    "hash_algorithm": "sha256"
  },
  "terminal_receipt": {"required": ["status", "audit_status", "exit_code"], "exit_code_type": "integer", "success_status": "complete"},
  "quality": {
    "required": ["critical_decision_defects", "requirement_coverage", "discriminating_check_use", "false_consultation_activation", "missed_qualifying_transition", "protocol_pass", "acceptance_regression", "protected_content_preserved"],
    "integer_fields": ["critical_decision_defects", "false_consultation_activation", "missed_qualifying_transition"],
    "rate_fields": ["requirement_coverage", "discriminating_check_use"],
    "excludes": ["arm", "condition", "diagnostics", "availability", "cost", "latency"]
  },
  "consultation": {
    "required": ["count", "applicable"],
    "count_integer": true,
    "applicable_values": [true, false, null],
    "null_reason_field": "unavailable_reason",
    "max_count_for_quality_screen": 1
  },
  "cost": {
    "fields": ["input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
    "missing_value": null,
    "null_is_zero": false,
    "missing_reason_field": "unavailable_reason"
  },
  "latency": {"fields": ["wall_seconds"], "missing_value": null, "null_is_zero": false, "missing_reason_field": "unavailable_reason"},
  "diagnostics": {"required": ["availability", "codebase_memory", "provider", "gateway", "dependency", "git"], "excluded_from_quality": true},
  "blinded_scoring": {
    "join_on": ["blind_pair_id", "case_id", "repeat"],
    "scorer_inputs": ["suite_version", "case_id", "family", "kind", "repeat", "task_identity", "terminal_receipt", "quality", "consultation"],
    "excluded_from_scorer_inputs": ["run_id", "arm", "condition", "diagnostics", "cost", "latency", "payload_mapping"],
    "reveal_authority": "coordinator",
    "no_condition_mapping": true
  }
}
