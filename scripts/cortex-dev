#!/usr/bin/env bash
# Start an interactive Codex session backed by the isolated Cortex dev runtime.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
project_dir="$(cd -- "${script_dir}/.." && pwd -P)"
caller_workdir="$(pwd -P)"
original_home="$(cd -- "${HOME:?HOME is required}" && pwd -P)"
dev_home="${original_home}/.cortex-dev"

prepare_only=0
if [[ $# -gt 0 && "${1}" == "--prepare-only" ]]; then
  prepare_only=1
  shift
fi

if [[ $# -gt 0 && "${1}" == "--help" ]]; then
  cat <<'EOF'
Usage: scripts/cortex-dev [--prepare-only] [codex arguments]

Start ordinary interactive Codex with a persistent, isolated Cortex candidate
runtime at $HOME/.cortex-dev. The stable HOME and CODEX_HOME are not modified.

--prepare-only refreshes and verifies that candidate without starting Codex so
the repository's Desktop live-dev launcher can use the same exact runtime.
EOF
  exit 0
fi

python3 -B - "${original_home}" "${dev_home}" "${project_dir}" <<'PY'
import sys
from pathlib import Path

original_home = Path(sys.argv[1]).resolve(strict=True)
dev_home = Path(sys.argv[2]).absolute()
project_root = Path(sys.argv[3]).resolve(strict=True)
expected = original_home / ".cortex-dev"
if dev_home != expected or dev_home in {Path("/"), original_home, project_root}:
    raise SystemExit("error: Cortex dev home must be the exact dedicated $HOME/.cortex-dev directory")
for path, label in ((original_home, "HOME"), (project_root, "project root")):
    if not path.is_dir() or path.is_symlink():
        raise SystemExit(f"error: {label} must be a regular directory")
current = dev_home
while current != original_home:
    if current.exists() and current.is_symlink():
        raise SystemExit(f"error: Cortex dev home must not traverse symlinks: {current}")
    current = current.parent
if dev_home.exists() and not dev_home.is_dir():
    raise SystemExit("error: Cortex dev home must be a directory")
PY

umask 077
mkdir -p -- "${dev_home}/.codex"
chmod 700 "${dev_home}" "${dev_home}/.codex"

# Native workers and the root coordinator share one Codex MCP catalogue.  The
# isolated profile therefore receives only the non-secret executable
# definition of the user's already configured Codebase Memory server.  Inline
# environment values, headers, URLs, and other credential-bearing forms from
# that config are deliberately unsupported.  The helper adds only the validated
# owning HOME needed to run this external production MCP from the dev session.
python3 -B - "${original_home}/.codex/config.toml" "${dev_home}/.codex/config.toml" "${original_home}" <<'PY'
import json
import os
import stat
import sys
import tempfile
import tomllib
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
owner_home = Path(sys.argv[3]).resolve(strict=True)
if not source.exists():
    print("Codebase Memory MCP unavailable; isolated candidate will exercise the bounded worker fallback")
    raise SystemExit(0)
if source.is_symlink() or not source.is_file():
    raise SystemExit("error: stable Codex config must be a regular non-symlink file")
try:
    payload = tomllib.loads(source.read_text(encoding="utf-8"))
except (OSError, UnicodeError, tomllib.TOMLDecodeError) as exc:
    raise SystemExit(f"error: cannot parse stable Codex config for Codebase Memory MCP: {exc}") from None

servers = payload.get("mcp_servers")
server = servers.get("codebase_memory") if isinstance(servers, dict) else None
if not isinstance(server, dict):
    print("Codebase Memory MCP unavailable; isolated candidate will exercise the bounded worker fallback")
    raise SystemExit(0)

# The allow-list contains routing and executable metadata only.  In
# particular, never copy TOML env tables or values from the stable profile.
allowed = {
    "enabled", "command", "args", "cwd", "startup_timeout_sec",
    "tool_timeout_sec", "default_tools_approval_mode", "env_vars",
}
secret_forms = {"env", "environment", "headers", "authorization", "url", "http_url"}
if secret_forms.intersection(server):
    raise SystemExit(
        "error: Codebase Memory MCP uses credential-bearing configuration; "
        "isolated Cortex launch refuses to copy it"
    )
unknown = set(server) - allowed
if unknown:
    names = ", ".join(sorted(str(item) for item in unknown))
    raise SystemExit(f"error: Codebase Memory MCP has unsupported configuration fields: {names}")

command = server.get("command")
if not isinstance(command, str) or not command.strip() or "\n" in command or "\r" in command:
    raise SystemExit("error: Codebase Memory MCP command must be a non-empty single-line string")
args = server.get("args", [])
if not isinstance(args, list) or any(not isinstance(item, str) or "\n" in item or "\r" in item for item in args):
    raise SystemExit("error: Codebase Memory MCP args must be a list of single-line strings")
env_vars = server.get("env_vars", [])
if not isinstance(env_vars, list) or any(not isinstance(item, str) or not item or "\n" in item or "\r" in item for item in env_vars):
    raise SystemExit("error: Codebase Memory MCP env_vars must name single-line environment variables")
for key in ("startup_timeout_sec", "tool_timeout_sec"):
    value = server.get(key)
    if value is not None and (not isinstance(value, int) or isinstance(value, bool) or value <= 0):
        raise SystemExit(f"error: Codebase Memory MCP {key} must be a positive integer")
approval = server.get("default_tools_approval_mode")
if approval is not None and approval not in {"auto", "prompt", "writes", "approve"}:
    raise SystemExit("error: Codebase Memory MCP default_tools_approval_mode is invalid")
enabled = server.get("enabled", True)
if not isinstance(enabled, bool):
    raise SystemExit("error: Codebase Memory MCP enabled must be boolean")
if enabled is not True:
    print("Codebase Memory MCP disabled; isolated candidate will exercise the bounded worker fallback")
    raise SystemExit(0)
cwd = server.get("cwd")
if cwd is not None and (not isinstance(cwd, str) or not cwd.strip() or "\n" in cwd or "\r" in cwd):
    raise SystemExit("error: Codebase Memory MCP cwd must be a non-empty single-line string")

def toml_value(value):
    # JSON literals for these primitive/list values are valid TOML literals
    # and avoid introducing a second parser or interpolating user text.
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))

managed_marker = "# Isolated Cortex worker projection; copied without secret values.\n"
lines = [managed_marker, "[mcp_servers.codebase_memory]\n"]
for key in ("enabled", "command", "args", "cwd", "startup_timeout_sec", "tool_timeout_sec", "default_tools_approval_mode", "env_vars"):
    if key in server:
        lines.append(f"{key} = {toml_value(server[key])}\n")
# Cortex itself must remain inside the isolated HOME, but this external MCP is
# the user's already installed production service.  Give only that child
# process its owning HOME so the copied production command can initialize its
# existing runtime/state.  This is generated locally from the validated owner
# directory; it is not copied from an arbitrary env table or secret value.
lines.append(f"env = {{ HOME = {toml_value(str(owner_home))} }}\n")
target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
if target.exists() and (target.is_symlink() or not target.is_file()):
    raise SystemExit("error: isolated Codex config must be a regular non-symlink file")
mode = stat.S_IMODE(target.stat().st_mode) if target.exists() else 0o600
if target.exists():
    original = target.read_text(encoding="utf-8")
else:
    original = ""
# The helper is idempotent across repeated cortex-dev launches.  sync-cortex
# retains the isolated config, so do not append a second table on the next
# launch; a changed or tampered worker definition fails closed instead.
if original:
    try:
        existing_payload = tomllib.loads(original)
    except tomllib.TOMLDecodeError as exc:
        raise SystemExit(f"error: isolated Codex config is invalid: {exc}") from None
    existing_servers = existing_payload.get("mcp_servers")
    existing_server = existing_servers.get("codebase_memory") if isinstance(existing_servers, dict) else None
    if existing_server is not None:
        expected_server = {key: server[key] for key in allowed if key in server}
        expected_server["env"] = {"HOME": str(owner_home)}
        if existing_server != expected_server:
            # Upgrade only the exact block previously generated by this helper.
            # Any independently authored isolated definition still fails closed.
            managed_lines = original.splitlines(keepends=True)
            try:
                marker_index = managed_lines.index(managed_marker)
            except ValueError:
                raise SystemExit(
                    "error: isolated Codebase Memory MCP definition differs from the stable non-secret definition; "
                    "reset the dedicated .cortex-dev profile before relaunching"
                ) from None
            end_index = len(managed_lines)
            for index in range(marker_index + 2, len(managed_lines)):
                if managed_lines[index].lstrip().startswith("["):
                    end_index = index
                    break
            original = "".join(managed_lines[:marker_index] + managed_lines[end_index:]).lstrip("\n")
        else:
            print("isolated Codebase Memory MCP definition already present")
            raise SystemExit(0)
text = "".join(lines)
if original:
    if not original.endswith("\n"):
        original += "\n"
    if not original.endswith("\n\n"):
        original += "\n"
text = original + text
try:
    parsed = tomllib.loads(text)
except tomllib.TOMLDecodeError as exc:
    raise SystemExit(f"error: isolated Codex config cannot retain Codebase Memory MCP: {exc}") from None
if "codebase_memory" not in parsed.get("mcp_servers", {}):
    raise SystemExit("error: isolated Codex config did not retain Codebase Memory MCP")
fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=str(target.parent))
try:
    with os.fdopen(fd, "w", encoding="utf-8", newline="") as stream:
        stream.write(text)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, mode)
    os.replace(temporary, target)
except Exception:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
print("configured isolated Codebase Memory MCP from the stable non-secret server definition")
PY

export HOME="${dev_home}"
export CODEX_HOME="${HOME}/.codex"
# Authorize the sync helper to reconcile only this exact isolated marketplace
# registration.  The helper independently validates all three lexical paths
# before it can remove or add a marketplace, so this marker cannot widen the
# supported path to the stable profile.
export CORTEX_ISOLATED_MARKETPLACE_RECONCILE=1
export CORTEX_ISOLATED_DEV_OWNER_HOME="${original_home}"
export CORTEX_ISOLATED_DEV_CODEX_HOME="${CODEX_HOME}"
cd -- "${project_dir}"
printf 'Cortex isolated candidate target: HOME=%s CODEX_HOME=%s\n' "${HOME}" "${CODEX_HOME}"
./scripts/sync-cortex.sh
candidate_identity="$({
  python3 -B "${script_dir}/cortex_candidate_receipt.py" verify \
    --source-root "${project_dir}" \
    --owner-home "${original_home}" \
    --isolated-home "${HOME}" \
    --isolated-codex-home "${CODEX_HOME}"
})" || {
  echo "error: isolated Cortex candidate provenance verification failed; Codex will not start" >&2
  exit 1
}
candidate_version="$(python3 -B -c 'import json,sys; print(json.loads(sys.stdin.read())["base_version"])' <<<"${candidate_identity}")"
candidate_build_id="$(python3 -B -c 'import json,sys; print(json.loads(sys.stdin.read())["build_id"])' <<<"${candidate_identity}")"
candidate_source_digest="$(python3 -B -c 'import json,sys; print(json.loads(sys.stdin.read())["source_digest"])' <<<"${candidate_identity}")"
candidate_digest_value="$(python3 -B -c 'import json,sys; print(json.loads(sys.stdin.read())["candidate_digest"])' <<<"${candidate_identity}")"
candidate_path="$(python3 -B -c 'import json,sys; print(json.loads(sys.stdin.read())["candidate_path"])' <<<"${candidate_identity}")"
candidate_stamp="$(python3 -B -c 'import json,sys; print(json.loads(sys.stdin.read())["candidate_version"])' <<<"${candidate_identity}")"
candidate_receipt="${CODEX_HOME}/.cortex-candidate-receipt.json"
live_state_file="$(python3 -B -c 'import os; print("/tmp/cortex-live-smoke-%s/session.json" % os.getuid())')"
session_nonce=""
live_binding_path=""
live_smoke_launch="${CORTEX_LIVE_SMOKE_LAUNCH:-}"
if [[ "${live_smoke_launch}" == "1" ]]; then
  mapfile -t live_identity < <(python3 -B - "${live_state_file}" "${CODEX_HOME}" "${caller_workdir}" <<'PY'
import hashlib, json, os, pathlib, stat, sys
state_path, codex_home, caller_workdir = map(pathlib.Path, sys.argv[1:])
try:
    info = state_path.lstat()
    if state_path.is_symlink() or not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError
    state = json.loads(state_path.read_text(encoding="utf-8"))
    resolved_home = codex_home.resolve(strict=True)
    expected_fingerprint = hashlib.sha256(str(resolved_home).encode()).hexdigest()
    expected_binding = resolved_home / ".cortex-live-binding.json"
    nonce = state.get("session_nonce")
    binding = pathlib.Path(str(state.get("binding_path", "")))
    if (state.get("workdir") != str(caller_workdir.resolve(strict=True))
            or state.get("isolated_codex_fingerprint") != expected_fingerprint
            or binding != expected_binding
            or not isinstance(nonce, str) or len(nonce) != 64
            or any(character not in "0123456789abcdef" for character in nonce)):
        raise ValueError
except (OSError, ValueError, TypeError, json.JSONDecodeError):
    raise SystemExit("error: live-smoke state does not match this isolated launch")
print(nonce)
print(binding)
PY
  )
  if [[ "${#live_identity[@]}" -ne 2 ]]; then
    echo "error: live-smoke identity is unavailable; Codex will not start" >&2
    exit 1
  fi
  session_nonce="${live_identity[0]}"
  live_binding_path="${live_identity[1]}"
  export CORTEX_SESSION_NONCE="${session_nonce}"
  export CORTEX_LIVE_BINDING_PATH="${live_binding_path}"
  python3 -B "${script_dir}/cortex_observation_generation.py" \
    --receipt "${candidate_receipt}" --session-nonce "${session_nonce}" >/dev/null || {
    echo "error: isolated Cortex observation generation request failed; Codex will not start" >&2
    exit 1
  }
fi
printf 'Cortex server version=%s\n' "${candidate_version}"
printf 'Cortex candidate version=%s\n' "${candidate_stamp}"
printf 'Cortex candidate build=%s\n' "${candidate_build_id}"
printf 'Cortex source digest=%s\n' "${candidate_source_digest}"
printf 'Cortex candidate digest=%s\n' "${candidate_digest_value}"
printf 'Cortex source/candidate parity=verified\n'
printf 'Cortex candidate path=%s\n' "${candidate_path}"
printf 'Cortex candidate receipt=%s\n' "${candidate_receipt}"
export CORTEX_BUILD_ID="${candidate_build_id}"
export CORTEX_SOURCE_DIGEST="${candidate_source_digest}"
export CORTEX_CANDIDATE_PATH="${candidate_path}"
export CORTEX_CANDIDATE_RECEIPT="${candidate_receipt}"
export CORTEX_CANDIDATE_DIGEST="${candidate_digest_value}"
export CORTEX_HOOK_DIAGNOSTIC=1
export CORTEX_RAW_DIAGNOSTIC=1
if [[ "${prepare_only}" == "1" ]]; then
  if [[ $# -ne 0 ]]; then
    echo "error: --prepare-only does not accept Codex arguments" >&2
    exit 2
  fi
  printf 'Cortex isolated candidate prepared for Desktop live-dev\n'
  exit 0
fi
cd -- "${caller_workdir}"
# Bind the upcoming Codex exec to the live-dev launch receipt.  exec preserves
# this PID, allowing the trusted SessionStart observer to correlate one root
# session without global session-file or timestamp selection.
if [[ "${live_smoke_launch}" == "1" ]]; then
python3 -B - "${CODEX_HOME}/.cortex-live-launch.json" "${CORTEX_SESSION_NONCE}" "${caller_workdir}" "${CODEX_HOME}" "$$" <<'PY'
import hashlib, json, os, pathlib, stat, sys
path = pathlib.Path(sys.argv[1]); nonce, cwd, profile, pid = sys.argv[2:]
try:
    if not nonce or not path.exists() or path.is_symlink() or stat.S_IMODE(path.stat().st_mode) != 0o600:
        raise SystemExit(1)
    value = json.loads(path.read_text(encoding='utf-8'))
    if value.get('session_nonce') != nonce or value.get('cwd') != cwd:
        raise SystemExit(1)
    value.update({'pid': int(pid), 'pgid': os.getpgrp(), 'tty': os.ttyname(0) if os.isatty(0) else '', 'profile_fingerprint': hashlib.sha256(str(path.parent.resolve()).encode()).hexdigest(), 'active': True})
    tmp = path.with_suffix('.tmp'); tmp.write_text(json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n'); os.chmod(tmp, 0o600); os.replace(tmp, path); os.chmod(path, 0o600)
except Exception:
    raise SystemExit(1)
PY
fi
exec codex "$@"
