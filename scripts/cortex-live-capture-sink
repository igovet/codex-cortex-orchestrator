#!/usr/bin/env python3
"""Bounded output-only tmux pipe consumer."""
import argparse
import os
import sys
p=argparse.ArgumentParser();p.add_argument('--path',required=True);p.add_argument('--max-bytes',type=int,default=20000);args=p.parse_args()
fd=os.open(args.path,os.O_WRONLY|os.O_CREAT|os.O_NOFOLLOW,0o600)
body=b''
try:
    while True:
        chunk=os.read(sys.stdin.fileno(),4096)
        if not chunk: break
        body=(body+chunk)[-args.max_bytes:]
        os.lseek(fd,0,0);os.write(fd,body);os.ftruncate(fd,len(body))
finally:
    os.close(fd)
