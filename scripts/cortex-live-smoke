LAUNCH_TRANSACTION_SCHEMA='phase2-cli-launch-transaction-v1'
SESSION_BINDING_SCHEMA='phase2-cli-session-binding-v1'
SEND_RECEIPT_SCHEMA='phase2-cli-native-user-turn-receipt-v1'
TRUST_RECEIPT_SCHEMA='phase2-cli-trust-transition-v1'
HOST_DISPATCH_ENVELOPE_CAPABILITY='functions-exec-pre-dispatch-v1'
MCP_FIRST_BOOTSTRAP_ROUTE='current_host_mcp_first'
MCP_FIRST_PROVENANCE_SCHEMA='cortex-mcp-first-root-v1'
MCP_FIRST_HOST_CONTEXT_SCHEMA='cortex-host-bootstrap-context-v1'
MCP_FIRST_HOST_CONTEXT_CAPABILITY='current-host-mcp-first-v1'
PROC_ROOT=Path('/proc')
