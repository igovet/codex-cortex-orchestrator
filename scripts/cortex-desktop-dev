def private():
    STATE.mkdir(mode=0o700,exist_ok=True)
    if STATE.is_symlink() or STATE.stat().st_uid!=os.getuid() or STATE.stat().st_mode&0o077:
        raise RuntimeError('Unsafe Desktop observation directory')


def worker_model_policy(model,effort,task_class='ordinary',explicit_user_override=False,
                        require_explicit=False,implementation_model=None,
                        implementation_effort=None):
    """Return violations for the product worker route matrix.

    This is an audit helper, not a model selector. The coordinator remains the
    owner of routing; an explicit user override is preserved and therefore not
    rewritten as a Cortex policy violation.
    """
    if explicit_user_override:
        return []
    task_class=str(task_class or 'ordinary').strip().lower().replace('_','-')
    aliases={
        'default':'ordinary', 'normal':'ordinary', 'implementation':'ordinary',
        'discovery':'research', 'investigate':'exploration',
        'verification':'review', 'code-review':'review',
        'security-fix':'security-implementation',
        'security-analysis':'security-analysis-microtask',
        'security-analysis-microtask':'security-analysis-microtask',
        'microtask':'security-analysis-microtask',
    }
    task_class=aliases.get(task_class,task_class)
    # Review is an explicit route: Terra is the default review model. A narrowly
    # scoped verification can use its own policy class, but review must not
    # inherit the implementation model or effort.
    choices=WORKER_MODEL_CHOICES.get(task_class)
    errors=[]
    if choices is None:
        errors.append('worker_model_policy_violation')
        return errors
    if require_explicit and (not isinstance(model,str) or not model or
                             not isinstance(effort,str) or not effort):
        return ['worker_model_policy_violation']
    if model is None and effort is None:
        return []
    if model not in choices:
        errors.append('worker_model_policy_violation')
    if model in WORKER_EFFORTS and effort not in WORKER_EFFORTS[model]:
        errors.append('worker_model_policy_violation')
    elif model not in WORKER_EFFORTS and effort is not None:
        errors.append('worker_model_policy_violation')
    required_efforts=CONSULTANT_EFFORTS.get(task_class)
    if required_efforts is not None and effort not in required_efforts:
        errors.append('worker_model_policy_violation')
    return errors


def identity(pid):
    try:return Path(f'/proc/{pid}/stat').read_text().split()[21]
    except (OSError,IndexError):return None


def project_store(workdir):
    """Return the one SQLite location owned by an exact canonical project."""
    project=Path(workdir)
    if not project.is_absolute() or not project.is_dir() or project.resolve(strict=True)!=project:
        raise RuntimeError('workdir must be an absolute existing canonical project directory')
    return project/'.codex/cortex/cortex.sqlite3'


def ensure_git_workspace(workdir):
    """Require an already initialized repository without mutating user settings."""
    workdir=Path(workdir)
    result=subprocess.run(['git','rev-parse','--show-toplevel'],cwd=workdir,
                          capture_output=True,text=True)
    try:root=Path(result.stdout.strip()).resolve(strict=True)
    except (OSError,ValueError):root=None
    if result.returncode or root!=workdir.resolve(strict=True):
        raise RuntimeError(
            'workdir must already be the root of a Git repository; for an isolated '
            'qualification create a fresh empty directory with mktemp -d and run git init explicitly')


def live_test_config(source):
    """Layer the dev-only Luna policy while preserving existing config instructions."""
    parsed=tomllib.loads(source)
    existing=parsed.get('developer_instructions')
    instructions=((existing.rstrip()+'\n\n') if isinstance(existing,str) and existing.strip() else '')+LIVE_DEVELOPER_INSTRUCTIONS
    value_pattern=r'(?:(?:"""(?:(?!""").)*""")|(?:\'\'\'(?:(?!\'\'\').)*\'\'\')|(?:"(?:\\.|[^"\\])*")|(?:\'[^\'\r\n]*\')|(?:[^\r\n]*))'
    def replace(section,key,value):
        nonlocal source
        if section is None:
            pattern=re.compile(r'(?ms)^'+re.escape(key)+r'[ \t]*=[ \t]*'+value_pattern+r'[ \t]*$')
            if key in parsed:
                if not pattern.search(source):raise ValueError('unsupported top-level TOML value for '+key)
                source=pattern.sub(lambda _:key+' = '+value,source,count=1)
            else:
                source=key+' = '+value+'\n'+source
            return
        header=re.search(r'(?m)^\['+re.escape(section)+r'\]\s*$',source)
        if not header:
            source=source+('' if not source or source.endswith('\n') else '\n')+'\n['+section+']\n'+key+' = '+value+'\n';return
        following=re.search(r'(?m)^\[',source[header.end():])
        end=header.end()+(following.start() if following else len(source)-header.end())
        body=source[header.end():end]
        pattern=re.compile(r'(?ms)^'+re.escape(key)+r'[ \t]*=[ \t]*'+value_pattern+r'[ \t]*$')
        body=(pattern.sub(lambda _:key+' = '+value,body,count=1) if pattern.search(body)
              else body+('' if not body or body.endswith('\n') else '\n')+key+' = '+value+'\n')
        source=source[:header.end()]+body+source[end:]
    replace(None,'model',json.dumps(LIVE_MODEL))
    replace(None,'model_reasoning_effort',json.dumps(LIVE_COORDINATOR_EFFORT))
    replace(None,'developer_instructions',json.dumps(instructions))
    replace('agents','default_subagent_model',json.dumps(LIVE_MODEL))
    # Preserve the isolated graph server's enabled state, including explicit opt-out.
    return source


def configure_workspace_network():
    """Enable loopback verification only in the isolated dev Codex profile."""
    config=Path.home()/'.cortex-dev/.codex/config.toml'
    if config.is_symlink() or not config.is_file():
        raise RuntimeError('isolated Codex config must be a regular non-symlink file')
    if CONFIG_BACKUP.exists():
        raise RuntimeError('stale isolated config backup exists; restore it before a new Desktop run')
    original=config.read_bytes()
    CONFIG_BACKUP.write_bytes(original);os.chmod(CONFIG_BACKUP,0o600)
    source=original.decode('utf-8')
    source=live_test_config(source)
    section=re.search(r'(?m)^\[sandbox_workspace_write\]\s*$',source)
    if section:
        end=re.search(r'(?m)^\[',source[section.end():])
        boundary=section.end()+(end.start() if end else len(source)-section.end())
        body=source[section.end():boundary]
        if re.search(r'(?m)^network_access\s*=',body):
            body=re.sub(r'(?m)^network_access\s*=.*$',
                        'network_access = true',body,count=1)
        else:
            body='\nnetwork_access = true'+body
        updated=source[:section.end()]+body+source[boundary:]
    else:
        updated=source.rstrip()+'\n\n[sandbox_workspace_write]\nnetwork_access = true\n'
    temporary=config.with_name('.'+config.name+'.cortex-live')
    try:
        with temporary.open('w',encoding='utf-8',newline='') as target:
            target.write(updated);target.flush();os.fsync(target.fileno())
        os.chmod(temporary,0o600);os.replace(temporary,config)
    except Exception:
        temporary.unlink(missing_ok=True)
        config.write_bytes(original);os.chmod(config,0o600)
        CONFIG_BACKUP.unlink(missing_ok=True)
        raise
    return config


def restore_workspace_network(config):
    if not CONFIG_BACKUP.is_file():
        raise RuntimeError('isolated config backup is missing')
    original=CONFIG_BACKUP.read_bytes()
    temporary=config.with_name('.'+config.name+'.cortex-restore')
    try:
        with temporary.open('wb') as target:
            target.write(original);target.flush();os.fsync(target.fileno())
        os.chmod(temporary,0o600);os.replace(temporary,config)
        CONFIG_BACKUP.unlink()
    finally:
        temporary.unlink(missing_ok=True)


def environment(profile,events):
    env=dict(os.environ)
    owner=Path.home()
    for key in ['CODEX_APP_TOOLS_PIPE_PATH','CODEX_INTERNAL_ORIGINATOR_OVERRIDE','CODEX_MCP_NODE_PATH','CODEX_CI','CODEX_SHELL','CODEX_PERMISSION_PROFILE','CODEX_SESSION_ID','CODEX_THREAD_ID','CORTEX_DATA_DIR']:
        env.pop(key,None)
    dependency_dir=owner/'.cortex-dev/.codex/cortex-deps'
    try:
        resolved=dependency_dir.resolve(strict=True)
        info=dependency_dir.stat()
    except OSError as exc:
        raise RuntimeError('isolated dependency directory is unavailable after preparation') from exc
    if (resolved != dependency_dir or not dependency_dir.is_dir()
            or info.st_uid != os.getuid() or info.st_mode & 0o077):
        raise RuntimeError('isolated dependency directory must be a private owner-controlled directory')
    # Preparation runs in a child process, so its export cannot mutate this
    # Desktop launcher's environment.  Scrub any inherited value and publish
    # only the canonical prepared target to the cached MCP process.
    env.pop('CORTEX_DEPENDENCY_DIR',None)
    env.update(HOME=str(owner/'.cortex-dev'),CODEX_HOME=str(owner/'.cortex-dev/.codex'),
               CODEX_ELECTRON_USER_DATA_PATH=str(profile),CORTEX_OBSERVATION_DIR=str(events),
               CORTEX_DEPENDENCY_DIR=str(dependency_dir),PYTHONDONTWRITEBYTECODE='1')
    return env


def task_thread_scope(root_thread_id,thread_ids,edges):
    """Return only the submitted coordinator and its native descendants."""
    known=set(thread_ids)
    if not root_thread_id:return known
    if root_thread_id not in known:return set()
    scoped={root_thread_id}
    changed=True
    while changed:
        changed=False
        for child,parent in edges.items():
            if child in known and parent in scoped and child not in scoped:
                scoped.add(child);changed=True
    return scoped


def event_in_task_scope(row,thread_ids):
    """Fail closed when any native task identity conflicts with the selected tree."""
    if thread_ids is None:return True
    selected=set(thread_ids)
    identities=[row.get(key) for key in ('thread_id','parent_thread_id','parent_session_id')
                if row.get(key)]
    # Cortex task IDs live in a separate namespace. Some native event shapes use
    # task_id as a thread identity, however, so those values remain fail-closed.
    task_id=row.get('task_id')
    if task_id and not str(task_id).startswith('t_'):identities.append(task_id)
    return not identities or all(identity in selected for identity in identities)


def observed_events(directory,thread_ids=None):
    """Read MCP server events only; hook actions have a separate evidence stream."""
    rows=[]
    for path in Path(directory).glob('*.jsonl'):
        with path.open(encoding='utf-8') as source:
            for line in source:
                try:
                    row=json.loads(line)
                    if row.get('event_kind')!='hook' and event_in_task_scope(row,thread_ids):
                        rows.append(row)
                except ValueError: continue
    return sorted(rows,key=lambda row:row.get('time_ns',0))


def observed_hook_events(directory,thread_ids=None):
    """Return compact hook-action metadata without treating it as a model call."""
    allowed={'timestamp_ns','time_ns','event_kind','hook_event','receipt_digest','result_digest',
             'outcome','duration_ms','tool_name','response_shape',
             'task_id','thread_id','parent_thread_id','role','binding_confidence',
             'binding_origin','source_revision','exit_code','command_session_id','session_id',
             'status','truncated',
             'changed_path_count','changed_paths_digest','diagnostic_codes',
             'action_status','actor_scope','parent_session_id','error_class',
             'error_stage','error_type','authorization_outcome',
             'authorization_capability','authorization_reason','execution_status'}
    rows=[]
    for path in Path(directory).glob('hooks-*.jsonl'):
        with path.open(encoding='utf-8') as source:
            for line in source:
                try:row=json.loads(line)
                except ValueError:continue
                if not isinstance(row,dict) or row.get('event_kind')!='hook':continue
                compact={key:row[key] for key in allowed if key in row}
                if event_in_task_scope(compact,thread_ids):rows.append(compact)
    return sorted(rows,key=lambda row:row.get('timestamp_ns') or row.get('time_ns',0))


TOKEN_FIELDS=('input_tokens','cached_input_tokens','cache_write_input_tokens',
              'output_tokens','reasoning_output_tokens','total_tokens')


def participant_token_usage(state):
    """Count each native response once across the coordinator and every worker."""
    database=Path.home()/'.cortex-dev/.codex/state_5.sqlite'
    empty=dict(status='unavailable',wall_seconds=None,totals=None,participants=[])
    if not database.is_file():return empty
    scope=None
    if state.get('thread_id'):
        scope,foreign_roots,invalid_topology=desktop_task_inventory(state)
        if invalid_topology:
            return dict(status='invalid_topology',wall_seconds=None,totals=None,
                        participants=[],foreign_task_roots=foreign_roots,
                        invalid_task_topology=invalid_topology)
    connection=sqlite3.connect(f'file:{database}?mode=ro',uri=True)
    connection.row_factory=sqlite3.Row
    try:
        threads=connection.execute(
            'SELECT id,rollout_path,agent_role,model,reasoning_effort,created_at '
            'FROM threads WHERE cwd=? AND created_at>=? ORDER BY created_at,id',
            (state['workdir'],int(state.get('thread_created_since',state.get('started_at',0)))-2),
        ).fetchall()
    finally:connection.close()
    if scope is None:scope={row['id'] for row in threads}
    threads=[row for row in threads if row['id'] in scope]
    participants=[];seen=set();latest=None;coordinator_durations=[]
    boundary=float(state.get('trial_started_at',state.get('thread_created_since',state.get('started_at',0))))-2
    for thread in threads:
        totals={field:0 for field in TOKEN_FIELDS};responses=0;parent=None;completed_turns=set();started_turns=set();durations=[]
        path=Path(thread['rollout_path']);inherited_context=False
        if path.is_file():
            with path.open(encoding='utf-8') as source:
                for line in source:
                    try:entry=json.loads(line)
                    except ValueError:continue
                    payload=entry.get('payload',{})
                    if entry.get('type')=='session_meta' and isinstance(payload,dict):
                        metadata_id=payload.get('id')
                        if isinstance(metadata_id,str):
                            inherited_context=metadata_id!=thread['id']
                        if inherited_context:continue
                        provenance=payload.get('source')
                        if isinstance(provenance,dict):
                            parent=(((provenance.get('subagent') or {}).get('thread_spawn') or {})
                                    .get('parent_thread_id'))
                    if (entry.get('type')=='event_msg' and isinstance(payload,dict)
                            and payload.get('type')=='thread_settings_applied'
                            and payload.get('thread_id')==thread['id']):
                        inherited_context=False
                    if inherited_context:continue
                    if (entry.get('type')=='event_msg' and isinstance(payload,dict)
                            and payload.get('type')=='task_started'
                            and isinstance(payload.get('turn_id'),str)):
                        started_turns.add(payload['turn_id'])
                    if (entry.get('type')=='event_msg' and isinstance(payload,dict)
                            and payload.get('type')=='task_complete'
                            and payload.get('turn_id') not in completed_turns
                            and type(payload.get('duration_ms')) in (int,float)
                            and payload['duration_ms']>=0):
                        completed_turns.add(payload.get('turn_id'));durations.append(payload['duration_ms']/1000)
                    if entry.get('type')!='token_usage_record' or not isinstance(payload,dict):continue
                    try:stamp=datetime.fromisoformat(entry['timestamp'].replace('Z','+00:00')).timestamp()
                    except (KeyError,ValueError):continue
                    if stamp<boundary:continue
                    response=payload.get('response_id');usage=payload.get('usage');key=(thread['id'],response)
                    if not isinstance(response,str) or key in seen or not isinstance(usage,dict):continue
                    if any(type(usage.get(field)) is not int or usage[field]<0 for field in TOKEN_FIELDS):continue
                    seen.add(key);responses+=1;latest=max(latest or stamp,stamp)
                    for field in TOKEN_FIELDS:totals[field]+=usage[field]
        role=thread['agent_role'] or ('worker' if parent else 'coordinator')
        if role=='coordinator':coordinator_durations.extend(durations)
        participants.append(dict(thread_id=thread['id'],parent_thread_id=parent,role=role,
                                 model=thread['model'],reasoning_effort=thread['reasoning_effort'],
                                 responses=responses,tokens=totals if responses else None,
                                 terminal=bool(started_turns) and started_turns<=completed_turns))
    complete=bool(participants) and all(row['tokens'] is not None for row in participants)
    aggregate=({field:sum(row['tokens'][field] for row in participants) for field in TOKEN_FIELDS}
               if complete else None)
    submitted=state.get('first_submission_at')
    wall=(sum(coordinator_durations) if coordinator_durations else
          max(0.0,latest-float(submitted)) if latest is not None and submitted is not None else None)
    return dict(status='complete' if complete else 'unavailable',wall_seconds=wall,
                wall_source=('coordinator_task_lifecycle' if coordinator_durations
                             else 'response_span' if wall is not None else None),
                totals=aggregate,participants=participants)


COMMAND_ERROR_PATTERN=re.compile(
    r'(?im)(?:^|\n|["\']output["\']\s*:\s*["\'])(?:fatal:|traceback \(most recent call last\):|npm error (?:code|syscall|errno|request|log files)|error when starting .*server:|curl:\s*\([0-9]+\)|(?:bash|sh): .*command not found)'
)


def observed_outcome(raw,tool=None,arguments=''):
    """Classify a rollout result without returning its possibly private payload."""
    if isinstance(raw,list):
        rendered='\n'.join(str(item.get('text','')) if isinstance(item,dict) else str(item) for item in raw)
    else:rendered=str(raw)
    diagnostic=rendered.replace('\\n','\n')
    if tool=='spawn_agent' and 'agent thread limit reached' in diagnostic.lower():
        return 'error','agent_limit_reached',hashlib.sha256(rendered.encode()).hexdigest()[:12]
    exit_codes=[int(value) for value in re.findall(r'\\?"exit_code\\?"\s*:\s*(-?[0-9]+)',rendered)]
    # A wrapper may emit the command receipt as a separate labelled text item.
    for item in raw if isinstance(raw,list) else []:
        value=item.get('text','') if isinstance(item,dict) else ''
        match=re.fullmatch(r'\s*(?:exit_code|exit_status|__EXEC_EXIT_CODE__)=(-?\d+)\s*',value)
        if match:exit_codes.append(int(match.group(1)))
    session_match=re.search(r'\\?"session_id\\?"\s*:\s*[0-9]+',rendered)
    cell_match=re.search(r'Script running with cell ID\s+[A-Za-z0-9_-]+',rendered)
    explicit_diagnostic=(tool in {'exec_command','write_stdin'} and COMMAND_ERROR_PATTERN.search(diagnostic))
    if 'Script failed' in rendered or 'Script error' in rendered or re.search(r'\\?"isError\\?"\s*:\s*true',rendered):
        outcome='error'
    elif explicit_diagnostic:
        outcome='error'
    elif 'Warning: truncated output' in rendered:
        outcome='truncated'
    elif (tool=='write_stdin' and exit_codes and set(exit_codes)<={1,130}
          and ('\\u0003' in arguments or '\x03' in arguments)):
        outcome='stopped'
    elif exit_codes and any(code!=0 for code in exit_codes):
        outcome='error'
    elif cell_match:
        outcome='running'
    elif tool in {'exec_command','write_stdin'} and session_match and not exit_codes:
        outcome='running'
    elif tool in {'exec_command','write_stdin'} and not exit_codes:
        outcome='unverified'
    else:outcome='success'
    match=re.search(r'\\?"error\\?"\s*:\s*\\?"([a-z0-9_]+)',rendered)
    code=match.group(1) if match else None
    if outcome=='error' and not code and any(value!=0 for value in exit_codes):
        code='command_exit_'+str(next(value for value in exit_codes if value!=0))
    if outcome=='error' and not code and explicit_diagnostic:
        code='command_output_error'
    return outcome,code,hashlib.sha256(rendered.encode()).hexdigest()[:12]


def safe_receipt_provenance(raw):
    """Extract only terminal status facts needed to review a policy event."""
    if isinstance(raw,list):
        rendered='\n'.join(str(item.get('text','')) if isinstance(item,dict) else str(item)
                            for item in raw)
    else:rendered=str(raw)
    codes=[int(value) for value in re.findall(r'\\?"exit_code\\?"\s*:\s*(-?[0-9]+)',rendered)]
    # A wrapper may contain several nested results. Preserve an exit code only
    # when the receipt unambiguously identifies one value.
    exit_code=codes[0] if codes and len(set(codes))==1 else None
    return exit_code,'Warning: truncated output' in rendered


def public_result_objects(result):
    """Decode only public result roots, never IDs nested in advisory metadata."""
    if not isinstance(result,dict):return []
    roots=[result]
    if isinstance(result.get('structuredContent'),dict):
        roots.append(result['structuredContent'])
    for block in result.get('content',[]) if isinstance(result.get('content'),list) else []:
        if not isinstance(block,dict) or block.get('type')!='text':continue
        try:value=json.loads(block.get('text',''))
        except (TypeError,ValueError):continue
        if isinstance(value,dict):roots.append(value)
    return roots


def mcp_receipt_metadata(item):
    """Classify the host's completed MCP receipt independently of wrappers."""
    if not isinstance(item,dict) or item.get('type')!='McpToolCall':return None
    server=item.get('server')
    tool=item.get('tool')
    if not isinstance(server,str) or not server or not isinstance(tool,str) or not tool:return None
    result=item.get('result')
    rendered=json.dumps(result,ensure_ascii=False,sort_keys=True,separators=(',',':')) if result is not None else ''
    outcome,code,digest=observed_outcome(rendered,'mcp__'+server+'__'+tool)
    status=item.get('status')
    if status in {'failed','error','cancelled'} and outcome=='success':outcome='error'
    if status not in {'completed','failed','error','cancelled'} and outcome=='success':outcome='pending'
    if outcome=='error' and not code:
        code='capability_unavailable' if 'Capability is not available:' in rendered else 'mcp_tool_failed'
    metadata={}
    if server=='cortex' and tool=='create_draft' and outcome=='success':
        ids=set(re.findall(r'\\?"draft_id\\?"\s*:\s*\\?"(d_[0-9a-f]{12})\\?"',rendered))
        if len(ids)==1:metadata['draft_id']=ids.pop()
    if server=='cortex' and tool in {'write_report','read_report'} and outcome=='success':
        # `write_report` returns the public report identity in its result, not
        # in the request. Retain only that bounded identity for exact later
        # event correlation; a missing or ambiguous value remains unbound.
        ids={root['report_id'] for root in public_result_objects(result)
             if isinstance(root.get('report_id'),str)
             and re.fullmatch(r'r_[0-9a-f]{12}',root['report_id'])}
        if len(ids)==1:metadata['report_id']=ids.pop()
    if server=='cortex' and tool=='read_report' and outcome=='success':
        structured=result.get('structuredContent') if isinstance(result,dict) else None
        candidates=[result,structured] if isinstance(structured,dict) else [result]
        bindings=[]
        for candidate in candidates:
            artifacts=candidate.get('artifacts') if isinstance(candidate,dict) else None
            if not isinstance(artifacts,list):continue
            parsed=[]
            for artifact in artifacts:
                if (not isinstance(artifact,dict) or set(artifact) != {'reference','version'}
                        or not isinstance(artifact['reference'],str)
                        or not isinstance(artifact['version'],str)
                        or not re.fullmatch(r'(?:sha256:)?[0-9a-f]{64}',artifact['version'])):
                    parsed=[];break
                parsed.append((hashlib.sha256(artifact['reference'].encode()).hexdigest()[:12],
                               artifact['version'].removeprefix('sha256:')))
            if parsed:
                bindings=sorted(set(parsed));break
        if bindings:metadata['reported_artifact_bindings']=bindings
    return dict(tool='mcp__'+server+'__'+tool,tool_namespace='mcp__'+server,host_status=status,
                host_receipt_outcome=outcome,host_error_code=code,
                host_result_digest=digest,**metadata)


def mcp_argument_metadata(tool,arguments):
    """Retain only operation identity fields needed to join a host receipt."""
    if not isinstance(tool,str) or not tool.startswith('mcp__cortex__'):return {}
    try:value=json.loads(arguments)
    except (TypeError,ValueError):return {}
    if not isinstance(value,dict):return {}
    allowed={'template','draft_id','report_id','document_kind','page','limit'}
    metadata={key:value[key] for key in allowed
              if key in value and type(value[key]) in (str,int) and value[key] != ''}
    # Bind a direct public task bootstrap to its exact canonical project without
    # retaining the pathname or caller-selected request key.  This is observer
    # metadata, not a model-provided bootstrap receipt.
    if tool=='mcp__cortex__create_task':
        project=value.get('project_root')
        if isinstance(project,str) and project:
            metadata['bootstrap_project_digest']=hashlib.sha256(project.encode()).hexdigest()
    if tool=='mcp__cortex__write_report':
        # The seven-tool schema remains unchanged.  This fixed title merely
        # labels the coordinator's ordinary immutable report as fallback
        # evidence; report body claims remain model-authored and untrusted.
        metadata['delegation_evidence_report']=(
            value.get('title')=='Delegation evidence: native_worker_result')
    return metadata


def command_execution_outcome(status,exit_code,output=''):
    """Use host status/exit code first; inspect output only when neither is conclusive."""
    output_error=(exit_code is None and bool(COMMAND_ERROR_PATTERN.search(output)))
    outcome=('success' if status=='completed' and exit_code in {0,None} and not output_error
             else 'error' if status=='failed' or output_error or isinstance(exit_code,int) and exit_code!=0
             else 'pending')
    code=None
    if outcome=='error':
        code=('command_output_error' if output_error and exit_code in {0,None}
              else 'command_exit_'+str(exit_code) if isinstance(exit_code,int)
              else 'command_failed')
    return outcome,code


def raw_command_family(source):
    """Return a coarse executable family used only to link an explicit correction."""
    first=source.strip().splitlines()[0] if source.strip() else ''
    try:tokens=shlex.split(first)
    except ValueError:tokens=first.split()
    if not tokens:return None
    if tokens[0]=='npm' and len(tokens)>=3 and tokens[1]=='run':return 'npm run '+tokens[2]
    if tokens[0] in {'python','python3'}:return 'python'
    return tokens[0]


def failed_command_family(output):
    """Identify the executable named by the shell's terminal command-not-found receipt."""
    matches=re.findall(r'(?m)^(?:/bin/)?(?:ba|z|k)?sh: line [0-9]+: ([A-Za-z0-9_.+-]+): command not found$',output)
    if not matches:return None
    return 'python' if matches[-1] in {'python','python3'} else matches[-1]


def verified_compound_failure_family(source,output,cwd):
    """Attribute `pwd && COMMAND` only when the pwd receipt proves it ran first."""
    parts=shell_command_parts(json.dumps({'cmd':source}))
    if not parts or parts.count('&&')!=1:return None
    split=parts.index('&&');first,second=parts[:split],parts[split+1:]
    if first!=['pwd'] or not second:return None
    expected=str(cwd or '')
    if expected.startswith('file://'):expected=expected[7:]
    if output.strip()!=expected:return None
    return raw_command_family(shlex.join(second))


def semantic_no_match_family(source,exit_code,stdout,stderr,cwd):
    """Recognize only rg/grep's documented exit-1 no-match result.

    The raw host outcome and exit code remain on the observation.  This helper
    merely supplies a content-free semantic classification for a simple search,
    or for the exact `pwd && SEARCH` shape whose stdout proves pwd completed.
    """
    if exit_code!=1 or str(stderr or '').strip():return None
    parts=shell_command_parts(json.dumps({'cmd':source}))
    if not parts:return None
    search=parts;expected_output=''
    if parts.count('&&')==1 and parts[:2]==['pwd','&&']:
        search=parts[2:]
        expected=str(cwd or '')
        if expected.startswith('file://'):expected=expected[7:]
        expected_output=expected
    elif any(part in {'&&','||',';','|','&'} for part in parts):
        return None
    if not search or search[0].rsplit('/',1)[-1] not in {'rg','grep'}:return None
    if str(stdout or '').strip()!=expected_output:return None
    return search[0].rsplit('/',1)[-1]


def semantic_absent_path(source,exit_code,stdout,stderr):
    """A literal unary file predicate returning false is an observation, not a crash.

    Preserve the raw exit and path policy. This grants no artifact/completion proof;
    missing required output still fails independent outcome reconciliation.
    """
    if exit_code!=1 or str(stdout or '').strip() or str(stderr or '').strip():return False
    return bool(re.fullmatch(r'test[ \t]+-(?:e|f|d)[ \t]+[A-Za-z0-9_./-]+',source))


def nested_tool_invocations(source):
    """Extract statically visible tool calls and their argument digests.

    This intentionally covers direct member calls, quoted bracket members and
    simple const/let/var aliases. It does not claim to evaluate arbitrary
    JavaScript or dynamic property construction.
    """
    matches=[]
    direct_member=r'tools(?:\.([A-Za-z0-9_]+)|\[\s*(["\'])([A-Za-z0-9_]+)\2\s*\])'
    alias_member=r'tools(?:\.([A-Za-z0-9_]+)|\[\s*(["\'])([A-Za-z0-9_]+)\3\s*\])'
    direct=re.compile(r'\b'+direct_member+r'\s*\(')
    aliases={}
    alias_pattern=re.compile(r'\b(?:const|let|var)\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*'+alias_member+r'\s*;?')
    for found in alias_pattern.finditer(source):
        name=found.group(2) or found.group(4)
        if name:aliases[found.group(1)]=name
    calls=[]
    for found in direct.finditer(source):
        calls.append((found.start(),found.end(),found.group(1) or found.group(3)))
    if aliases:
        alias_calls=re.compile(r'\b('+'|'.join(re.escape(name) for name in aliases)+r')\s*\(')
        calls.extend((found.start(),found.end(),aliases[found.group(1)])
                     for found in alias_calls.finditer(source))
    for _,end,name in sorted(calls):
        index=end;depth=1;quote=None;escaped=False
        while index<len(source) and depth:
            char=source[index]
            if quote:
                if escaped:escaped=False
                elif char=='\\':escaped=True
                elif char==quote:quote=None
            elif char in {'"',"'",'`'}:quote=char
            elif char=='(':depth+=1
            elif char==')':depth-=1
            index+=1
        arguments=source[end:index-1] if depth==0 else source[end:]
        matches.append((name,hashlib.sha256(arguments.encode()).hexdigest()[:12],arguments))
    return matches


def direct_public_cortex_create_task(source, nested):
    """Identify one semantically direct public Cortex task call in a host wrapper.

    Current Codex can serialize a direct MCP member call through its observable
    functions.exec transport.  The transport shell is not qualification work
    when it contains exactly that one literal public call.  Any alias, second
    nested tool, or dynamic source remains a wrapped/ambiguous action.
    """
    if not isinstance(source,str) or len(nested)!=1 or nested[0][0]!='mcp__cortex__create_task':
        return False
    return re.search(
        r'\btools(?:\.mcp__cortex__create_task|\[\s*["\']mcp__cortex__create_task["\']\s*\])\s*\(',
        source) is not None


def approved_tool_catalogue_envelope(source, nested):
    """Recognize the one value-free current-host tool catalogue observation.

    ``functions.exec`` may expose the public tool catalogue before the first
    direct MCP call.  That observation is not a general JavaScript or wrapper
    privilege: only the bounded catalogue or a literal word filter over its
    public names/descriptions qualifies. Keep this grammar
    deliberately small so paths, dynamic queries, content extraction, mutations and
    mixed wrappers remain ordinary pre-binding host actions.
    """
    if not isinstance(source,str) or nested:
        return False
    compact=re.sub(r'\s+',' ',source).strip()
    binding=re.fullmatch(r'const ([A-Za-z_][A-Za-z0-9_]*) = (ALL_TOOLS\.filter\(.*\)); text\(\1\);?',compact)
    if binding:
        compact='text('+binding.group(2)+')'
    if compact in {'text(ALL_TOOLS)','text(ALL_TOOLS);'}:return True
    if re.fullmatch(
        r'''text\(\s*ALL_TOOLS\.filter\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*=>\s*'''
        r'''\1\.name\.startsWith\((["'])mcp__cortex__\2\)\s*\)\s*\)\s*;?''',compact):
        return True
    # Current host discovery commonly filters the advertised names/descriptions.
    # Accept only literal word alternatives over those two fields: no arbitrary
    # callbacks, regex operators, computed properties, calls or extra statements.
    return len(source)<=2048 and re.fullmatch(
        r'''text\(\s*ALL_TOOLS\.filter\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*=>\s*'''
        r'''/[A-Za-z_][A-Za-z0-9_]*(?:\|[A-Za-z_][A-Za-z0-9_]*)*/i?\.test\(\s*'''
        r'''\1\.name\s*\+\s*(["']) \2\s*\+\s*\1\.description\s*\)\s*\)\s*\)\s*;?''',
        compact) is not None


def observed_cell_ids(raw):
    if isinstance(raw,list):
        rendered='\n'.join(str(item.get('text','')) if isinstance(item,dict) else str(item) for item in raw)
    else:rendered=str(raw)
    return sorted(set(re.findall(r'Script running with cell ID\s+([A-Za-z0-9_-]+)',rendered)))


def requested_identifiers(arguments,key,numeric=False):
    values=re.findall(r'(?:["\']'+re.escape(key)+r'["\']|\b'+re.escape(key)+r')\s*:\s*["\']?([A-Za-z0-9_-]+)',arguments)
    return sorted(set(int(value) for value in values)) if numeric else sorted(set(values))


def original_request_digest(text):
    text=text.strip()
    token='$cortex:orchestrator'
    if text.startswith(token) and (len(text)==len(token) or text[len(token)].isspace()):
        text=text[len(token):].strip()
    return hashlib.sha256(text.encode('utf-8')).hexdigest()


def desktop_editor_source(text):
    # Desktop serializes its rich-text list and literal underscores as Markdown.
    # Retain all other whitespace and characters; this is not general normalization.
    return re.sub(r'(?m)([^\n])\n\n(?=1\. )',r'\1\n',text.replace('\\_','_'))


def native_archived_request_digest(text):
    """Hash the exact native archive body after the host's route separator."""
    token='$cortex:orchestrator'
    if not isinstance(text,str) or not text.startswith(token):return None
    if len(text)>len(token) and not text[len(token)].isspace():return None
    archive=text[len(token):]
    if archive.startswith('\r\n'):archive=archive[2:]
    elif archive and archive[0].isspace():archive=archive[1:]
    return hashlib.sha256(archive.encode('utf-8')).hexdigest()


def delivered_request_digests(state,text):
    accepted={state.get('original_request_sha256')}
    expected=state.get('desktop_editor_source_sha256')
    if expected and original_request_digest(desktop_editor_source(text))==expected:
        accepted.update((original_request_digest(text),
                         original_request_digest(text.replace('\\_','_'))))
        raw=native_archived_request_digest(text)
        if raw:accepted.add(raw)
    return accepted


POLICY_CLASS_VALUES={
    'research','exploration','analysis','ordinary','complex',
    'decision','decision-hard',
    'security-analysis-microtask','security-implementation','review',
    'consultation','consultation-narrow','consultation-hard',
}
NATIVE_WORKER_RESULT_SCHEMA='cortex-native-worker-result-v1'
NATIVE_WORKER_RESULT_FIELDS=frozenset({
    'schema','worker_thread_id','parent_thread_id','task_id','profile','status',
    'worker_mcp','assignment_digest','artifacts','checks','limits','result_digest',
})
NATIVE_WORKER_RESULT_STATUSES=frozenset({'success','failed','blocked'})


def canonical_native_worker_result(value):
    """Hash the closed native-result evidence body, never its prose wrapper."""
    body={key:value[key] for key in NATIVE_WORKER_RESULT_FIELDS-{'result_digest'}}
    return hashlib.sha256(json.dumps(body,sort_keys=True,separators=(',',':')).encode()).hexdigest()


def parse_native_worker_result(rendered):
    """Validate the current-host fallback's closed, model-supplied result body.

    This is intentionally evidence parsing, not worker authentication.  It accepts
    one labelled JSON block only and retains no free-form final-answer content.
    """
    if not isinstance(rendered,str):return None,'native_worker_result_missing'
    matches=re.findall(r'(?s)\ACortex native worker result:\s*\n```json\s*\n(.*?)\n```\s*\Z',rendered)
    if len(matches)!=1:return None,'native_worker_result_missing'
    try:value=json.loads(matches[0])
    except (TypeError,ValueError):return None,'native_worker_result_malformed'
    if not isinstance(value,dict) or set(value)!=NATIVE_WORKER_RESULT_FIELDS:
        return None,'native_worker_result_schema_invalid'
    required_text=('worker_thread_id','parent_thread_id','task_id','profile','assignment_digest','result_digest')
    if any(not isinstance(value.get(key),str) or not value[key] for key in required_text):
        return None,'native_worker_result_schema_invalid'
    if (value.get('schema')!=NATIVE_WORKER_RESULT_SCHEMA
            or value.get('status') not in NATIVE_WORKER_RESULT_STATUSES
            or value.get('worker_mcp') not in {'available','unavailable'}
            or assigned_worker_profile('$cortex:worker-'+value['profile'].replace('_','-'))!=value['profile']
            or not re.fullmatch(r'[0-9a-f]{64}',value['assignment_digest'])
            or not re.fullmatch(r'[0-9a-f]{64}',value['result_digest'])):
        return None,'native_worker_result_schema_invalid'
    artifacts=value.get('artifacts');checks=value.get('checks');limits=value.get('limits')
    if (not isinstance(artifacts,list) or not isinstance(checks,list) or not isinstance(limits,list)
            or not all(isinstance(item,dict) and set(item)=={'reference','sha256'}
                       and isinstance(item['reference'],str) and 0<len(item['reference'])<=256
                       and not item['reference'].startswith('/') and '..' not in Path(item['reference']).parts
                       and isinstance(item['sha256'],str) and re.fullmatch(r'[0-9a-f]{64}',item['sha256'])
                       for item in artifacts)
            or not all(isinstance(item,dict) and set(item)=={'command','exit_code','receipt_digest'}
                       and isinstance(item['command'],str) and re.fullmatch(r'[A-Za-z0-9_.:/ -]{1,160}',item['command'])
                       and isinstance(item['exit_code'],int) and not isinstance(item['exit_code'],bool)
                       and -255<=item['exit_code']<=255
                       and isinstance(item['receipt_digest'],str) and re.fullmatch(r'[0-9a-f]{64}',item['receipt_digest'])
                       for item in checks)
            or not all(isinstance(item,str) and 0<len(item)<=320 for item in limits)
            or value['result_digest']!=canonical_native_worker_result(value)):
        return None,'native_worker_result_schema_invalid'
    return value,None


def assignment_policy_metadata(text):
    """Derive bounded routing evidence from the supported assignment message.

    Native ``spawn_agent`` has no policy-class or review-provenance arguments.
    The coordinator therefore records a small labeled block in ``message``;
    this parser retains only those allowlisted values and never asks callers to
    send undocumented tool fields.
    """
    if not isinstance(text,str):return {}
    source=text[:20_000]
    result={}
    policy=re.search(
        r'(?im)^\s*policy\s+class\s*[:=]\s*([a-z][a-z0-9-]{0,63})\s*$',source)
    if policy:
        value=policy.group(1).lower()
        if value in POLICY_CLASS_VALUES:
            result['policy_class']=value
    for key,label in (
        ('implementation_model','review implementation model'),
        ('implementation_effort','review implementation effort'),
    ):
        match=re.search(
            r'(?im)^\s*'+re.escape(label)+r'\s*[:=]\s*([a-z0-9._-]{1,80})\s*$',source)
        if match:
            result[key]=match.group(1).lower()
    override=re.search(
        r'(?im)^\s*(?:explicit\s+)?user[- ]requested\s+override\s*[:=]\s*'
        r'(yes|no|true|false)\s*$',source)
    if override:
        result['explicit_user_override']=override.group(1).lower() in {'yes','true'}
    if result:
        result['policy_evidence']='assignment_message'
    return result


def assigned_worker_profile(text):
    matches=re.findall(r'\$cortex:worker-([a-z-]+)',text)
    profiles={p['name'] for p in json.loads((ROOT/'plugins/cortex/profiles.json').read_text())['profiles']}
    found={name.replace('-','_') for name in matches} & profiles
    return next(iter(found)) if len(found)==1 else None


def shell_command_text(arguments):
    """Extract one literal exec_command cmd without executing or expanding it."""
    match=re.search(r'(?:["\']cmd["\']|\bcmd)\s*:\s*("(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\')',arguments)
    if not match:return None
    try:
        command=ast.literal_eval(match.group(1))
    except (ValueError,SyntaxError):return None
    return command if isinstance(command,str) else None


def shell_command_parts(arguments):
    """Parse one literal exec_command cmd without executing or expanding it.

    Preserve literal newlines outside quotes as segment boundaries. A newline in
    a quoted string or escaped newline is ambiguous for path classification and
    therefore fails closed instead of being silently folded into whitespace.
    """
    command=shell_command_text(arguments)
    if command is None:return None
    chunks=[];start=0;quote=None;escaped=False
    for index,char in enumerate(command):
        if escaped:
            if char in '\r\n':return None
            escaped=False
            continue
        if char=='\\\\':
            escaped=True
            continue
        if quote is None:
            if char=="'":quote='single'
            elif char=='"':quote='double'
            elif char in '\r\n':
                if char=='\r' and index+1<len(command) and command[index+1]=='\n':
                    continue
                chunks.append(command[start:index]);start=index+1
        elif quote=='single':
            if char in '\r\n':return None
            if char=="'":quote=None
        else:
            if char in '\r\n':return None
            if char=='"':quote=None
    if escaped or quote is not None:return None
    chunks.append(command[start:])
    parts=[]
    try:
        for index,chunk in enumerate(chunks):
            lexer=shlex.shlex(chunk,posix=True,punctuation_chars=True)
            lexer.whitespace_split=True
            parts.extend(list(lexer))
            if index<len(chunks)-1:parts.append('\\n')
    except (ValueError,SyntaxError):return None
    return parts or None


def bounded_static_read_wrapper(command):
    """Return the one literal payload of the supported shell read wrapper.

    The interactive host may put its otherwise literal instruction read behind
    ``bash -lc``.  Treat that as transport only when it has exactly one quoted
    payload; callers must still validate the payload with the closed static
    read grammar below.  This deliberately admits neither nested shells nor
    arbitrary shell options, environment prefixes, redirections, or commands.
    """
    if not isinstance(command,str):
        return None
    try:
        parts=shlex.split(command,posix=True)
    except (ValueError,SyntaxError):
        return None
    if (len(parts)==3 and parts[0] in {'bash','/bin/bash'} and parts[1]=='-lc'
            and isinstance(parts[2],str) and parts[2]):
        return parts[2]
    return None


def bounded_static_read_transport(source, nested):
    """Recognize the sole installed-host functions.exec static-read envelope.

    The current host forwards one nested ``tools.exec_command`` result through
    ``text(<same-identifier>)``.  Keep this a syntax-only, value-free
    exception: exactly one direct call, one ``const`` binding to a safe
    JavaScript identifier, and one complete forwarding statement using that
    same identifier are required.  The nested command still goes through
    ``skill_instruction_read`` and its manifest checks; this helper only
    prevents an unrelated wrapper from borrowing that nested row's
    classification.
    """
    if not isinstance(source, str) or not isinstance(nested, list) or len(nested) != 1:
        return False
    if not isinstance(nested[0], tuple) or len(nested[0]) != 3 or nested[0][0] != 'exec_command':
        return False
    match = re.fullmatch(
        r'\s*const\s+(?P<binding>[A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*'
        r'await\s+tools\.exec_command\((?P<arguments>.*)\)\s*;\s*'
        r'(?:text\((?P=binding)\)\s*;|text\(JSON\.stringify\((?P=binding)\)\)\s*;|'
        r'text\((?P=binding)\.output\)\s*;\s*'
        r'text\(`exit_code=\$\{(?P=binding)\.exit_code\}`\)\s*;'
        r'(?:\s*if\s*\((?P=binding)\.session_id\)\s*'
        r'text\(`session_id=\$\{(?P=binding)\.session_id\}`\)\s*;)?)\s*',
        source, re.DOTALL,
    )
    if match is None or match.group('arguments') != nested[0][2]:
        return False
    # Reject JavaScript keywords/literals even though they lexically resemble
    # identifiers; accepting one would make the transport grammar ambiguous.
    return match.group('binding') not in {
        # ECMAScript keywords/literals, strict-mode future-reserved words, and
        # the two names forbidden as bindings by the strict-mode grammar.
        'arguments', 'await', 'break', 'case', 'catch', 'class', 'const',
        'continue', 'debugger', 'default', 'delete', 'do', 'else', 'enum',
        'eval', 'export', 'extends', 'false', 'finally', 'for', 'function',
        'if', 'implements', 'import', 'in', 'instanceof', 'interface', 'let',
        'new', 'null', 'package', 'private', 'protected', 'public', 'return',
        'static', 'super', 'switch', 'this', 'throw', 'true', 'try', 'typeof',
        'var', 'void', 'while', 'with', 'yield',
    }


def python_skill_read_paths(command):
    """Return literal skill paths from a tiny static pathlib read program.

    ``None`` means the command is not a Python candidate; an empty list means it
    looked like one but failed the read-only AST grammar.
    """
    if not isinstance(command,str) or not command.startswith('python3'):
        return None
    inline=re.fullmatch(
        r"python3(?:[ \t]+-B)?[ \t]+-c[ \t]+'(?P<program>[^'\r\n]*)'[ \t]*",
        command,
    )
    inline_literal=inline is not None
    if inline_literal:
        program=inline.group('program')
    else:
        lines=command.splitlines()
        if len(lines)<3:return []
        first=re.fullmatch(r"python3(?:[ \t]+-B)?[ \t]+-[ \t]+<<(?P<quote>['\"])(?P<tag>[A-Za-z_][A-Za-z0-9_]*)(?P=quote)",lines[0])
        if not first:return []
        tag=first.group('tag')
        if lines[-1]=='':
            lines=lines[:-1]
        if not lines or lines[-1]!=tag:return []
        program='\n'.join(lines[1:-1])
    try:tree=ast.parse(program,mode='exec')
    except (SyntaxError,ValueError):return []

    imported=False;binding=None;literal_path=None;printed=False
    for statement in tree.body:
        if isinstance(statement,ast.ImportFrom):
            if (imported or statement.level or statement.module!='pathlib'
                    or len(statement.names)!=1 or statement.names[0].name!='Path'
                    or statement.names[0].asname is not None):
                return []
            imported=True
            continue
        if isinstance(statement,ast.Assign):
            if (not imported or binding is not None or len(statement.targets)!=1
                    or not isinstance(statement.targets[0],ast.Name)
                    or statement.targets[0].id in {'Path','print'}):
                return []
            value=statement.value
            if (not isinstance(value,ast.Call) or not isinstance(value.func,ast.Name)
                    or value.func.id!='Path' or len(value.args)!=1 or value.keywords):
                return []
            argument=value.args[0]
            if not isinstance(argument,ast.Constant) or not isinstance(argument.value,str):
                return []
            binding=statement.targets[0].id
            literal_path=Path(argument.value)
            continue
        if isinstance(statement,ast.Expr) and isinstance(statement.value,ast.Call):
            call=statement.value
            if (printed or not isinstance(call.func,ast.Name) or call.func.id!='print'
                    or len(call.args)!=1 or call.keywords):
                return []
            read=call.args[0]
            if (not imported or not isinstance(read,ast.Call)
                    or not isinstance(read.func,ast.Attribute) or read.func.attr!='read_text'
                    or read.args or read.keywords):
                return []
            receiver=read.func.value
            if inline_literal and binding is None:
                if (not isinstance(receiver,ast.Call) or not isinstance(receiver.func,ast.Name)
                        or receiver.func.id!='Path' or len(receiver.args)!=1 or receiver.keywords
                        or not isinstance(receiver.args[0],ast.Constant)
                        or not isinstance(receiver.args[0].value,str)):
                    return []
                literal_path=Path(receiver.args[0].value)
            elif not isinstance(receiver,ast.Name) or receiver.id!=binding:
                return []
            printed=True
            continue
        # No docstrings, arbitrary expressions, imports, calls or mutations.
        return []
    if (not imported or literal_path is None or not printed
            or not inline_literal and binding is None):
        return []
    return [literal_path]


def command_neutral_skill_read_paths(command):
    """Extract one leaf from a positively modelled, read-only command.

    Command spelling is not a prompt or skill contract: the model may choose
    any supported ordinary reader.  The observer nevertheless needs a positive
    semantic basis before it grants the declaration-bound exception.  Unknown
    executables, interpreters, editors, and options therefore fail closed rather
    than being admitted by a finite blacklist.  The actual terminal outcome and
    all manifest/source-byte checks remain authoritative.
    """
    if not isinstance(command,str) or not command.strip():
        return None
    if _shell_command_has_ambiguous_syntax(command):
        return []
    parts=shell_command_parts(json.dumps({'cmd':command}))
    if not parts or any(token in {'&&','||',';','|','&','\\n'} for token in parts):
        return []
    if len(parts)<2:
        return []

    executable=parts[0]
    trusted_paths=TRUSTED_COMMAND_NEUTRAL_READER_PATHS.get(executable)
    if trusted_paths is None or '/' in executable:
        return []
    resolved=shutil.which(executable)
    if not resolved:
        return []
    try:
        resolved_path=Path(resolved).resolve(strict=True)
    except OSError:
        return []
    # Bind the positive grammar to the canonical system binary, not merely its
    # basename.  This rejects both explicit path-qualified lookalikes and PATH
    # shadowing by an unknown or mutating executable.
    if resolved_path not in {path.resolve() for path in trusted_paths}:
        return []

    def literal_marker_paths(tokens):
        """Return exactly one absolute marker operand, preserving spaces."""
        marker_tokens=[]
        for index,token in enumerate(tokens,1):
            classes=_path_policy_marker_classes(token)
            if classes:
                # shell_command_parts has already removed only literal shell
                # quoting.  Requiring an absolute token and rejecting shell
                # metacharacters keeps spaces in quoted paths valid while
                # refusing marker-bearing patterns and option values.
                if (not token.startswith('/')
                        or any(char in token for char in '*?[]{}$`|;&<>\\')):
                    return None
                marker_tokens.append((index,Path(token)))
            elif token.startswith('/'):
                # A second absolute operand could be another file read. Keep
                # this exception bound to exactly one declared leaf.
                return None
            elif token.startswith('-') and '=' in token and '/' in token:
                # An option embedding a filesystem operand is not an opaque
                # reader flag.
                return None
        return marker_tokens if len(marker_tokens)==1 else None

    args=parts[1:]
    path=None

    # These direct readers have a closed argument grammar.  In particular,
    # follow-mode, output options, and arbitrary reader flags are not inferred
    # to be safe merely because the executable name looks familiar.
    if executable in {'head','tail'}:
        if len(args)==1:
            marker=literal_marker_paths(args)
            path=marker[0][1] if marker else None
        elif len(args)==2 and re.fullmatch(r'-[0-9]+',args[0]):
            marker=literal_marker_paths(args[1:])
            path=marker[0][1] if marker else None
        elif (len(args)==2 and re.fullmatch(r'--(?:lines|bytes)=-?[0-9]+',args[0])):
            marker=literal_marker_paths(args[1:])
            path=marker[0][1] if marker else None
        elif len(args)==3 and args[0] in {'-n','--lines','-c','--bytes'} \
                and re.fullmatch(r'-?[0-9]+',args[1]):
            marker=literal_marker_paths(args[2:])
            path=marker[0][1] if marker else None
        else:
            return []
    elif executable=='nl':
        if len(args)==1:
            marker=literal_marker_paths(args)
        elif len(args)==2 and args[0] in {'-ba','-b','--body-numbering'}:
            if args[0] in {'-b','--body-numbering'} and args[1] in {'a','t','n','p'}:
                return []
            marker=literal_marker_paths(args[1:])
        else:
            return []
        path=marker[0][1] if marker else None
    elif executable in {'rg','grep'}:
        # Search tools are admitted only with a positive read-only flag model.
        # Preprocessors, file-fed patterns, and unknown options are excluded.
        flags={
            '-a','-c','-F','-H','-h','-i','-L','-l','-n','-o','-r','-S','-T',
            '-v','-w','-x','--binary-files','--count','--fixed-strings',
            '--hidden','--ignore-case','--invert-match','--line-number',
            '--line-regexp','--max-count','--no-filename','--only-matching',
            '--text','--word-regexp','--with-filename',
        }
        valued={'-e','--regexp','-g','--glob','--iglob','--max-count','--type','-t'}
        i=0
        while i<len(args):
            token=args[i]
            if token=='--':
                i+=1
                break
            if token.startswith('-') and token!='-':
                option=token.split('=',1)[0]
                if option in valued:
                    if '=' not in token:
                        if i+1>=len(args):return []
                        i+=1
                    i+=1
                    continue
                if token in flags or option in flags:
                    i+=1
                    continue
                return []
            break
        if i>=len(args):
            return []
        # The existing classifier distinguishes a search pattern from actual
        # file operands.  The positive flag model above prevents rg --pre and
        # similar execution hooks from borrowing this read-only exception.
        indexes=_rg_grep_marker_operand_indexes(parts)
        if indexes is None:
            return []
        marker=literal_marker_paths(args)
        if marker is None or marker[0][0] not in {index for index in indexes}:
            return []
        path=marker[0][1]
    else:
        # No blacklist fallback: an executable without a complete positive
        # ordinary-read model is not evidence of a non-mutating operation.
        return []

    return [path] if path is not None else []


def advertised_skill_paths(read_paths,worker_only=False,coordinator_only=False,
                           require_existing=True):
    """Validate exact advertised skill or public tool-definition reads.

    Coordinator bootstrap may read only a released SKILL/reference document or
    the two fixed plugin declarations needed to discover the public Cortex
    tool surface.  This validates literal leaves below the installed isolated
    cache; it deliberately does not admit directories, globs, registries,
    database/state files, runtime code, or arbitrary cache content.
    """
    expected_roots=(
        Path.home()/'.cortex-dev/.codex/plugins/cache/cortex/cortex',
        Path.home()/'.codex/plugins/cache/cortex/cortex',
    )

    def active_cache_manifest(root, version):
        """Require the cache leaf to belong to the active released payload."""
        manifest=root/version/'.codex-plugin/plugin.json'
        trusted=ROOT/'plugins/cortex/.codex-plugin/plugin.json'
        if (not manifest.is_file() or manifest.is_symlink()
                or not trusted.is_file() or trusted.is_symlink()):
            return False
        try:
            value=json.loads(manifest.read_text(encoding='utf-8'))
        except (OSError,ValueError):
            return False
        return (isinstance(value,dict) and value.get('name')=='cortex'
                and value.get('version')==version
                and manifest.read_bytes()==trusted.read_bytes())

    advertised=False
    for path in read_paths:
        expected=None
        relative=None
        for candidate in expected_roots:
            try:
                relative=path.relative_to(candidate)
            except ValueError:
                continue
            expected=candidate
            break
        if expected is None:return False
        if '..' in relative.parts or len(relative.parts)<2:return False
        version=relative.parts[0]
        if not active_cache_manifest(expected,version):return False
        released=Path(*relative.parts[1:])
        declaration=released in {Path('.mcp.json'),Path('.codex-plugin/plugin.json')}
        if declaration:
            if worker_only or not coordinator_only:return False
            source=ROOT/Path('plugins/cortex')/released
        else:
            if len(relative.parts)<4 or relative.parts[1]!='skills':return False
            skill_name=relative.parts[2];resource=Path(*relative.parts[3:])
            if worker_only and not skill_name.startswith('worker-'):return False
            if coordinator_only:
                if skill_name not in {'orchestrator','tool-discipline','content-safety',
                                      'coordinator-communication','context-compaction'}:return False
            if resource!=Path('SKILL.md'):
                entry=ROOT/'plugins/cortex/skills'/skill_name/'SKILL.md'
                if (len(resource.parts)!=2 or resource.parts[0]!='references'
                        or not re.fullmatch(r'[A-Za-z0-9_-]+\.md',resource.name)
                        or resource.as_posix() not in re.findall(
                            r'\]\((references/[A-Za-z0-9_-]+\.md)\)',entry.read_text())):
                    return False
            source=ROOT/'plugins/cortex/skills'/skill_name/resource
        if not source.is_file() or path.is_symlink():return False
        if require_existing and not path.is_file():return False
        if path.exists() and not path.is_file():return False
        if path.is_file() and path.read_bytes()!=source.read_bytes():return False
        try:path.resolve().relative_to(expected.resolve())
        except ValueError:return False
        advertised=True
    return advertised


def declared_skill_paths(read_paths,worker_only=False,coordinator_only=False):
    """Validate declaration identity without requiring a successful read."""
    return advertised_skill_paths(
        read_paths,worker_only,coordinator_only,require_existing=False)


def skill_instruction_read(tool,arguments,worker_only=False,coordinator_only=False,
                           _allow_bounded_wrapper=True, _require_existing=True):
    # Recognize a targeted standard skill read, never installation exploration.
    if tool=='read_file':
        try:value=json.loads(arguments) if isinstance(arguments,str) else arguments
        except (TypeError,ValueError):return False
        if (not isinstance(value,dict) or set(value)!={'path'}
                or not isinstance(value.get('path'),str)):return False
        return advertised_skill_paths([Path(value['path'])],worker_only,coordinator_only,
                                      require_existing=_require_existing)
    if tool!='exec_command':return False
    command=shell_command_text(arguments)
    if command is None:return False
    # Current Codex sometimes transports a literal read through one ``bash
    # -lc`` envelope.  Reparse only that exact payload; the recursive call
    # disables another envelope so nested shells cannot widen this exception.
    wrapped=bounded_static_read_wrapper(command) if _allow_bounded_wrapper else None
    if wrapped is not None:
        return skill_instruction_read(
            tool,json.dumps({'cmd':wrapped}),worker_only,coordinator_only,
            _allow_bounded_wrapper=False,_require_existing=_require_existing)
    python_paths=python_skill_read_paths(command)
    if python_paths is not None:
        return advertised_skill_paths(python_paths,worker_only,coordinator_only,
                                      require_existing=_require_existing)
    parts=shell_command_parts(arguments)
    if not parts:return False

    # A status suffix is allowed only when it preserves the command's exit code.
    # Keep it separate from the read-sequence grammar so `$?` does not make an
    # otherwise static command look like it contains dynamic input.
    if ';' in parts:
        index=parts.index(';');tail=parts[index:]
        if len(tail)<5 or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*=\$\?',tail[1]):return False
        var=tail[1].split('=',1)[0]
        if tail[:1]!=[';'] or tail[2]!=';':return False
        rest=tail[3:]
        if rest[-3:]==[';','exit','$'+var]:rest=rest[:-3]
        echo=rest==['echo','__EXIT_STATUS__=$'+var]
        printf=(len(rest)==3 and rest[0]=='printf' and rest[2]=='$'+var
                and re.fullmatch(r'(?:\\n)?[A-Z_]+=%s\\n',rest[1]) is not None)
        if not (echo or printf):return False
        parts=parts[:index]

    # Only a linear `&&` sequence is accepted. Pipes, redirections, command
    # substitutions, background jobs and any other shell syntax are rejected.
    eof_sed=(command.count('$')==1
             and re.search(r"(?:^|\s)sed\s+-n\s+'1,\$p'\s+",command) is not None)
    if any(token not in {'&&','1,$p'} and any(char in token for char in '$`><|&();') for token in parts):
        return False
    if any('$' in token for token in parts) and not eof_sed:return False
    if any(token in {'|','||','>','>>','<','<<','&','&;'} for token in parts):return False
    segments=[];current=[]
    for token in parts:
        if token=='&&':
            if not current:return False
            segments.append(current);current=[]
        elif token=='\\n':
            if not current:return False
            segments.append(current);current=[]
        else:current.append(token)
    if not current:return False
    segments.append(current)

    read_paths=[]
    for segment in segments:
        command_name=segment[0]
        if command_name=='pwd' and len(segment)==1:continue
        if command_name in {'printf','echo'}:
            # These are permitted only as static labels or status-independent
            # diagnostics. Their output never establishes command success.
            if len(segment)<2 or any(any(char in token for char in '$`><|&();') for token in segment[1:]):
                return False
            continue
        if len(segment)==2 and command_name=='cat':path=Path(segment[1])
        elif len(segment)==3 and segment[:2]==['wc','-l']:path=Path(segment[2])
        elif (len(segment)==4 and segment[:2]==['sed','-n']
              and (re.fullmatch(r'\d+,\d+p',segment[2]) or segment[2]=='1,$p')):path=Path(segment[3])
        else:
            # Command-neutral fallback: recognize exactly one literal declared
            # leaf without making the reader executable or quoting style part
            # of the trust decision. Existing compound/bounded forms are
            # handled above unchanged.
            neutral_paths=command_neutral_skill_read_paths(command)
            if neutral_paths:
                return advertised_skill_paths(
                    neutral_paths,worker_only,coordinator_only,
                    require_existing=_require_existing)
            return False
        read_paths.append(path)
    return advertised_skill_paths(read_paths,worker_only,coordinator_only,
                                 require_existing=_require_existing)


def declared_skill_instruction_read(tool,arguments,worker_only=False,coordinator_only=False,
                                    _allow_bounded_wrapper=True):
    """Recognize a bounded declared leaf even when its read fails."""
    return skill_instruction_read(
        tool,arguments,worker_only,coordinator_only,
        _allow_bounded_wrapper=_allow_bounded_wrapper,
        _require_existing=False)


def active_coordinator_skill_read(tool,arguments):
    """Prove the one active isolated candidate orchestrator skill read.

    The current host performs this read before task creation.  It is not a
    generic cache exception: the literal leaf must equal the owner-private
    candidate's installed version and pass the existing bounded reader grammar.
    """
    if not skill_instruction_read(tool,arguments,coordinator_only=True):return False
    command=shell_command_text(arguments)
    if not isinstance(command,str):return False
    matches=re.findall(r'(/[A-Za-z0-9_./+@=-]+/skills/(?:orchestrator|tool-discipline|content-safety|coordinator-communication|context-compaction)/(?:SKILL\.md|references/[A-Za-z0-9_-]+\.md))(?![A-Za-z0-9_.-])',command)
    if not 1<=len(matches)<=4 or len(set(matches))!=len(matches):return False
    metadata=Path.home()/'.cortex-dev/.codex/cortex-candidate.json'
    try:
        info=metadata.lstat()
        if (metadata.is_symlink() or not metadata.is_file() or info.st_uid!=os.getuid()
                or info.st_mode&0o077):return False
        value=json.loads(metadata.read_text(encoding='utf-8'))
    except (OSError,ValueError):return False
    version=value.get('version') if isinstance(value,dict) else None
    if not isinstance(version,str) or not version:return False
    base=Path.home()/'.cortex-dev/.codex/plugins/cache/cortex/cortex'/version/'skills'
    return all(Path(path).is_relative_to(base) and Path(path).is_file()
               and not Path(path).is_symlink()
               and Path(path).read_bytes()==(ROOT/'plugins/cortex/skills'/Path(path).relative_to(base)).read_bytes()
               for path in matches)


PRIVATE_CORTEX_MARKER=re.compile(
    r'(?<![A-Za-z0-9_.-])\.codex/cortex(?:/|(?=$|[\s"\'`]))'
)


def private_cortex_cache_mentioned(value):
    """Recognize a Cortex task-cache path without retaining the path itself."""
    return bool(PRIVATE_CORTEX_MARKER.search(str(value).replace('\\\\','/')))


PATH_POLICY_MARKERS={
    'plugin_or_cache':('/.codex/plugins/','/plugins/cache/','/.agents/plugins/',
                       '/.cortex-dev/candidates/','/.codex/agents/','CODEX_HOME/plugins/'),
    'cortex_internal':('.codex/cortex/',),
}


def _path_policy_marker_classes(value):
    """Return marker classes without retaining the matched value."""
    normalized=str(value).replace('\\\\','/')
    matched={name for name,values in PATH_POLICY_MARKERS.items()
             if any(value in normalized for value in values)}
    if private_cortex_cache_mentioned(normalized):
        matched.add('cortex_internal')
    return matched


def _shell_command_has_ambiguous_syntax(command):
    """Reject shell expansion/control syntax before classifying operands."""
    quote=None;escaped=False
    for char in command:
        if escaped:
            escaped=False
            continue
        if quote=='single':
            if char=="'":quote=None
            continue
        if quote=='double':
            if char=='\\\\':
                escaped=True
            elif char=='"':
                quote=None
            elif char in '$`':
                return True
            continue
        if char=='\\\\':
            escaped=True
        elif char=="'":quote='single'
        elif char=='"':quote='double'
        elif char in '$`<>|&;()*?[]{}~':
            return True
    return quote is not None or escaped


def _rg_grep_marker_operand_indexes(parts):
    """Return path-bearing token indexes for a simple rg/grep invocation.

    ``None`` means the command shape is ambiguous.  A set distinguishes actual
    path operands from patterns, globs and regular expressions; this keeps a
    literal ``.codex/cortex/`` search marker from becoming an access finding.
    """
    if not parts or parts[0] not in {'rg','grep'}:
        return None
    path_indexes=set();positional=[];explicit_pattern=False;files_mode=False
    pattern_options={'-e','--regexp','-g','--glob','--iglob','--include',
                     '--exclude','--exclude-dir','--type-add'}
    path_options={'-f','--file','--ignore-file','--files-from','--exclude-from'}
    i=1;after_double_dash=False
    while i<len(parts):
        token=parts[i]
        if token=='--' and not after_double_dash:
            after_double_dash=True;i+=1;continue
        if not after_double_dash and token.startswith('-') and token!='-':
            if token in {'--files','--files-with-matches','--files-without-match'}:
                files_mode=True;i+=1;continue
            if token in pattern_options:
                if i+1>=len(parts):return None
                explicit_pattern=True;i+=2;continue
            if token in path_options:
                if i+1>=len(parts):return None
                path_indexes.add(i+1);i+=2;continue
            matched_option=next((option for option in pattern_options
                                 if token.startswith(option+'=')),None)
            if matched_option is not None:
                explicit_pattern=True;i+=1;continue
            matched_option=next((option for option in path_options
                                 if token.startswith(option+'=')),None)
            if matched_option is not None:
                path_indexes.add(i);i+=1;continue
            if token.startswith(('-e','-g')) and len(token)>2:
                explicit_pattern=True;i+=1;continue
            if token.startswith('-f') and len(token)>2:
                path_indexes.add(i);i+=1;continue
            # A marker in an unrecognized option/value cannot be safely
            # interpreted as a pattern or a filesystem operand.
            if _path_policy_marker_classes(token):return None
            i+=1;continue
        positional.append(i);i+=1
    if files_mode:
        path_indexes.update(positional)
    elif explicit_pattern:
        path_indexes.update(positional)
    elif positional:
        # With no explicit pattern, the first positional is the search pattern;
        # remaining positionals are filesystem operands.
        path_indexes.update(positional[1:])
    return path_indexes


def _marker_policy_segments(command):
    """Analyze simple pipelines without treating quoted search globs as paths.

    The worker may use ``rg --files -g '!**/.codex/cortex/**'`` to exclude
    private task storage from project discovery.  The older whole-command
    fallback treated the pipe in a harmless ``rg | sed`` pipeline as opaque and
    then classified that exclusion marker as a private read.  Keep the
    analysis fail-closed for every other shell construct and retain quote
    information so an unquoted private glob remains unauthorized.
    """
    try:
        raw_lexer=shlex.shlex(command,posix=False,punctuation_chars=True)
        raw_lexer.whitespace_split=True
        raw_parts=list(raw_lexer)
    except (ValueError,SyntaxError):
        return None
    clean_parts=shell_command_parts(json.dumps({'cmd':command}))
    if not clean_parts or len(raw_parts)!=len(clean_parts):
        return None
    separators={'&&',';','\\n','|'}
    forbidden={'||','&','&;','>','>>','<','<<'}
    segments=[];current=[]
    for clean,raw in zip(clean_parts,raw_parts):
        if clean in forbidden:
            return None
        if clean in separators:
            if not current:return None
            segments.append(current);current=[]
        else:
            current.append((clean,raw))
    if not current:return None
    segments.append(current)
    matched=set();static=False
    for segment in segments:
        clean=[item[0] for item in segment]
        if clean[0] in {'rg','grep'}:
            indexes=_rg_grep_marker_operand_indexes(clean)
            if indexes is None:return None
            for index,(token,raw) in enumerate(segment):
                classes=_path_policy_marker_classes(token)
                if not classes:continue
                # Both shell quote styles keep an rg/grep pattern or glob
                # literal.  An unquoted marker remains a path/operand finding;
                # other shell ambiguity is still rejected before this branch.
                quoted_literal=(len(raw)>=2 and raw[0]==raw[-1]
                                and raw[0] in {"'", '"'}
                                and not any(char in raw for char in '$`'))
                if index in indexes or not quoted_literal:
                    matched.update(classes)
                else:
                    static=True
        else:
            for token,_ in segment:
                matched.update(_path_policy_marker_classes(token))
    return matched,static


def _python_static_marker_classes(command):
    """Return markers used only as literal Python comparison data.

    Verification scripts may compare preserved audit metadata with an expected
    isolated-candidate path. Keep this narrower than arbitrary Python parsing:
    every marker must be a string literal used directly by ``Compare``.
    Assignments, calls, comments, interpolation and malformed programs remain
    fail-closed so this cannot authorize a plugin/cache filesystem operand.
    """
    if not isinstance(command,str):return None
    inline=re.fullmatch(
        r"(?:PYTHONDONTWRITEBYTECODE=1[ \t]+)?python3(?:[ \t]+-B)?[ \t]+-c[ \t]+'(?P<program>[^'\r\n]*)'[ \t]*",
        command,
    )
    if inline:
        program=inline.group('program')
    else:
        heredoc=re.fullmatch(
            r"(?:PYTHONDONTWRITEBYTECODE=1[ \t]+)?python3(?:[ \t]+-B)?[ \t]+-[ \t]+<<(?P<quote>['\"])(?P<tag>[A-Za-z_][A-Za-z0-9_]*)"
            r"(?P=quote)\r?\n(?P<program>.*)\r?\n(?P=tag)[ \t]*(?:\r?\n)?",
            command,re.S,
        )
        if not heredoc:return None
        program=heredoc.group('program')
    try:tree=ast.parse(program,mode='exec')
    except (SyntaxError,ValueError):return None
    parents={child:parent for parent in ast.walk(tree) for child in ast.iter_child_nodes(parent)}
    constants=[];matched=set()
    for node in ast.walk(tree):
        if not isinstance(node,ast.Constant) or not isinstance(node.value,str):continue
        classes=_path_policy_marker_classes(node.value)
        if not classes:continue
        if not isinstance(parents.get(node),ast.Compare):return None
        constants.append(node);matched.update(classes)
    if not constants:return None
    # Python's AST locations are UTF-8 byte offsets, not Unicode character
    # offsets.  Mask bytes so non-ASCII comparison data cannot shift a later
    # private marker (for example, in a comment) under the masked range.
    encoded=program.encode('utf-8')
    lines=encoded.splitlines(keepends=True)
    offsets=[];offset=0
    for line in lines:
        offsets.append(offset);offset+=len(line)
    masked=bytearray(encoded)
    for node in constants:
        if not all(isinstance(value,int) for value in (
                node.lineno,node.col_offset,node.end_lineno,node.end_col_offset)):
            return None
        start=offsets[node.lineno-1]+node.col_offset
        end=offsets[node.end_lineno-1]+node.end_col_offset
        if not 0<=start<=end<=len(masked):return None
        masked[start:end]=b' '*(end-start)
    if _path_policy_marker_classes(masked.decode('utf-8')):return None
    return matched


def path_policy_marker_classes(tool,arguments,workdir):
    """Classify marker-bearing command operands while preserving fail-closed paths."""
    matched=_path_policy_marker_classes(workdir)
    if tool!='exec_command':
        matched.update(_path_policy_marker_classes(arguments))
        return matched
    command=shell_command_text(arguments)
    parts=shell_command_parts(arguments)
    # Preserve the literal operand classification of the one bounded shell
    # envelope.  A non-static payload will still be rejected by
    # ``skill_instruction_read`` and therefore remains an unauthorized access.
    wrapped=bounded_static_read_wrapper(command)
    if wrapped is not None:
        matched.update(_path_policy_marker_classes(wrapped))
        return matched
    if _python_static_marker_classes(command) is not None and not matched:
        return matched
    if command is None or parts is None:
        matched.update(_path_policy_marker_classes(arguments))
        return matched
    indexes=_rg_grep_marker_operand_indexes(parts)
    if _shell_command_has_ambiguous_syntax(command):
        pipeline=_marker_policy_segments(command)
        if pipeline is not None:
            matched.update(pipeline[0])
            return matched
        matched.update(_path_policy_marker_classes(arguments))
        return matched
    if indexes is None:
        pipeline=_marker_policy_segments(command)
        if pipeline is not None:
            matched.update(pipeline[0])
            return matched
        matched.update(_path_policy_marker_classes(arguments))
        return matched
    for index in indexes:
        matched.update(_path_policy_marker_classes(parts[index]))
    return matched


def path_policy_static_mention(tool,arguments):
    """Recognize a marker kept in a quoted rg/grep pattern or glob."""
    if tool!='exec_command':return False
    command=shell_command_text(arguments)
    parts=shell_command_parts(arguments)
    if _python_static_marker_classes(command) is not None:
        return True
    if command is None or parts is None:
        return False
    if _shell_command_has_ambiguous_syntax(command):
        pipeline=_marker_policy_segments(command)
        return bool(pipeline and pipeline[1] and not pipeline[0])
    if _rg_grep_marker_operand_indexes(parts) is None:
        return False
    return bool(_path_policy_marker_classes(command))


def plugin_cache_access_is_valid(tool,arguments,workdir,*,worker_only=False,coordinator_only=False):
    """Validate each literal plugin/cache read leaf in a mixed shell command.

    A whole command can contain an approved skill read followed by ordinary
    project discovery. That keeps ``skill_instruction_read`` false, while the
    approved cache read itself must not be mislabeled as forbidden access.
    """
    if tool!='exec_command':return False
    parts=shell_command_parts(arguments)
    if not parts:return False
    markers=('/.codex/plugins/','/plugins/cache/','/.agents/plugins/',
             '/.cortex-dev/candidates/','/.codex/agents/','CODEX_HOME/plugins/')
    if any(marker in str(workdir) for marker in markers) or private_cortex_cache_mentioned(workdir):return False
    validated_marker=False
    segments=[];current=[]
    for token in parts:
        if token in {'||','>','>>','<','<<','&','&;'}:
            return False
        if token in {'&&',';','\\n','|'}:
            if not current:return False
            segments.append(current);current=[]
        else:current.append(token)
    if not current:return False
    segments.append(current)
    for segment in segments:
        # Do not let an approved leaf in one segment hide a mutation or nested
        # execution in another segment. Safe mixed discovery remains supported,
        # but every extra operation must pass this independent safety screen.
        executable=Path(segment[0]).name if segment else ''
        if executable in {
                'bash','dash','fish','ksh','sh','tcsh','zsh','env','xargs',
                'chmod','chgrp','chown','cp','dd','install','ln','mkdir','mktemp',
                'mv','patch','rm','rmdir','tee','touch','truncate',
                'node','perl','php','python','python2','python3','ruby',
                'find','locate','ls','stat','tree'}:
            return False
        if any(token in {
                '-i','--in-place','--output','--output-file','--outfile','--write',
                '--append','--delete','--exec','--expression'}
                or token.startswith(('--output=','--output-file=','--outfile=',
                                     '--write=','--append=','--delete=','--exec=',
                                     '--expression='))
                or re.search(r'(?i)(?<![A-Za-z])(write|writeln|in[- ]?place|append|truncate|system|exec|touch|unlink|delete)(?![A-Za-z])',token)
                for token in segment[1:]):
            return False
        # Static labels can mention a path without opening it.
        segment_has_private_cache=any(any(marker in token for marker in markers)
                                      or private_cortex_cache_mentioned(token)
                                      for token in segment)
        if segment[0] in {'printf','echo'}:
            if (any(any(char in token for char in '$`><|&();') for token in segment[1:])
                    and segment_has_private_cache):
                return False
            validated_marker |= segment_has_private_cache
            continue
        if segment_has_private_cache:
            if not declared_skill_instruction_read(
                    'exec_command',json.dumps({'cmd':shlex.join(segment)}),
                    worker_only=worker_only,coordinator_only=coordinator_only):
                return False
            validated_marker=True
    return validated_marker


def path_policy_metadata(tool,arguments,role,workdir):
    """Return safe provenance for path-policy findings without retaining paths.

    Path policy is a worker boundary, not an orchestration boundary by default.
    Keep only the decision-relevant class and how the observer recognized it so
    an audit can distinguish an actual unauthorized target from ordinary project
    tooling or a static mention.
    """
    if tool not in {'exec_command','command_execution','apply_patch','read_file','write_file'}:
        return {}
    normalized=arguments.replace('\\\\','/')
    matched=path_policy_marker_classes(tool,arguments,workdir)
    safe={
        'path_argument_digest':hashlib.sha256(normalized.encode()).hexdigest()[:12],
        'path_workdir_digest':hashlib.sha256(str(workdir).replace('\\\\','/').encode()).hexdigest()[:12],
    }
    if tool=='exec_command':
        intent=command_intent_digest(arguments)
        if intent:safe['path_command_intent_digest']=intent
    if not matched:
        if path_policy_static_mention(tool,arguments):
            return {**safe,
                'path_policy_provenance':'observer_literal_marker',
                'path_target_class':'approved_instruction_or_static_mention',
                'path_access_kind':'static_mention',
                'path_policy_decision':'allowed',
            }
        return {**safe,
            'path_policy_provenance':'observer_argument_scope',
            'path_target_class':'worker_workspace_or_external',
            'path_access_kind':'ordinary_tooling',
            'path_policy_decision':'diagnostic_only',
        }
    coordinator=role in {'coordinator','runtime'}
    instruction_read=skill_instruction_read(
        tool,arguments,worker_only=not coordinator,coordinator_only=coordinator)
    declared_read=declared_skill_instruction_read(
        tool,arguments,worker_only=not coordinator,coordinator_only=coordinator)
    valid=plugin_cache_access_is_valid(
        tool,arguments,workdir,worker_only=not coordinator,coordinator_only=coordinator)
    if instruction_read or declared_read or valid:
        return {**safe,
            'path_policy_provenance':'observer_literal_marker',
            'path_target_class':'approved_instruction_or_static_mention',
            'path_access_kind':'approved_instruction_read' if instruction_read or declared_read else 'static_mention',
            'path_policy_decision':'allowed',
        }
    # A marker-bearing command that is not one of the narrowly approved skill
    # reads is an explicit worker access finding. It remains auditable and is
    # promoted to orchestration acceptance only as unauthorized access.
    target='cortex_internal' if 'cortex_internal' in matched else 'plugin_or_cache'
    return {**safe,
        'path_policy_provenance':'observer_literal_marker',
        'path_target_class':target,
        'path_access_kind':'unauthorized_read_or_probe',
        'path_policy_decision':'unauthorized_access',
    }


def worker_skill_read(tool,arguments):
    """Recognize only the exact worker SKILL leaf used for its initial receipt."""
    if not declared_skill_instruction_read(tool,arguments,worker_only=True):return False
    if tool=='read_file':
        try:value=json.loads(arguments) if isinstance(arguments,str) else arguments
        except (TypeError,ValueError):return False
        path=value.get('path') if isinstance(value,dict) else None
        return isinstance(path,str) and Path(path).name=='SKILL.md'
    command=shell_command_text(arguments)
    if not isinstance(command,str):return False
    command=bounded_static_read_wrapper(command) or command
    paths=re.findall(
        r'(/[A-Za-z0-9_./+@=-]+/skills/worker-[a-z][a-z-]*/(?:SKILL\.md|references/[A-Za-z0-9_-]+\.md))'
        r'(?![A-Za-z0-9_.-])',command)
    return bool(paths) and all(Path(path).name=='SKILL.md' for path in paths)


def worker_skill_profile(tool, arguments):
    """Return the one advertised worker profile read by this exact command."""
    if not worker_skill_read(tool, arguments):
        return None
    if tool=='read_file':
        try:value=json.loads(arguments) if isinstance(arguments,str) else arguments
        except (TypeError,ValueError):return None
        command=value.get('path') if isinstance(value,dict) else None
    else:
        command = shell_command_text(arguments)
        if isinstance(command,str):command = bounded_static_read_wrapper(command) or command
    if not isinstance(command, str):return None
    profiles = {
        match.replace('-', '_')
        for match in re.findall(r'(?:^|/)skills/worker-([a-z][a-z-]*)/SKILL\.md(?:$|[\s"\'])', command)
    }
    if len(profiles) != 1:
        return None
    profile = next(iter(profiles))
    return profile if assigned_worker_profile('$cortex:worker-' + profile.replace('_', '-')) == profile else None


def worker_skill_assignment_receipt(profile, observed_profile, complete):
    """Return the sole receipt value that can authorize worker project work."""
    return ('complete_exact_assigned' if complete is True and isinstance(profile, str)
            and observed_profile == profile else None)


def task_source_revision_violations(rows):
    """Validate source revisions only within one observed task provenance.

    Prefer the explicit task identity when a row carries one, falling back to the
    thread identity for older host rows. A child task starts at one; a parent or
    assignment revision is provenance, never a numeric prefix to compare.
    """
    latest={}; findings=[]
    for index,row in enumerate(rows):
        thread=row.get('thread_id');task_id=row.get('task_id');revision=row.get('source_revision')
        if not isinstance(thread,str) or not thread:thread=None
        if not isinstance(task_id,str) or not task_id:task_id=None
        task=task_id or thread
        if task is None or isinstance(revision,bool) or not isinstance(revision,int):
            continue
        provenance=('task',task) if task_id is not None else ('thread',task)
        if revision < 0:
            finding={'index':index,'thread_id':thread or task,
                     'violation':'task_source_revision_invalid'}
            if task_id is not None:finding['task_id']=task_id
            findings.append(finding)
        elif provenance in latest and revision < latest[provenance]:
            finding={'index':index,'thread_id':thread or task,
                     'violation':'task_source_revision_nonmonotonic'}
            if task_id is not None:finding['task_id']=task_id
            findings.append(finding)
        else:
            latest[provenance]=revision
    return findings


MCP_FIRST_BOOTSTRAP_ROUTE='current_host_mcp_first'
MCP_FIRST_PROVENANCE_SCHEMA='cortex-mcp-first-root-v1'
MCP_FIRST_LAUNCH_STATE=Path(tempfile.gettempdir())/f'cortex-markdown-smoke-{os.getuid()}'
_PRE_BINDING_HOST_TOOLS={
    'functions.exec','exec_command','write_stdin','command_execution','bash','Bash',
    'terminal','read_file','write_file','apply_patch','js',
}


def _observational_pre_task_setup(row):
    """Recognize one narrow, complete coordinator discovery observation.

    This is a classifier for retained host evidence, not a shell allowlist.
    It accepts only a bounded static skill/tool-catalogue read with explicit
    negative project/private/mutation facts.  Any unknown operand class stays
    outside this class and fails the bootstrap contract.
    """
    explicit_scope=(row.get('project_target_access') is False
                    and row.get('private_target_access') is False
                    and row.get('mutation_observed') is False)
    # Current-host nested wrapper receipts preserve the exact bounded static
    # classification but omit redundant false booleans. Treat that omission as
    # complete only for the collector's bounded metadata form; an explicit
    # unknown/true scope value remains outside the exception.
    bounded_transport_scope=(row.get('bounded_metadata_observed') is True
                             and all(key not in row for key in
                                     ('project_target_access','private_target_access','mutation_observed')))
    # The current host's covered wrapper row preserves the positive,
    # manifest-bound ``active_coordinator_skill_read`` proof and the bounded
    # metadata marker, but does not serialize a redundant ``truncated: false``
    # member.  That omission is complete only in this exact collector form;
    # an explicit true/unknown value, or a row without bounded metadata, stays
    # outside the exception and is a pre-binding invalidator.
    bounded_transport_not_truncated=(row.get('bounded_metadata_observed') is True
                                     and 'truncated' not in row)
    static_instruction=(
        row.get('role')=='coordinator'
        and row.get('tool') in {'functions.exec','exec_command','command_execution'}
        and row.get('pre_binding_static_read') is True
        and row.get('skill_instruction_read') is True
        and row.get('active_coordinator_skill_read') is True
        and row.get('bounded_wrapper') is True
        and (explicit_scope or bounded_transport_scope)
        and row.get('path_target_class')=='approved_instruction_or_static_mention'
        and row.get('path_access_kind')=='approved_instruction_read'
        and row.get('path_policy_decision')=='allowed'
        # A single wrapper cannot be both the exact literal skill read and an
        # ALL_TOOLS/catalogue envelope.  Preserve the classifier split rather
        # than letting a mixed wrapper inherit the skill-read exception.
        and row.get('catalogue_mixed') is not True
        and row.get('directory_enumeration') is not True
        and row.get('path_enumeration') is not True
        and row.get('replayed') is not True
        and row.get('replay_marker') is not True
        and row.get('actor_attribution_ambiguous') is not True
        # Current covered-read rows carry no execution-status member.  Preserve
        # that observed form, but reject an explicit dispatch/execution claim:
        # a static SKILL read may not disguise a side-effecting wrapper.
        and row.get('execution_status') in {None,'denied_before_dispatch'}
        and (row.get('truncated') is False or bounded_transport_not_truncated)
        and (row.get('outcome') in {'success','covered_by_command_execution'}
             or (row.get('outcome')=='covered_by_nested'
                 and row.get('bounded_metadata_observed') is True))
        and (row.get('host_receipt_observed') is True
             or row.get('bounded_metadata_observed') is True
             # The current observer may represent the one bounded read as a
             # nested exec_command covered by its command_execution receipt.
             # That receipt is complete and exact even though no duplicate
             # host_receipt_observed flag is serialized on the nested row.
             or (row.get('outcome')=='covered_by_command_execution'
                 and row.get('covered_execution_count')==1
                 and row.get('result_digest') is not None))
    )
    catalogue=(
        row.get('role')=='coordinator'
        and row.get('tool') in {'functions.exec','tool_catalogue_search'}
        and row.get('catalogue_discovery') is True
        and row.get('catalogue_value_free') is True
        and row.get('catalogue_bounded') is True
        and row.get('catalogue_project_free') is True
        and row.get('catalogue_private_free') is True
        and row.get('catalogue_mutation_free') is True
        and row.get('catalogue_mixed') is False
        and row.get('truncated') is False
        and row.get('outcome') in {'success','covered_by_command_execution'}
        and row.get('host_receipt_observed') is True
    )
    return static_instruction or catalogue


def _mcp_first_provenance(state):
    """Read and authenticate the sealed root receipt for this exact CLI launch.

    Session JSON is observation transport, not acceptance evidence.  The
    expected root can be consumed only after an owner-private, create-once
    provenance file is opened without following links, hashed as complete
    bytes, and bound back to the current launch identities.
    """
    workdir=state.get('workdir')
    request_digest=state.get('original_request_sha256')
    expected_thread=state.get('bootstrap_expected_child_thread_id')
    native_digest=state.get('bootstrap_native_user_turn_sha256')
    session_id=state.get('tmux_session_id');pane_id=state.get('tmux_pane_id')
    session_created=state.get('tmux_session_created')
    pane_pid=state.get('tmux_pane_pid');pane_start=state.get('tmux_pane_start_ticks')
    provenance_device=state.get('bootstrap_provenance_device')
    provenance_inode=state.get('bootstrap_provenance_inode')
    digest=state.get('bootstrap_provenance_sha256')
    path_value=state.get('bootstrap_provenance_path')
    if (not isinstance(workdir,str) or not workdir or not isinstance(request_digest,str)
            or not isinstance(expected_thread,str) or not expected_thread
            or not isinstance(native_digest,str) or not isinstance(session_id,str) or not session_id
            or not isinstance(pane_id,str) or not pane_id or not isinstance(digest,str)
            or not isinstance(path_value,str) or not path_value
            or state.get('bootstrap_provenance_schema')!=MCP_FIRST_PROVENANCE_SCHEMA
            or state.get('host_enforcement_state')!='unverified'
            or not re.fullmatch(r'[0-9a-f]{64}',request_digest)
            or not re.fullmatch(r'[0-9a-f]{64}',native_digest)
            or not re.fullmatch(r'[0-9a-f]{64}',digest)
            or any(isinstance(value,bool) or not isinstance(value,int) or value<1
                   for value in (session_created,pane_pid,pane_start,provenance_device,provenance_inode))):
        return None,'bootstrap_context_missing'
    canonical_workdir=str(Path(workdir).resolve())
    if canonical_workdir!=workdir:
        return None,'bootstrap_provenance_binding_mismatch'
    identity=hashlib.sha256((session_id+'\0'+pane_id+'\0'+str(session_created)+'\0'
                             +str(pane_pid)+'\0'+str(pane_start)+'\0'+canonical_workdir).encode()).hexdigest()
    expected_path=MCP_FIRST_LAUNCH_STATE/f'mcp-first-root-{identity}.json'
    path=Path(path_value)
    if path!=expected_path:
        return None,'bootstrap_provenance_path_mismatch'
    try:
        info=path.lstat()
    except FileNotFoundError:
        return None,'bootstrap_provenance_missing'
    except OSError:
        return None,'bootstrap_provenance_unreadable'
    if (path.is_symlink() or not path.is_file() or info.st_uid!=os.getuid()
            or info.st_mode&0o077 or (info.st_mode&0o777)!=0o600):
        return None,'bootstrap_provenance_untrusted'
    flags=os.O_RDONLY|getattr(os,'O_CLOEXEC',0)|getattr(os,'O_NOFOLLOW',0)
    try:
        descriptor=os.open(path,flags)
        try:
            opened=os.fstat(descriptor)
            if (opened.st_dev!=info.st_dev or opened.st_ino!=info.st_ino
                    or opened.st_dev!=provenance_device or opened.st_ino!=provenance_inode
                    or opened.st_uid!=os.getuid() or opened.st_mode&0o077
                    or (opened.st_mode&0o777)!=0o600):
                return None,'bootstrap_provenance_replaced'
            with os.fdopen(descriptor,'rb') as source:
                descriptor=None;raw=source.read()
        finally:
            if descriptor is not None:os.close(descriptor)
        current=path.lstat()
    except OSError:
        return None,'bootstrap_provenance_unreadable'
    if (current.st_dev!=opened.st_dev or current.st_ino!=opened.st_ino
            or current.st_dev!=provenance_device or current.st_ino!=provenance_inode):
        return None,'bootstrap_provenance_replaced'
    if hashlib.sha256(raw).hexdigest()!=digest:
        return None,'bootstrap_provenance_digest_mismatch'
    try:
        receipt=json.loads(raw.decode('utf-8'))
    except (UnicodeDecodeError,ValueError):
        return None,'bootstrap_provenance_malformed'
    if not isinstance(receipt,dict):
        return None,'bootstrap_provenance_malformed'
    canonical=(json.dumps(receipt,sort_keys=True,separators=(',',':'))+'\n').encode()
    if raw!=canonical:
        return None,'bootstrap_provenance_malformed'
    expected={
        'schema_version':MCP_FIRST_PROVENANCE_SCHEMA,
        'bootstrap_route':MCP_FIRST_BOOTSTRAP_ROUTE,
        'host_enforcement_state':'unverified',
        'thread_id':expected_thread,
        'workdir':canonical_workdir,
        'original_request_sha256':request_digest,
        'tmux_session_id':session_id,
        'tmux_session_created':session_created,
        'tmux_pane_id':pane_id,
        'tmux_pane_pid':pane_pid,
        'tmux_pane_start_ticks':pane_start,
        'native_user_turn_sha256':native_digest,
    }
    if set(receipt)!=set(expected) or any(receipt.get(key)!=value for key,value in expected.items()):
        return None,'bootstrap_provenance_binding_mismatch'
    return receipt,None


def mcp_first_bootstrap_receipt(rows,state):
    """Derive a child-owned direct-MCP bootstrap receipt, or a safe failure.

    The current host has no typed pre-dispatch attestation. A valid result proves
    only observed ordering and exact native/MCP binding; it never proves host
    enforcement and cannot be supplied by the caller.
    """
    if state.get('bootstrap_route') != MCP_FIRST_BOOTSTRAP_ROUTE:
        return None
    provenance,reason=_mcp_first_provenance(state)
    if provenance is None:
        return {'status':'unverified','reason':reason}
    workdir=provenance['workdir']
    request_digest=provenance['original_request_sha256']
    expected_thread=provenance['thread_id']
    provenance_digest=state['bootstrap_provenance_sha256']
    expected_project=hashlib.sha256(workdir.encode()).hexdigest()
    relevant=[(index,row) for index,row in enumerate(rows)
              if isinstance(row,dict) and row.get('role')!='runtime']
    roots={row.get('thread_id') for _,row in relevant
           if row.get('parent_thread_id') is None
           and isinstance(row.get('thread_id'),str) and row['thread_id']}
    if expected_thread not in roots:
        return {'status':'unverified','reason':'bootstrap_expected_root_absent'}
    if roots != {expected_thread}:
        return {'status':'unverified','reason':'bootstrap_competing_root'}
    qualifying=None
    for index,row in relevant:
        tool=row.get('tool')
        if tool in {'native_user_input','launcher_transport'} or row.get('direct_public_mcp_transport') is True:
            continue
        if qualifying is None and _observational_pre_task_setup(row):
            continue
        # A custom functions.exec transport is recorded before its sole
        # nested exec_command.  When that nested row is the exact approved
        # bounded setup read, the outer covered wrapper is transport metadata,
        # not an independent pre-binding host action.
        if (qualifying is None and tool=='functions.exec'
                and row.get('outcome')=='covered_by_nested'
                and index + 1 < len(relevant)):
            nested=relevant[index + 1][1]
            if (nested.get('nested') is True
                    and nested.get('wrapper_argument_digest')==row.get('argument_digest')
                    and (row.get('bounded_metadata_observed') is True
                         or (nested.get('outcome')=='covered_by_command_execution'
                             and nested.get('covered_execution_count')==1))
                    and _observational_pre_task_setup(nested)):
                continue
        if qualifying is not None:
            # The first other action begins the post-binding segment.  A second
            # direct create receipt before that boundary is ambiguous evidence,
            # including an identical replay or a differently labelled copy.
            if tool=='mcp__cortex__create_task':
                return {'status':'unverified','reason':'bootstrap_duplicate_receipt','index':index}
            break
        # A direct public create_task is the pre-binding -> bound transition.
        # When current-host transport serializes it inside functions.exec, the
        # collector marks that sole literal MCP member call explicitly.  Other
        # nested/wrapped create calls remain inadmissible.
        if (tool=='mcp__cortex__create_task' and row.get('nested') is True
                and row.get('direct_public_mcp') is not True):
            return {'status':'unverified','reason':'bootstrap_wrapped_receipt','index':index}
        if (tool in _PRE_BINDING_HOST_TOOLS
                or (row.get('nested') is True and tool!='mcp__cortex__create_task')
                or row.get('path_target_class') in {'plugin','plugin_cache','cache','candidate','registry','internal'}
                or row.get('path_policy_decision') == 'unauthorized_access'):
            return {'status':'unverified','reason':'pre_binding_host_action','index':index}
        if tool!='mcp__cortex__create_task':
            return {'status':'unverified','reason':'bootstrap_not_first','index':index}
        if row.get('outcome')!='success' or row.get('host_receipt_outcome')!='success':
            return {'status':'unverified','reason':'bootstrap_mcp_failed','index':index}
        if row.get('replayed') is True or row.get('replay_marker') is True:
            return {'status':'unverified','reason':'bootstrap_replayed_receipt','index':index}
        if (row.get('host_receipt_observed') is not True
                or (row.get('server_observed') is not True
                    and row.get('result_receipt_observed') is not True)
                or row.get('parent_thread_id') is not None
                or not isinstance(row.get('thread_id'),str) or not row['thread_id']):
            return {'status':'unverified','reason':'bootstrap_native_receipt_invalid','index':index}
        if row['thread_id'] != expected_thread:
            return {'status':'unverified','reason':'bootstrap_child_thread_mismatch','index':index}
        if row.get('bootstrap_project_digest') != expected_project:
            return {'status':'unverified','reason':'bootstrap_project_mismatch','index':index}
        if row.get('original_request_preserved') is not True:
            return {'status':'unverified','reason':'bootstrap_request_mismatch','index':index}
        result_digest=row.get('host_result_digest')
        # Host result digests are intentionally bounded by the existing
        # observer protocol; their source is still the exact MCP receipt.
        if not isinstance(result_digest,str) or not re.fullmatch(r'[0-9a-f]{12}',result_digest):
            return {'status':'unverified','reason':'bootstrap_native_receipt_invalid','index':index}
        task_id=row.get('task_id')
        if task_id is not None and (not isinstance(task_id,str) or not task_id):
            return {'status':'unverified','reason':'bootstrap_task_receipt_invalid','index':index}
        task_binding=({'task_binding':'opaque_root_binding'} if task_id is None else
                      {'task_digest':hashlib.sha256(task_id.encode()).hexdigest()})
        qualifying={
            'status':'complete','route':MCP_FIRST_BOOTSTRAP_ROUTE,
            'host_enforcement_state':'unverified','thread_id':row['thread_id'],
            'bootstrap_provenance_sha256':provenance_digest,
            **task_binding,
            'project_digest':expected_project,'original_request_sha256':request_digest,
            'native_receipt_digest':result_digest,
            'result_receipt_observed':row.get('result_receipt_observed') is True,
            'server_event_observed':row.get('server_observed') is True,
        }
    if qualifying is not None:
        return qualifying
    return {'status':'unverified','reason':'bootstrap_receipt_missing'}


def current_host_observational_qualification(rows,state,classification,bootstrap_receipt,
                                             *,capture_complete,events_complete,
                                             terminal_complete,exit_complete):
    """Return the honest current-host acceptance label from complete evidence.

    It proves an observed public workflow only.  It never converts an absent
    host authorization receipt into an enforcement claim.
    """
    if state.get('bootstrap_route')!=MCP_FIRST_BOOTSTRAP_ROUTE:
        return None
    outcome,outcome_reason=current_host_outcome_receipt(rows,state)
    bootstrap_complete=(isinstance(bootstrap_receipt,dict)
                        and bootstrap_receipt.get('status')=='complete')
    # Capture, audit, and terminal completion are observable current-host facts,
    # not optional host attestations.  Keep their failure distinct from an
    # unavailable bootstrap/assignment/skill/server/exit signal so the latter
    # can be retained as a diagnostic after the complete outcome correlation.
    if not (capture_complete is True and events_complete is True
            and terminal_complete is True and exit_complete is True
            and isinstance(classification,dict)
            and classification.get('evidence_valid') is True):
        return {'status':'BLOCK','qualification_contract':'observational_accept',
                'host_enforcement_state':'unverified',
                'reason':'observational_evidence_incomplete'}
    if not (bootstrap_complete or outcome is not None):
        return {'status':'BLOCK','qualification_contract':'observational_accept',
                'host_enforcement_state':'unverified',
                'reason':outcome_reason if outcome_reason not in {None,'not_current_host_route'}
                else 'observational_evidence_incomplete'}
    if any(isinstance(row,dict) and row.get('classification')=='product_quality_outcome'
           for row in classification.get('quality_findings',[])):
        return {'status':'BLOCK','qualification_contract':'observational_accept',
                'host_enforcement_state':'unverified',
                'reason':'product_quality_outcome'}
    if outcome is not None:
        return {'status':'observational_accept','qualification_contract':'observational_accept',
                'host_enforcement_state':'unverified','assignment_enforcement_state':'unverified',
                'bootstrap_thread_id':outcome['thread_id'],'outcome_receipt':outcome}
    # A successful native worker result must remain tied to exactly one
    # task-bound published report.  ``call_policy_violations`` emits a blocking
    # finding for absent, foreign, duplicate, or post-publication activity.
    results=[row for row in rows if row.get('tool')=='native_agent_result'
             and row.get('outcome')=='success']
    if any(not row.get('report_id') for row in results):
        return {'status':'BLOCK','qualification_contract':'observational_accept',
                'host_enforcement_state':'unverified','reason':'worker_report_provenance_missing'}
    # Some current-host envelopes expose a complete public MCP result but no
    # separate server event. That is not host enforcement. It is admissible
    # only when one later, non-replayed task-thread publication receipt binds
    # the observed bootstrap; missing or competing publications stay blocked.
    if (bootstrap_receipt.get('result_receipt_observed') is True
            and bootstrap_receipt.get('server_event_observed') is not True):
        publications=[row for row in rows
                      if row.get('thread_id')==bootstrap_receipt.get('thread_id')
                      and row.get('tool')=='mcp__cortex__write_report'
                      and row.get('outcome')=='success'
                      and row.get('host_receipt_outcome')=='success'
                      and row.get('result_receipt_observed') is True
                      and isinstance(row.get('report_id'),str)
                      and row.get('replayed') is not True and row.get('truncated') is not True]
        if len(publications)!=1:
            return {'status':'BLOCK','qualification_contract':'observational_accept',
                    'host_enforcement_state':'unverified',
                    'reason':'observational_publication_correlation_missing'}
    return {'status':'observational_accept','qualification_contract':'observational_accept',
            'host_enforcement_state':'unverified',
            'assignment_enforcement_state':'unverified',
            'bootstrap_thread_id':bootstrap_receipt.get('thread_id')}


def mcp_first_bootstrap_violations(rows,state):
    """Return one fail-closed finding for a requested MCP-first bootstrap."""
    receipt=mcp_first_bootstrap_receipt(rows,state)
    if receipt is None or receipt.get('status')=='complete':
        return []
    reason=receipt.get('reason','bootstrap_receipt_missing')
    violation=('pre_binding_host_action' if reason=='pre_binding_host_action'
               else 'mcp_first_bootstrap_'+reason)
    index=receipt.get('index')
    offending=(rows[index] if isinstance(index,int) and 0<=index<len(rows)
               and isinstance(rows[index],dict) else {})
    finding={'thread_id':offending.get('thread_id'),'role':offending.get('role','runtime'),
             'tool':offending.get('tool','unknown'),'violation':violation,
             'bootstrap_route':MCP_FIRST_BOOTSTRAP_ROUTE}
    if isinstance(index,int):
        finding['index']=index
    # Keep a bounded causal reference without retaining raw command operands.
    for key in ('nested','argument_digest','wrapper_argument_digest','result_digest',
                'host_result_digest','tool_namespace'):
        value=offending.get(key)
        if isinstance(value,(str,bool)):
            finding[key]=value
    return [finding]


def canonical_mcp_call_key(row):
    """Return a bounded semantic identity for an observed Cortex MCP call.

    Event ordering is transport timing, not provenance.  A key combines the
    owning thread, canonical operation and an operation-specific public
    identity.  It contains no raw arguments and is absent rather than guessed
    when the host did not expose a usable identity.
    """
    if not isinstance(row,dict):
        return None
    thread=row.get('thread_id')
    tool=canonical_tool_name(row)
    if not isinstance(thread,str) or not thread or not isinstance(tool,str) or not tool.startswith('mcp__cortex__'):
        return None
    task=row.get('task_id')
    report=row.get('report_id') or row.get('requested_report_id')
    draft=row.get('draft_id')
    template=row.get('template')
    identity=(('draft_id',draft) if tool=='mcp__cortex__write_report' and isinstance(draft,str) and draft else
              ('task_id',task) if isinstance(task,str) and task else
              ('report_id',report) if isinstance(report,str) and report else
              ('draft_id',draft) if isinstance(draft,str) and draft else
              ('template',template) if isinstance(template,str) and template else None)
    if identity is None:
        return None
    material=json.dumps((thread,tool,identity),separators=(',',':'))
    return hashlib.sha256(material.encode()).hexdigest()[:24]


def safe_call_metadata(tool,arguments):
    """Expose only bounded routing fields needed to audit native delegation."""
    if tool not in {'spawn_agent','followup_task','send_message','wait_agent'}:return {}
    try:value=json.loads(arguments)
    except (TypeError,ValueError):return {}
    if not isinstance(value,dict):return {}
    if tool in {'followup_task','send_message'}:
        target=value.get('target')
        return ({'target_agent':target} if isinstance(target,str)
                and re.fullmatch(r'[A-Za-z0-9_/-]{1,256}',target) else {})
    if tool=='wait_agent':
        targets=value.get('targets')
        if (not isinstance(targets,list) or not targets
                or not all(isinstance(target,dict) and set(target)<= {'threadId','thread_id','afterCursor'}
                           and isinstance(target.get('threadId',target.get('thread_id')),str)
                           and target.get('threadId',target.get('thread_id'))
                           for target in targets)):
            return {}
        identifiers=[target.get('threadId',target.get('thread_id')) for target in targets]
        return {'wait_target_thread_ids':sorted(identifiers)} if len(set(identifiers))==len(identifiers) else {}
    # Keep this aligned with the native ``spawn_agent`` contract.  Policy
    # provenance belongs in the bounded assignment message, not invented
    # top-level arguments.
    allowed=('task_name','fork_turns')
    result={key:value[key] for key in allowed if isinstance(value.get(key),str)}
    if isinstance(value.get('model'),str):result['requested_model']=value['model']
    if isinstance(value.get('reasoning_effort'),str):result['requested_reasoning_effort']=value['reasoning_effort']
    message=value.get('message','')
    if isinstance(message,str):result['assignment_digest']=hashlib.sha256(message.encode()).hexdigest()
    if isinstance(message,str) and re.fullmatch(r'gAAAAA[A-Za-z0-9_=-]{80,}',message):
        result['assignment_content_unavailable']=True
    result.update(assignment_policy_metadata(message))
    profile=assigned_worker_profile(str(message))
    if profile:result['assigned_profile']=profile
    elif result.get('assignment_content_unavailable') and value.get('task_name')=='senior_consultant':
        result['assigned_profile']='senior_consultant'
        result['profile_evidence']='native_task_name'
    return result


def native_agent_result_metadata(payload):
    """Extract only lifecycle status and short report IDs from a native handoff."""
    if not isinstance(payload,dict) or payload.get('type')!='agent_message':return None
    content=payload.get('content') or []
    rendered='\n'.join(str(part.get('text','')) for part in content if isinstance(part,dict))
    if not rendered.startswith('Message Type: FINAL_ANSWER\n'):return None
    report_ids=sorted(set(re.findall(r'(?<![0-9a-f])r_[0-9a-f]{12}(?![0-9a-f])',rendered)))
    failed='Agent errored:' in rendered or "agent's turn failed" in rendered
    result=dict(agent_path=payload.get('author'),outcome='error' if failed else 'success')
    if len(report_ids)==1:result['report_id']=report_ids[0]
    elif report_ids:result['report_ids']=report_ids
    if failed:
        result['error_code']=('agent_model_capacity' if 'model is at capacity' in rendered.lower()
                              else 'native_agent_error')
    body,error=parse_native_worker_result(rendered.split('\n',1)[1])
    if body is not None:
        result['native_worker_result']=body
    elif 'Cortex native worker result:' in rendered:
        result['native_worker_result_error']=error
    return result


def command_intent_digest(arguments):
    """Correlate a retried command with the last command in a simple shell chain."""
    match=re.search(r'(?:["\']cmd["\']|\bcmd)\s*:\s*(["\'])(.*?)\1',arguments,re.S)
    if not match:return None
    return raw_command_intent_digest(match.group(2))


def raw_command_intent_digest(command):
    """Identify the command capability while discarding ports and loopback spelling."""
    command=command.strip()
    if re.search(r'(?:^|\s)python3\s+-m\s+http\.server(?:\s|$)',command):
        command='python3 -m http.server'
    elif re.search(r'(?:^|\s)curl(?:\s|$)',command):
        urls=re.findall(r'https?://(?:localhost|127\.0\.0\.1|0\.0\.0\.0)(?::\d+)?([^\s"\']*)',command)
        if urls:command='curl '+(urls[0] or '/')
    segments=[part.strip() for part in re.split(r'\s*(?:&&|;)\s*',command) if part.strip()]
    if not segments:return None
    return hashlib.sha256(segments[-1].encode()).hexdigest()[:12]


def browser_call_metadata(arguments):
    """Expose only the browser resource decision needed by the live policy audit."""
    action=None
    if 'createBrowserTab' in arguments:action='create_tab'
    elif re.search(r'\bcua\.getTab\s*\(|\.tabs\.get\s*\(',arguments):action='attach_tab'
    elif re.search(r'\bcua\.getState\s*\(',arguments):action='inventory'
    if not action:return {}
    match=re.search(r'https?://(?:localhost|127\.0\.0\.1|0\.0\.0\.0)(?::\d+)?',arguments)
    origin=match.group(0).replace('127.0.0.1','localhost').replace('0.0.0.0','localhost') if match else None
    result={'browser_action':action}
    if origin:result['browser_origin']=origin
    return result


def local_http_origin(source):
    """Return a normalized loopback origin without retaining a full command."""
    match=re.search(r'https?://(?:localhost|127\.0\.0\.1|0\.0\.0\.0)(?::\d+)?',source)
    if not match:return None
    return match.group(0).replace('127.0.0.1','localhost').replace('0.0.0.0','localhost')


def browser_mutation_count(arguments):
    """Count explicit state-changing browser operations in a CUA request."""
    patterns=(r'\.click\s*\(',r'\.fill\s*\(',r'\.setValue\s*\(',r'\.check\s*\(',
              r'\.uncheck\s*\(',r'\.setChecked\s*\(',r'\.press\s*\(',
              r'\.navigate\s*\(',r'\.goto\s*\(',r'\.setViewportSize\s*\(')
    return sum(len(re.findall(pattern,arguments)) for pattern in patterns)


def draft_call_metadata(tool,arguments):
    """Mark edits to Cortex-owned draft documents without retaining their paths."""
    normalized=arguments.replace('\\\\','/')
    if tool=='apply_patch':
        targets=re.findall(r'^\*\*\* (Add File|Update File|Delete File|Move to): ([^\r\n]+)',
                           normalized.replace('\\n','\n'),re.MULTILINE)
        if targets and all(kind=='Update File' and re.search(r'(?:^|/)\.cortex/(?:draft-reports|pipeline-drafts)/d_[0-9a-f]{12}\.md$', path) and '..' not in Path(path).parts for kind,path in targets):
            return {'cortex_draft_edit':True,
                    'edited_draft_ids':sorted({Path(path).stem for _,path in targets}),
                    'ordinary_draft_edit':all(re.search(r'(?:^|/)\.cortex/draft-reports/',path) is not None for _,path in targets)}
    return {}


def python_artifact_read_paths(command):
    """Recognize a closed, side-effect-free root-file byte/text reconciliation.

    This is syntax/type inspection, never execution of the submitted program.
    Unknown Python, shell syntax, writes and computed paths stay unrecognized.
    """
    try:
        heredoc=re.fullmatch(r"python3(?: -B)? - <<'PY'\n(.*?)\nPY\s*",command,re.S)
        if heredoc:
            program=heredoc[1]
        else:
            tokens=shlex.split(command)
            if tokens[:2]==['python3','-B']:tokens=tokens[:1]+tokens[2:]
            if len(tokens)!=3 or tokens[:2]!=['python3','-c']:return []
            program=tokens[2]
        tree=ast.parse(program)
    except (ValueError,SyntaxError):return []
    bindings={};imports=set();paths=set();printed=False
    def kind(node):
        if isinstance(node,ast.Constant):
            return {str:'text',bytes:'bytes',int:'int',bool:'bool'}.get(type(node.value))
        if isinstance(node,ast.Name):return bindings.get(node.id)
        if isinstance(node,ast.Attribute):
            if node.attr=='returncode' and kind(node.value)=='git-result':return 'int'
            return None
        if isinstance(node,ast.Compare):
            if (len(node.ops)==1 and isinstance(node.ops[0],ast.Eq)
                    and kind(node.left) in {'bytes','text','int','bool'}
                    and kind(node.left)==kind(node.comparators[0])):return 'bool'
            return None
        if not isinstance(node,ast.Call):return None
        if isinstance(node.func,ast.Name):
            if node.keywords:return None
            name=node.func.id
            if name=='Path' and 'Path' in imports and len(node.args)==1:
                value=node.args[0]
                if (isinstance(value,ast.Constant) and isinstance(value.value,str)
                        and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}',value.value)):
                    paths.add(value.value);return 'path'
            if name in {'len','repr'} and len(node.args)==1:
                value=kind(node.args[0])
                if value in {'bytes','text','lines'}:return 'int' if name=='len' else 'text'
            if name=='all' and len(node.args)==1 and isinstance(node.args[0],ast.GeneratorExp):
                generator=node.args[0]
                if len(generator.generators)!=1:return None
                clause=generator.generators[0]
                if (clause.ifs or clause.is_async or not isinstance(clause.target,ast.Name)
                        or clause.target.id in {*bindings,'Path','hashlib','subprocess','print','len','repr','all'}
                        or kind(clause.iter)!='lines' or not isinstance(clause.iter,ast.Call)
                        or not isinstance(clause.iter.func,ast.Attribute)):return None
                bindings[clause.target.id]=kind(clause.iter.func.value)
                result=kind(generator.elt)
                del bindings[clause.target.id]
                return 'bool' if result=='bool' else None
            return None
        if not isinstance(node.func,ast.Attribute):return None
        receiver=node.func.value;method=node.func.attr
        receiver_kind=kind(receiver)
        if receiver_kind in {'bytes','text'} and method=='splitlines' and not node.args:
            if (not node.keywords or len(node.keywords)==1
                    and node.keywords[0].arg=='keepends'
                    and isinstance(node.keywords[0].value,ast.Constant)
                    and type(node.keywords[0].value.value) is bool):return 'lines'
            return None
        if node.keywords:return None
        if (isinstance(receiver,ast.Name) and receiver.id=='subprocess'
                and 'subprocess' in imports and method=='run' and len(node.args)==1
                and isinstance(node.args[0],ast.List)):
            values=node.args[0].elts
            if not all(isinstance(value,ast.Constant) and isinstance(value.value,str) for value in values):return None
            args=[value.value for value in values]
            if (args[:4]==['git','diff','--quiet','--'] and len(args)>4
                    and all(re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_./-]*',path)
                            and '..' not in path.split('/') for path in args[4:])):return 'git-result'
            return None
        if (isinstance(receiver,ast.Name) and receiver.id=='hashlib'
                and 'hashlib' in imports and method=='sha256'
                and len(node.args)==1 and kind(node.args[0])=='bytes'):return 'digest'
        if receiver_kind=='path' and not node.args:
            return {'read_bytes':'bytes','read_text':'text'}.get(method)
        if receiver_kind=='digest' and method=='hexdigest' and not node.args:return 'text'
        if receiver_kind in {'bytes','text'}:
            if method=='splitlines' and not node.args:return 'lines'
            if method in {'count','endswith'} and len(node.args)==1:
                if isinstance(node.args[0],ast.Constant) and kind(node.args[0])==receiver_kind:
                    return 'int' if method=='count' else 'bool'
            if (receiver_kind=='bytes' and method=='decode' and len(node.args)==1
                    and isinstance(node.args[0],ast.Constant)
                    and node.args[0].value=='utf-8'):return 'text'
        return None
    for statement in tree.body:
        if (isinstance(statement,ast.ImportFrom) and statement.module=='pathlib'
                and statement.level==0 and len(statement.names)==1
                and statement.names[0].name=='Path' and statement.names[0].asname is None):
            imports.add('Path');continue
        if (isinstance(statement,ast.Import) and statement.names
                and all(name.name in {'hashlib','subprocess'} and name.asname is None for name in statement.names)):
            imports.update(name.name for name in statement.names);continue
        if (isinstance(statement,ast.Assign) and len(statement.targets)==1
                and isinstance(statement.targets[0],ast.Name)):
            name=statement.targets[0].id
            if name in {'Path','hashlib','subprocess','print','len','repr','all'} or name in bindings:return []
            value=kind(statement.value)
            if value is None:return []
            bindings[name]=value;continue
        if isinstance(statement,ast.Expr) and isinstance(statement.value,ast.Call):
            call=statement.value
            if (isinstance(call.func,ast.Name) and call.func.id=='print'
                    and call.args and not call.keywords
                    and all(kind(arg) in {'text','bytes','int','bool','lines'} for arg in call.args)):
                printed=True;continue
        return []
    return sorted(paths) if printed and len(paths)==1 else []


def coordinator_source_read(tool,arguments):
    """Recognize a single bounded read command used for a user-provided source."""
    if tool == 'read_file':
        return True  # Independent path classification still rejects private operands.
    if tool!='exec_command':return False
    try:command=json.loads(arguments).get('cmd')
    except (AttributeError,ValueError):
        command=shell_command_text(arguments)
    if not isinstance(command,str):return False
    if python_skill_read_paths(command):
        return True  # Closed one-literal-path read grammar; path policy still applies.
    if python_artifact_read_paths(command):
        return True
    status_envelope=re.fullmatch(
        r'(.+?);\s*([A-Za-z_][A-Za-z0-9_]*)=\$\?;\s*(.+);\s*exit \$\2',command)
    if status_envelope and status_envelope[2] not in {'HOME','PATH','CODEX_HOME','SHELL','IFS','ENV','BASH_ENV'}:
        command=status_envelope[1]+'; '+status_envelope[3]
    # The only permitted shell metacharacter is the literal sed EOF address;
    # it still requires one concrete path operand and is parsed as one command.
    eof_sed = re.fullmatch(r"sed\s+-n\s+'1,\$p'\s+[^\s]+", command) is not None
    if re.search(r'[`\r]',command) or ('$' in command and not eof_sed):return False
    try:
        lexer=shlex.shlex(command,posix=True,punctuation_chars=';&|<>\n')
        lexer.whitespace=' \t'
        lexer.whitespace_split=True;lexer.commenters=''
        shell_tokens=list(lexer)
    except ValueError:return False
    groups=[];tokens=[]
    for token in shell_tokens:
        if token in {'&&','||',';','|'} or token and not token.strip('\n'):
            if not tokens:return False
            groups.append(tokens);tokens=[]
        elif token!='<' and token and all(char in ';&|<>\n' for char in token):
            return False  # Redirection, background dispatch or unsupported syntax.
        else:tokens.append(token)
    if not tokens:return False
    groups.append(tokens)
    if len(groups)>12:return False
    return all(_coordinator_read_tokens(tokens) for tokens in groups)


def _coordinator_read_tokens(tokens):
    """Closed read/compare command set; shell syntax was parsed separately."""
    if not tokens:return False
    if any(token in {'&&','||','&'} for token in tokens):return False
    if '<' in tokens:
        if (tokens.count('<')!=1 or tokens.index('<')!=len(tokens)-2
                or tokens[0] not in {'cat','wc','head','tail','sha256sum'}
                or not tokens[-1] or tokens[-1].startswith('-')):
            return False
        tokens=tokens[:-2]+tokens[-1:]
    if tokens in (['set','-o','pipefail'],['exit','0']):return True
    if tokens[0]=='PYTHONDONTWRITEBYTECODE=1':tokens=tokens[1:]
    if not tokens:return False
    if tokens[:2] in (['git','status'],['git','diff'],['git','log'],['git','show']):
        return not any(token.startswith(('--output','--ext-diff','--textconv')) for token in tokens)
    if tokens[0] in {'sha256sum','nl','cmp','pwd'}:return True
    if tokens[0] in {'echo','true'}:return True
    if tokens[0]=='printf':return len(tokens)>1 and tokens[1]!='-v'
    if tokens[:3]==['python3','-m','unittest'] or tokens[:4]==['python3','-B','-m','unittest']:
        return True
    if tokens[0] == 'cat':
        return len(tokens)>=2 and not any(token.startswith('-') and token!='--' for token in tokens[1:])
    if tokens[0]=='sed':
        return (len(tokens)>=4 and tokens[1]=='-n'
                and tokens[-1] != 'EOF'
                and (re.fullmatch(r'[0-9]+(?:,[0-9]+)?[pl]',tokens[2]) is not None
                     or tokens[2]=='1,$p')
                and not any(token.startswith('-') for token in tokens[3:]))
    if tokens[0]=='rg' and any(token=='--pre' or token.startswith('--pre=') for token in tokens):return False
    return tokens[0] in {'head','tail','rg','grep','wc','stat'}


def observed_session_ids(raw):
    if isinstance(raw,list):
        rendered='\n'.join(str(item.get('text','')) if isinstance(item,dict) else str(item) for item in raw)
    else:rendered=str(raw)
    return sorted({int(value) for value in re.findall(r'\\?"session_id\\?"\s*:\s*([0-9]+)',rendered)})


def call_policy_flags(tool,arguments,role,workdir):
    flags=[];normalized=arguments.replace('\\\\','/')
    coordinator=role in {'coordinator','runtime'}
    instruction_read=skill_instruction_read(
        tool,arguments,worker_only=not coordinator,coordinator_only=coordinator)
    if (coordinator and not instruction_read
            and declared_skill_instruction_read(tool,arguments)
            and not declared_skill_instruction_read(tool,arguments,coordinator_only=True)):
        flags.append('forbidden_plugin_or_cache_access')
    if role=='senior_consultant':
        # The consultant is intentionally report-only. Its native host still
        # exposes general tools, so keep this boundary observable and fail-closed
        # for project, index, network, agent, and coordinator operations.
        consultant_report_tools={
            'mcp__cortex__read_report','mcp__cortex__create_draft',
            'mcp__cortex__read_draft','mcp__cortex__write_report',
        }
        own_draft=draft_call_metadata(tool,arguments).get('ordinary_draft_edit') is True
        native_parent=tool=='send_message'
        standard_skill=tool.startswith('skills__') or tool in {'skills_read','skills_list'}
        if tool not in consultant_report_tools and not (own_draft or standard_skill or native_parent or tool=='tool_catalogue_search'):
            if tool=='mcp__cortex__list_reports':
                flags.append('senior_consultant_report_catalogue_access')
            if tool.startswith('mcp__cortex__'):
                flags.append('senior_consultant_forbidden_cortex_tool')
            else:
                flags.append('senior_consultant_forbidden_project_access')
        elif tool=='mcp__cortex__read_report' and 'report_id' in normalized:
            # The server validates report IDs; the observer only rejects a
            # malformed/non-report selector rather than guessing identities.
            if not re.search(r'r_[0-9a-f]{12}',normalized):
                flags.append('senior_consultant_invalid_report_selection')
    installed_markers=('/.codex/plugins/','/plugins/cache/','/.agents/plugins/',
                       '/.cortex-dev/candidates/','/.codex/agents/','CODEX_HOME/plugins/')
    access_scope=normalized
    if tool=='apply_patch':
        # Evidence may mention a skill path without opening or editing that file.
        # Only patch headers identify write targets; added report prose does not.
        targets=re.findall(r'^\*\*\* (?:Add File|Update File|Delete File|Move to): ([^\r\n]+)',
                           normalized.replace('\\n','\n'),re.MULTILINE)
        if targets:
            access_scope='\n'.join(str((Path(workdir)/target).resolve()) for target in targets)
    marker_classes=path_policy_marker_classes(tool,arguments,workdir)
    if tool=='apply_patch' and access_scope!=normalized:
        marker_classes=_path_policy_marker_classes(access_scope)
    if (not instruction_read and marker_classes
            and not plugin_cache_access_is_valid(tool,arguments,workdir)):
        flags.append('forbidden_plugin_or_cache_access')
    if tool=='apply_patch' and 'Delete File' in arguments and '/.cortex/' in normalized:
        flags.append('forbidden_cortex_draft_deletion')
    # Native worker updates are delivered automatically by the parent/subagent
    # channel. The host may expose app connectors globally, so detect an app
    # task-message route at the observed call boundary and fail the live audit
    # closed instead of treating the call as ordinary worker tooling.
    app_message_route = (
        tool in {'send_message_to_thread', 'mcp__codex_app__send_message_to_thread'}
        or (tool == 'send_message_to_thread' and role not in {'coordinator', 'runtime'})
    )
    if role not in {'coordinator', 'runtime'} and app_message_route:
        flags.append('forbidden_worker_app_thread_message')
    verification_roles={'accessibility_auditor','build_verification','code_reviewer','qa_engineer'}
    if (tool=='exec_command' and role in verification_roles
            and re.search(r'(?<![A-Za-z0-9_.-])(?:ps\s+-e|pgrep\b|lsof\b|netstat\b|ss\s+-)',arguments)):
        flags.append('forbidden_global_process_probe')
    if (tool=='exec_command' and '.git/HEAD' in arguments and re.search(r'\bopen\s*\(',arguments)
            and not re.search(r'(?:is_file|isfile)\s*\(',arguments)):
        flags.append('unguarded_optional_git_marker_read')
    if (tool=='exec_command' and re.search(r'(?<![A-Za-z0-9_.-])git(?=\s|["\'])',arguments)
            and not (Path(workdir)/'.git').exists()):
        flags.append('git_command_without_git_workspace')
    if role=='coordinator':
        native_coordination={'spawn_agent','wait_agent','send_message','followup_task',
                             'list_agents','interrupt_agent','close_agent','tool_catalogue_search'}
        draft_edit=(tool=='apply_patch' and
                    ('/.cortex/pipeline-drafts/' in normalized or
                     '/.cortex/draft-reports/' in normalized))
        standard_skill=tool.startswith('skills__') or tool in {'skills_read','skills_list'}
        source_read=coordinator_source_read(tool,arguments)
        if (tool not in native_coordination and not draft_edit and not standard_skill
                and not instruction_read and not source_read
                and not tool.startswith('mcp__cortex__')):
            flags.append('coordinator_forbidden_tool')
    return flags


def completed_assignment_snapshots(history):
    """Reduce pre-resume receipts to completed ownership, without replaying calls."""
    states={};owned={}
    for row in sorted(history,key=lambda r:r.get('timestamp') or ''):
        thread=row['thread_id'];kind=row['tool']
        if kind=='prior_worker_activity':states.pop(thread,None)
        elif kind=='prior_publication':
            states[thread]=dict(row,completed=False)
            owned.setdefault(thread,set()).add(row['report_id'])
        elif kind=='prior_final' and thread in states:
            states[thread]['completed']=False
            references=set(row.get('report_ids',[]))|({row['report_id']} if row.get('report_id') else set())
            if states[thread]['report_id'] in references and references<=owned.get(thread,set()):
                states[thread].update(completed=True,timestamp=row.get('timestamp'))
    return [dict(timestamp=r.get('timestamp'),thread_id=t,parent_thread_id=r.get('parent_thread_id'),
                 role=r.get('role'),tool='native_assignment_snapshot',outcome='success',report_id=r['report_id'],
                 owned_report_ids=sorted(owned[t]))
            for t,r in states.items() if r.get('completed')]


def report_read_metadata(tool,arguments,wrapper=''):
    """Retain only a literal reference, optionally bound by one local constant."""
    if tool!='mcp__cortex__read_report':return {}
    match=re.search(r'(?:["\']report_id["\']|\breport_id)\s*:\s*(?:(["\'])(r_[0-9a-f]{12})\1|([A-Za-z_$][A-Za-z0-9_$]*))',arguments)
    if not match:return {}
    reference=match.group(2)
    if reference is None:
        bindings=re.findall(r'\bconst\s+'+re.escape(match.group(3))+r'\s*=\s*(["\'])(r_[0-9a-f]{12})\1',wrapper)
        if len(bindings)==1:reference=bindings[0][1]
    return {'requested_report_id':reference} if reference else {}


def event_call_candidate(candidates,event_time_ns,report_id=None,event=None):
    """Match a canonical call key before considering execution intervals."""
    def ns(stamp):
        try:
            value=datetime.fromisoformat(stamp.replace('Z','+00:00'))
            return int(value.timestamp())*1_000_000_000+value.microsecond*1_000
        except (AttributeError,ValueError):return None
    # When both sides expose a canonical semantic identity, it is the only
    # admissible correlation.  Do not let list insertion order or nearby clock
    # values replace an exact binding; duplicate matches are invalid evidence.
    if isinstance(event,dict):
        event_row=dict(event)
        operation=event_row.get('operation')
        if isinstance(operation,str) and operation:
            event_row['tool']='mcp__cortex__'+operation
        event_key=canonical_mcp_call_key(event_row)
        if event_key is not None:
            keyed=[candidate for candidate in candidates
                   if candidate.get('canonical_call_key')==event_key]
            if len(keyed)==1:
                return keyed[0]
            if operation=='read_report' and len(keyed)>1:
                # Pages share a report identity. Match only an unpaired exact-key
                # call whose observed interval contains this event; concurrent
                # or duplicate intervals remain ambiguous, never timing guesses.
                within=[]
                for candidate in keyed:
                    if candidate.get('server_observed'):continue
                    start=ns(candidate.get('timestamp'))
                    end=ns(candidate.get('completed_timestamp'))
                    if start is not None and end is not None and start<=event_time_ns<=end:
                        within.append(candidate)
                return within[0] if len(within)==1 else None
            # A server event that carries a semantic key cannot be attached to
            # a different receipt by timing alone.
            return None
    matches=[]
    for row in candidates:
        if row.get('server_observed') or row.get('outcome')=='not_dispatched':continue
        if report_id and row.get('requested_report_id') not in {None,report_id}:continue
        start=ns(row.get('timestamp'))
        ends=[n for n in (ns(row.get('host_receipt_timestamp')),ns(row.get('completed_timestamp'))) if n is not None]
        if start is not None and ends and start<=event_time_ns<=max(ends):matches.append(row)
    # Ambiguous concurrent candidates remain separate evidence; never guess.
    if len(matches)==1:return matches[0]
    if matches:return None

    # Millisecond host timestamps can fall just before or after the server's
    # nanosecond timestamp and therefore fall outside the host call's interval.
    # Join only an unpaired receipt with the same operation identity and outcome,
    # within that measured precision. A unique identity is required so an
    # unrelated same-tool call cannot hide a missing server event.
    if not isinstance(event,dict):return None
    def event_identity_match(candidate):
        if candidate.get('server_observed') or not candidate.get('host_receipt_observed'):
            return False
        if candidate.get('host_receipt_outcome')!=event.get('outcome', 'unverified'):
            return False
        receipt_ns=ns(candidate.get('host_receipt_timestamp'))
        if receipt_ns is None or abs(receipt_ns-event_time_ns)>1_000_000:
            return False
        if report_id and candidate.get('report_id') not in {None,report_id}:
            return False
        shared=[]
        # Server observations use result-oriented names for a few fields while
        # host arguments retain the request-oriented names.  Normalize those
        # pairs for the receipt-timestamp fallback.  In particular, a
        # read_report event's report_id is the requested report id; comparing it
        # to the candidate's requested_report_id prevents a false synthetic row
        # when the event falls just outside the host interval.
        identity_fields=(('template','template'),('draft_id','draft_id'),
                         ('report_id','report_id'),('report_id','requested_report_id'),
                         ('document_kind','document_kind'),('page','page'),
                         ('requested_limit','limit'),('cursor','cursor'))
        for event_key,candidate_key in identity_fields:
            event_value=event.get(event_key);candidate_value=candidate.get(candidate_key)
            if event_value is not None and candidate_value is not None:
                if event_value!=candidate_value:return False
                shared.append(candidate_key)
        return bool(shared)
    identity_matches=[row for row in candidates if event_identity_match(row)]
    return identity_matches[0] if len(identity_matches)==1 else None


def record_agent_activity(item,agent_paths,agent_path_phases,agent_path_duplicates):
    """Record one child/path lifecycle and reject repeated or conflicting proof."""
    if (not isinstance(item,dict) or item.get('type')!='SubAgentActivity'
            or item.get('kind') not in {'started','completed'}
            or not item.get('agent_path') or not item.get('agent_thread_id')):
        return
    path=item['agent_path'];child=item['agent_thread_id'];phase=item['kind']
    existing=agent_paths.get(path)
    phases=agent_path_phases.setdefault(path,set())
    if existing is None:
        agent_paths[path]=child
    elif existing!=child:
        agent_path_duplicates.add(path)
        return
    if phase in phases:
        # A second start or completion is a genuine duplicate, even when it
        # repeats the same child identity. Only the two lifecycle phases may
        # coalesce into one verified route.
        agent_path_duplicates.add(path)
        return
    phases.add(phase)


def native_spawn_route_metadata(row,agent_paths,edges,thread_details,calls,
                               ambiguities=None):
    """Correlate an opaque spawn with its actual child and complete skill read.

    Native activity paths and parent edges establish identity. Role names alone
    never link a worker. This proves the observed route, not encrypted prose.
    """
    if row.get('tool')!='spawn_agent' or row.get('outcome')!='success':return {}
    ambiguities=ambiguities or {}
    parent=row.get('thread_id');name=row.get('task_name')
    if not parent or not isinstance(name,str):return {}
    def unique_value(value):
        # A duplicate native receipt is not equivalent to one verified receipt.
        # Reject it rather than selecting an arbitrary value.
        if isinstance(value,(list,tuple,set,frozenset)):
            if len(value)!=1:return None
            return next(iter(value))
        return value
    parent_paths=[]
    for path,thread in agent_paths.items():
        if path in ambiguities.get('agent_paths',set()):return {}
        if unique_value(thread)==parent:parent_paths.append(path)
    if len(parent_paths)>1 or (not parent_paths and parent in edges):return {}
    parent_path=parent_paths[0] if parent_paths else '/root'
    child_path=parent_path+'/'+name
    if child_path in ambiguities.get('agent_paths',set()):return {}
    child=unique_value(agent_paths.get(child_path))
    if not child or child in ambiguities.get('edges',set()):return {}
    if unique_value(edges.get(child))!=parent:return {}
    detail=thread_details.get(child,{})
    profile=detail.get('agent_role')
    if not profile or assigned_worker_profile('$cortex:worker-'+profile.replace('_','-'))!=profile:return {}
    # Declared worker references (for example report-publication.md) are valid
    # instruction reads, but they are not a second worker-skill receipt. Count
    # only the complete advertised worker SKILL.md read when joining the native
    # route; otherwise normal progressive loading makes an otherwise verified
    # opaque assignment look ambiguous.
    skill_reads=[call for call in calls if call.get('thread_id')==child
                 and call.get('worker_skill_complete')
                 and call.get('worker_skill_profile')==profile]
    complete_reads=[call for call in skill_reads if call.get('worker_skill_complete')
                    and call.get('outcome') in {'success','covered_by_command_execution'}
                    and call.get('wrapper_outcome','success')=='success']
    if len(skill_reads)!=1 or len(complete_reads)!=1:return {}
    result=dict(spawned_thread_id=child,native_child_path_verified=True,
                validated_parent_edge=True,worker_skill_receipt='complete_success',
                observed_worker_profile=profile,
                observed_worker_model=detail.get('model'),
                observed_worker_effort=detail.get('reasoning_effort'),
                worker_route_evidence='native_child_and_complete_skill')
    if (row.get('assignment_content_unavailable') is True
            and row.get('requested_model') is None
            and row.get('requested_reasoning_effort') is None
            and result['observed_worker_model']==LIVE_MODEL
            and result['observed_worker_effort'] in LIVE_WORKER_EFFORTS):
        result['route_policy_provenance']='requested_route_unavailable_actual_route_verified'
    return result


def observed_tool_calls(state):
    """Return argument-free call metadata plus the observed wrapper outcome."""
    database=Path.home()/'.cortex-dev/.codex/state_5.sqlite'
    if not database.is_file():return []
    connection=sqlite3.connect(f'file:{database}?mode=ro',uri=True)
    connection.row_factory=sqlite3.Row
    try:
        threads=connection.execute(
            'SELECT id,rollout_path,agent_role,model,reasoning_effort,created_at '
            'FROM threads WHERE cwd=? AND created_at>=? ORDER BY created_at,id',
            (state['workdir'],int(state.get('thread_created_since',state.get('started_at',0)))-2),
        ).fetchall()
        edges={};edge_seen=set();edge_duplicates=set()
        for edge in connection.execute(
                'SELECT parent_thread_id,child_thread_id FROM thread_spawn_edges'):
            child=edge['child_thread_id']
            if child in edge_seen:edge_duplicates.add(child)
            else:
                edge_seen.add(child);edges[child]=edge['parent_thread_id']
    finally:connection.close()
    calls=[];cortex_calls={};agent_paths={};agent_path_duplicates=set();agent_path_phases={};prior_assignments=[];prior_followups={}

    pending={}
    pending_arguments={}
    thread_details={row['id']:dict(row) for row in threads}
    scope=task_thread_scope(state.get('thread_id'),thread_details,edges)
    thread_details={key:value for key,value in thread_details.items() if key in scope}
    edges={child:parent for child,parent in edges.items()
           if child in scope and parent in scope}
    for row in thread_details.values():
        if row['id'] not in edges:continue
        row['agent_role']=row['agent_role'] or 'worker'
        path=Path(row['rollout_path'])
        if not path.is_file():continue
        with path.open(encoding='utf-8') as source:
            for line in source:
                try:payload=json.loads(line).get('payload',{})
                except ValueError:continue
                # A native task explicitly named for a registered specialist is
                # observable even when its assignment body is encrypted. This
                # labels the access audit; it does not prove the hidden packet.
                native_path=payload.get('agent_path')
                if isinstance(native_path,str):
                    name=native_path.rsplit('/',1)[-1].replace('_','-')
                    profile=assigned_worker_profile('$cortex:worker-'+name)
                    if profile:row['agent_role']=profile
                if payload.get('type') in {'custom_tool_call','function_call'}:
                    match=re.search(r'/skills/worker-([a-z-]+)/SKILL.md',str(payload.get('input') or payload.get('arguments') or ''))
                    if match:
                        profile=assigned_worker_profile('$cortex:worker-'+match.group(1))
                        if profile:row['agent_role']=profile;break
                if (payload.get('type')=='message' and payload.get('role')=='user') or payload.get('type')=='agent_message':
                    profile=assigned_worker_profile(json.dumps(payload.get('content',[])))
                    if profile:row['agent_role']=profile;break
    threads=list(thread_details.values())
    for thread in threads:
        request_digests={state.get('original_request_sha256')}
        path=Path(thread['rollout_path'])
        if not path.is_file():continue
        with path.open(encoding='utf-8') as source:
            for line in source:
                try:entry=json.loads(line)
                except ValueError:continue
                payload=entry.get('payload',{})
                if not isinstance(payload,dict):continue
                item=payload.get('item') if payload.get('type')=='item_completed' else None
                record_agent_activity(item,agent_paths,agent_path_phases,agent_path_duplicates)
                if state.get('resumed'):
                    observed_at=datetime.fromisoformat(entry['timestamp'].replace('Z','+00:00')).timestamp()
                    if observed_at<state['started_at']:
                        common=dict(timestamp=entry['timestamp'],thread_id=thread['id'],
                                    parent_thread_id=edges.get(thread['id']),role=thread['agent_role'])
                        if payload.get('type')=='function_call' and payload.get('name')=='followup_task':
                            target=safe_call_metadata('followup_task',payload.get('arguments','')).get('target_agent')
                            parent_path=next((p for p,t in agent_paths.items() if t==thread['id']),'/root')
                            child=(target if target in thread_details else
                                   agent_paths.get(target if target and target.startswith('/') else parent_path+'/'+(target or '')))
                            if child and edges.get(child)==thread['id']:
                                prior_followups[payload.get('call_id')]=child
                        if payload.get('type')=='function_call_output':
                            child=prior_followups.pop(payload.get('call_id'),None)
                            if child and observed_outcome(payload.get('output',''),'followup_task')[0]=='success':
                                prior_assignments.append(dict(timestamp=entry['timestamp'],thread_id=child,tool='prior_worker_activity'))
                        if edges.get(thread['id']) and payload.get('type') in {'function_call','custom_tool_call'}:
                            prior_assignments.append(dict(common,tool='prior_worker_activity'))
                        receipt=mcp_receipt_metadata(item)
                        if (edges.get(thread['id']) and receipt and receipt['tool']=='mcp__cortex__write_report'
                                and receipt['host_receipt_outcome']=='success'):
                            report=((item.get('result') or {}).get('structuredContent') or {}).get('report_id')
                            if isinstance(report,str) and re.fullmatch(r'r_[0-9a-f]{12}',report):
                                prior_assignments.append(dict(common,tool='prior_publication',report_id=report))
                        result=native_agent_result_metadata(payload)
                        if result and result.get('outcome')=='success' and (result.get('report_id') or result.get('report_ids')):
                            child=agent_paths.get(result.get('agent_path'))
                            if child and edges.get(child)==thread['id']:
                                prior_assignments.append(dict(timestamp=entry['timestamp'],thread_id=child,
                                    tool='prior_final',report_ids=result.get('report_ids') or [result['report_id']]))
                        continue
                item=payload.get('item') if payload.get('type')=='item_completed' else None
                is_selected_root=(thread['id']==state.get('thread_id')
                                  or (not state.get('thread_id') and not edges.get(thread['id'])))
                # Keep audit request provenance on the same strict native-turn
                # decoder used by the submission helper.  In particular, the
                # current response_item/message envelope concatenates text
                # parts exactly; inserting separators here would turn a valid
                # multipart prompt into coordinator_original_request_changed.
                parsed_turn=_desktop_prompt_turn(entry,thread['id']) if is_selected_root else None
                delivered=parsed_turn[0] if parsed_turn is not None else None
                if delivered is not None and state.get('desktop_editor_source_sha256'):
                    request_digests.update(delivered_request_digests(state,delivered))
                if parsed_turn is not None and is_selected_root:
                    calls.append(dict(timestamp=entry.get('timestamp'),thread_id=thread['id'],
                                      parent_thread_id=None,role='coordinator',tool='native_user_input',
                                      outcome='success',argument_digest=None))
                if payload.get('type')=='agent_message':
                    result=native_agent_result_metadata(payload)
                    if result is not None:
                        author=result.get('agent_path')
                        child=agent_paths.get(author)
                        detail=thread_details.get(child)
                        lifecycle=dict(timestamp=entry.get('timestamp'),
                                       thread_id=child or thread['id'],
                                       parent_thread_id=thread['id'] if child else edges.get(thread['id']),
                                       role=(detail['agent_role'] if detail else None) or 'worker',
                                       model=detail['model'] if detail else None,
                                       reasoning_effort=detail['reasoning_effort'] if detail else None,
                                       tool='native_agent_result',
                                       argument_digest=hashlib.sha256(str(author).encode()).hexdigest()[:12],
                                       outcome=result['outcome'],agent_path=author)
                        for key in ('report_id','report_ids','error_code','native_worker_result',
                                    'native_worker_result_error'):
                            if key in result:lifecycle[key]=result[key]
                        calls.append(lifecycle)
                receipt=mcp_receipt_metadata(item)
                if receipt is not None:
                    arguments=item.get('arguments') or {}
                    encoded=json.dumps(arguments,sort_keys=True,separators=(',',':'))
                    row=next((candidate for candidate in reversed(calls)
                              if candidate.get('thread_id')==thread['id']
                              and (candidate.get('tool')==receipt['tool']
                                   or (candidate.get('tool_namespace','')+'__'+candidate.get('tool',''))==receipt['tool'])
                              and not candidate.get('host_receipt_observed')),None)
                    if row is None:
                        row=dict(timestamp=entry.get('timestamp'),thread_id=thread['id'],
                                 parent_thread_id=edges.get(thread['id']),
                                 role=thread['agent_role'] or 'coordinator',model=thread['model'],
                                 reasoning_effort=thread['reasoning_effort'],tool=receipt['tool'],
                                 argument_digest=hashlib.sha256(encoded.encode()).hexdigest()[:12])
                        calls.append(row)
                        if row['tool'].startswith('mcp__cortex__'):
                            row['server_observed']=False
                            cortex_calls.setdefault((thread['id'],row['tool'].rsplit('__',1)[-1]),[]).append(row)
                    receipt_tool=receipt['tool']
                    row.update({key:value for key,value in receipt.items() if key!='tool'})
                    row.update(mcp_argument_metadata(receipt['tool'],encoded))
                    if row.get('tool') is None:row['tool']=receipt_tool
                    if receipt['tool']=='mcp__cortex__create_task':
                        result=item.get('result') or {}
                        content=result.get('structuredContent') or {}
                        if state.get('original_request_sha256'):
                            captured=content.get('original_request_sha256')
                            # Historical observations used model-authored request bodies.
                            original=arguments.get('request')
                            source_digest=captured or (original_request_digest(original) if isinstance(original,str) else None)
                            row['original_request_preserved']=source_digest in request_digests
                            if row['original_request_preserved'] and source_digest!=state['original_request_sha256']:
                                row['desktop_editor_formatting_observed']=True
                        task_id=content.get('task_id')
                        if isinstance(task_id,str) and task_id:
                            row['task_id']=task_id
                    key=canonical_mcp_call_key(row)
                    if key is not None:
                        row['canonical_call_key']=key
                    row['host_receipt_observed']=True
                    row['result_receipt_observed']=True
                    row['host_receipt_timestamp']=entry.get('timestamp')
                    if row.get('outcome') in {None,'pending'}:row['outcome']=receipt['host_receipt_outcome']
                    if receipt.get('host_error_code'):row['error_code']=receipt['host_error_code']
                if isinstance(item,dict) and item.get('type')=='CommandExecution':
                    command=item.get('command') or []
                    rendered=' '.join(command) if isinstance(command,list) else str(command)
                    intent_source=(command[-1] if isinstance(command,list) and len(command)>=3
                                   and command[-2] in {'-c','-lc'} else rendered)
                    exit_code=item.get('exit_code')
                    status=item.get('status')
                    command_output=(item.get('aggregated_output') or '')+'\n'+(item.get('stderr') or '')
                    # CommandExecution already carries an authoritative status and
                    # exit code. Successful output may quote source text containing
                    # diagnostic words, so output is only a fallback when there is
                    # no exit code.
                    outcome,error_code=command_execution_outcome(status,exit_code,command_output)
                    row=dict(timestamp=entry.get('timestamp'),thread_id=thread['id'],
                             parent_thread_id=edges.get(thread['id']),role=thread['agent_role'] or 'coordinator',
                             model=thread['model'],reasoning_effort=thread['reasoning_effort'],
                             worker_skill_receipt_required=thread['agent_role'] is not None,
                             tool='command_execution',argument_digest=hashlib.sha256(rendered.encode()).hexdigest()[:12],
                             intent_digest=raw_command_intent_digest(intent_source),outcome=outcome,
                             source='host_command_execution')
                    named_failure=(failed_command_family(command_output)
                                   if isinstance(exit_code,int) and exit_code!=0 else None)
                    compound_failure=(verified_compound_failure_family(
                        intent_source,command_output,item.get('cwd'))
                        if isinstance(exit_code,int) and exit_code!=0 and named_failure is None else None)
                    family=named_failure or compound_failure
                    family=family or raw_command_family(intent_source)
                    if family:
                        row['command_family']=family
                        row['command_family_source']=(
                            'shell_command_not_found' if named_failure else
                            'verified_two_segment_and' if compound_failure else 'leading_command')
                    no_match=semantic_no_match_family(
                        intent_source,exit_code,item.get('aggregated_output') or '',
                        item.get('stderr') or '',item.get('cwd'))
                    if no_match:
                        row['semantic_result']='no_match'
                        row['semantic_nonfailure']=True
                    elif semantic_absent_path(intent_source,exit_code,
                                              item.get('aggregated_output'),item.get('stderr')):
                        row['semantic_result']='predicate_false'
                        row['semantic_nonfailure']=True
                    origin=local_http_origin(intent_source)
                    if origin:row['local_http_origin']=origin
                    if isinstance(exit_code,int):row['exit_code']=exit_code
                    if error_code:row['error_code']=error_code
                    calls.append(row)
                if payload.get('type') in {'function_call','custom_tool_call'}:
                    arguments=payload.get('arguments') or payload.get('input') or ''
                    if not isinstance(arguments,str):arguments=json.dumps(arguments,sort_keys=True,separators=(',',':'))
                    digest=hashlib.sha256(arguments.encode()).hexdigest()[:12]
                    common=dict(timestamp=entry.get('timestamp'),thread_id=thread['id'],
                                parent_thread_id=edges.get(thread['id']),role=thread['agent_role'] or 'coordinator',
                                model=thread['model'],reasoning_effort=thread['reasoning_effort'],
                                worker_skill_receipt_required=thread['agent_role'] is not None)
                    selected=[];nested=nested_tool_invocations(arguments) if payload.get('type')=='custom_tool_call' else []
                    if payload.get('type')=='custom_tool_call':
                        wrapper=dict(common,tool='functions.exec',argument_digest=digest,outcome='pending')
                        calls.append(wrapper);selected.append(wrapper)
                    for name,nested_digest,nested_arguments in nested:
                        if name.startswith('mcp__cortex__'):
                            row=dict(common,tool=name,argument_digest=nested_digest,
                                     wrapper_argument_digest=digest,outcome='pending',nested=True,
                                     server_observed=False)
                            if (name=='mcp__cortex__create_task'
                                    and direct_public_cortex_create_task(arguments,nested)):
                                row['direct_public_mcp']=True
                            row.update(mcp_argument_metadata(name,nested_arguments))
                            row.update(report_read_metadata(name,nested_arguments,arguments))
                            calls.append(row);selected.append(row)
                            cortex_calls.setdefault((thread['id'],name.rsplit('__',1)[-1]),[]).append(row)
                            continue
                        row=dict(common,tool=name,argument_digest=nested_digest,
                                 wrapper_argument_digest=digest,outcome='pending',nested=True)
                        row.update(draft_call_metadata(name,arguments))
                        if name=='js':
                            row.update(browser_call_metadata(nested_arguments))
                            row['browser_mutations']=browser_mutation_count(nested_arguments)
                        if name=='exec_command':
                            intent=command_intent_digest(nested_arguments)
                            if intent:row['intent_digest']=intent
                        row.update(path_policy_metadata(name,nested_arguments,common['role'],state['workdir']))
                        instruction_read=skill_instruction_read(
                            name,nested_arguments,worker_only=common['role'] not in {'coordinator','runtime'})
                        declared_read=declared_skill_instruction_read(
                            name,nested_arguments,worker_only=common['role'] not in {'coordinator','runtime'})
                        coordinator_instruction_read=(
                            common['role'] in {'coordinator','runtime'}
                            and skill_instruction_read(name,nested_arguments,coordinator_only=True))
                        flags=call_policy_flags(name,arguments if name=='apply_patch' else nested_arguments,common['role'],state['workdir'])
                        if instruction_read or declared_read:
                            row['skill_instruction_read']=True
                            row['declared_skill_read']=True
                            # Keep the non-secret registered leaf/profile marker
                            # even when the host denies the read before dispatch.
                            # This is needed to reconcile an exact worker read;
                            # it never creates a completion receipt by itself.
                            if common['role'] not in {'coordinator','runtime'}:
                                profile=worker_skill_profile(name,nested_arguments)
                                if profile:row['worker_skill_profile']=profile
                        if coordinator_instruction_read:row['pre_binding_static_read']=True
                        if (common['role']=='coordinator'
                                and active_coordinator_skill_read(name,nested_arguments)):
                            row['active_coordinator_skill_read']=True
                        if flags:row['policy_flags']=flags
                        calls.append(row);selected.append(row)
                    if not nested and payload.get('type')=='function_call':
                        row=dict(common,tool=payload.get('name','unknown'),argument_digest=digest,outcome='pending')
                        if payload.get('namespace'):row['tool_namespace']=payload['namespace']
                        row.update(safe_call_metadata(row['tool'],arguments))
                        row.update(report_read_metadata(row['tool'],arguments))
                        row.update(mcp_argument_metadata(row['tool'],arguments))
                        row.update(draft_call_metadata(row['tool'],arguments))
                        row.update(path_policy_metadata(row['tool'],arguments,common['role'],state['workdir']))
                        if row['tool']=='js':
                            row.update(browser_call_metadata(arguments))
                            row['browser_mutations']=browser_mutation_count(arguments)
                        flags=call_policy_flags(row['tool'],arguments,common['role'],state['workdir'])
                        if (skill_instruction_read(
                                row['tool'],arguments,
                                worker_only=common['role'] not in {'coordinator','runtime'})
                                or declared_skill_instruction_read(
                                    row['tool'],arguments,
                                    worker_only=common['role'] not in {'coordinator','runtime'})):
                            row['skill_instruction_read']=True
                            row['declared_skill_read']=True
                        if (common['role']=='coordinator'
                                and active_coordinator_skill_read(row['tool'],arguments)):
                            row['active_coordinator_skill_read']=True
                        if flags:row['policy_flags']=flags
                        calls.append(row);selected.append(row)
                        if row['tool'].startswith('mcp__cortex__'):
                            row['server_observed']=False
                            if row['tool']=='mcp__cortex__create_task':row['direct_public_mcp']=True
                            cortex_calls.setdefault((thread['id'],row['tool'].rsplit('__',1)[-1]),[]).append(row)
                    # A custom functions.exec wrapper may receive the exact
                    # current-host skill/declaration read as one nested command.
                    # Preserve the one-call/two-label accounting while allowing
                    # the pre-binding classifier to recognize only that same
                    # fully static observation.  Multiple nested members,
                    # generic wrappers, and anything without the exact parser
                    # proof remain blocked.
                    bounded_static_transport=bounded_static_read_transport(arguments,nested)
                    nested_static=[row for row in selected
                                   if row.get('nested') is True
                                   and (row.get('pre_binding_static_read') is True
                                        or row.get('worker_skill_profile') is not None)]
                    nested_operands=[row for row in selected if row.get('nested') is True]
                    if (bounded_static_transport and len(nested_static)==1
                            and len(nested_operands)==1):
                        nested_row=nested_static[0]
                        for row in selected:
                            row.setdefault('pre_binding_static_read',True)
                            row.setdefault('skill_instruction_read',True)
                            row.setdefault('bounded_wrapper',True)
                            row.setdefault('active_coordinator_skill_read',
                                           nested_row.get('active_coordinator_skill_read'))
                            row.setdefault('worker_skill_profile',
                                           nested_row.get('worker_skill_profile'))
                            for key in ('path_target_class','path_access_kind','path_policy_decision'):
                                row.setdefault(key,nested_row.get(key))
                    direct_bootstrap=[row for row in selected
                                      if row.get('tool')=='mcp__cortex__create_task'
                                      and row.get('direct_public_mcp') is True]
                    if len(direct_bootstrap)==1 and len(nested_operands)==1:
                        for row in selected:
                            if row.get('tool')=='functions.exec':
                                row['direct_public_mcp_transport']=True
                    if 'ALL_TOOLS' in arguments:
                        # A catalogue mention is not a wrapper permission.  We
                        # recognize only the exact current-host metadata
                        # envelope; all neighboring forms remain fail-closed.
                        catalogue=approved_tool_catalogue_envelope(arguments,nested)
                        row=dict(common,tool='tool_catalogue_search',argument_digest=digest,
                                 outcome='pending',nested=True,
                                 catalogue_discovery=catalogue,
                                 catalogue_value_free=catalogue,
                                 catalogue_bounded=catalogue,
                                 catalogue_project_free=catalogue,
                                 catalogue_private_free=catalogue,
                                 catalogue_mutation_free=catalogue,
                                 catalogue_mixed=not catalogue)
                        if catalogue:
                            for transport in selected:
                                transport.update({
                                    'catalogue_discovery':True,
                                    'catalogue_value_free':True,
                                    'catalogue_bounded':True,
                                    'catalogue_project_free':True,
                                    'catalogue_private_free':True,
                                    'catalogue_mutation_free':True,
                                    'catalogue_mixed':False,
                                })
                        calls.append(row);selected.append(row)
                    pending[payload.get('call_id')]=selected
                    pending_arguments[payload.get('call_id')]=arguments
                elif payload.get('type') in {'function_call_output','custom_tool_call_output'}:
                    selected=pending.pop(payload.get('call_id'),[])
                    arguments=pending_arguments.pop(payload.get('call_id'),'')
                    nested_rows=[row for row in selected if row.get('nested') and row['tool']!='tool_catalogue_search']
                    raw_output=payload.get('output','')
                    rendered_output=('\n'.join(str(item.get('text','')) if isinstance(item,dict) else str(item)
                                                for item in raw_output)
                                     if isinstance(raw_output,list) else str(raw_output))
                    wrapper_syntax_error=('Script error:' in rendered_output
                                          and 'SyntaxError:' in rendered_output)
                    cells=observed_cell_ids(payload.get('output',''))
                    for row in selected:
                        classify_tool=(nested_rows[0]['tool'] if row['tool']=='functions.exec' and len(nested_rows)==1
                                       else row['tool'] if len(nested_rows)<=1 else 'functions.exec')
                        outcome,code,result_digest=observed_outcome(payload.get('output',''),classify_tool,arguments)
                        if row.get('host_receipt_outcome')=='error':
                            outcome='error'
                            code=row.get('host_error_code') or code
                        # Preserve the underlying nested result before the
                        # wrapper accounting labels it covered_by_wrapper or
                        # covered_by_nested.  Skill completion is a receipt
                        # property of that one successful read, not of the
                        # transport's bookkeeping label.
                        observed_result_outcome=outcome
                        if wrapper_syntax_error and row.get('nested'):
                            row['outcome']='not_dispatched'
                            row['completed_timestamp']=entry.get('timestamp')
                            row['error_code']='wrapper_syntax_error'
                            row['result_digest']=result_digest
                            continue
                        if cells and (row['tool']=='functions.exec' or row.get('nested')):
                            row['cell_ids']=cells
                        if cells and row.get('nested'):
                            row['wrapper_outcome']=outcome
                            outcome='covered_by_wrapper'
                        elif (row['tool']=='functions.exec' and len(nested_rows)==1
                              and not wrapper_syntax_error):
                            row['wrapper_outcome']=outcome
                            outcome='covered_by_nested'
                        elif len(nested_rows)>1 and row.get('nested'):
                            row['wrapper_outcome']=outcome
                            outcome='covered_by_wrapper'
                        row['outcome']=outcome
                        row['completed_timestamp']=entry.get('timestamp')
                        row['result_digest']=result_digest
                        # The current-host functions.exec transport can retain
                        # its exact nested read as a covered wrapper rather
                        # than emit a second host receipt. Preserve only the
                        # already-classified bounded metadata so bootstrap
                        # ordering can distinguish it from a generic wrapper.
                        if (row.get('pre_binding_static_read') is True
                                and row.get('skill_instruction_read') is True
                                and row.get('bounded_wrapper') is True
                                and outcome in {'success','covered_by_nested'}):
                            row['bounded_metadata_observed']=True
                        if row.get('catalogue_discovery') is True:
                            row['host_receipt_observed']=(outcome in {'success','covered_by_command_execution'})
                            row['truncated']=safe_receipt_provenance(payload.get('output',''))[1]
                        exit_code,truncated=safe_receipt_provenance(payload.get('output',''))
                        if exit_code is not None:row['exit_code']=exit_code
                        if truncated:row['truncated']=True
                        worker_read=(row.get('worker_skill_profile') is not None
                                     or worker_skill_read(row['tool'],arguments))
                        if (row.get('skill_instruction_read') and row.get('role') not in {'coordinator','runtime',None}
                                and worker_read
                                and '<!-- END OF COMPLETE CORTEX WORKER SKILL -->' in rendered_output
                                and observed_result_outcome=='success'):
                            row['worker_skill_complete']=True
                            profile=worker_skill_profile(row['tool'],arguments)
                            if profile:row['worker_skill_profile']=profile
                            receipt=worker_skill_assignment_receipt(
                                thread['agent_role'],profile,row['worker_skill_complete'])
                            if receipt:row['worker_skill_assignment_receipt']=receipt
                        sessions=observed_session_ids(payload.get('output',''))
                        if sessions:row['session_ids']=sessions
                        if row['tool']=='write_stdin':
                            requested=requested_identifiers(arguments,'session_id',numeric=True)
                            if requested:row['requested_session_ids']=sorted(set(requested))
                        if row['tool']=='wait':
                            requested=requested_identifiers(arguments,'cell_id')
                            if requested:row['requested_cell_ids']=sorted(set(requested))
                        if code:row['error_code']=code
    for event in observed_events(state['events'],scope):
        operation=event.get('operation','unknown')
        thread_id=event.get('thread_id')
        detail=thread_details.get(thread_id)
        candidates=cortex_calls.get((thread_id,operation),[])
        row=event_call_candidate(candidates,event.get('time_ns',0),event.get('report_id'),event)
        if row is None:
            row=dict(timestamp_ns=event.get('time_ns',0),thread_id=thread_id,
                     parent_thread_id=event.get('parent_thread_id'),
                     role=(detail['agent_role'] or 'coordinator') if detail else 'runtime',
                     model=detail['model'] if detail else None,
                     reasoning_effort=detail['reasoning_effort'] if detail else None,
                     tool='mcp__cortex__'+operation,tool_namespace='mcp__cortex',
                     argument_digest=None)
            calls.append(row)
        else:
            row['host_outcome']=row.get('outcome')
            row['timestamp_ns']=event.get('time_ns',0)
            row.setdefault('tool_namespace','mcp__cortex')
        row['server_observed']=True
        row['server_event_observed']=True
        row['outcome']=event.get('outcome','unverified')
        row['replayed']=bool(event.get('replayed'))
        for key in ('document_kind','report_id','draft_id','page','template','requested_limit',
                    'summary_characters','source_revision','source_capture_status','task_id'):
            if key in event:row[key]=event[key]
        key=canonical_mcp_call_key(row)
        if key is not None:
            row['canonical_call_key']=key
        if event.get('error'):row['error_code']=event['error']
    def order(row):
        if row.get('timestamp_ns'):return row['timestamp_ns']
        stamp=row.get('timestamp') or ''
        try:return int(__import__('datetime').datetime.fromisoformat(stamp.replace('Z','+00:00')).timestamp()*1_000_000_000)
        except ValueError:return 0
    # Resolve routing only within this observed task tree. Never retain assignment
    # text or infer a target from a matching role/profile name.
    for row in calls:
        target=row.get('target_agent')
        if not target:continue
        parent=row.get('thread_id')
        parent_path=next((p for p,t in agent_paths.items() if t==parent),'/root')
        child=(target if target in thread_details else
               agent_paths.get(target if target.startswith('/') else parent_path+'/'+target))
        if child and edges.get(child)==parent:
            row['target_thread_id']=child
        if row.get('tool')=='followup_task' and row.get('completed_timestamp'):
            row['requested_timestamp']=row.get('timestamp')
            row['timestamp']=row['completed_timestamp']
    for row in calls:
        row.update(native_spawn_route_metadata(
            row,agent_paths,edges,thread_details,calls,
            {'agent_paths':agent_path_duplicates,'edges':edge_duplicates}))
    ordered=sorted(calls,key=order)
    cell_intents={};session_intents={}
    for row in ordered:
        if row.get('tool')=='exec_command' and row.get('intent_digest'):
            for cell_id in row.get('cell_ids',[]):
                cell_intents[(row.get('thread_id'),cell_id)]=row['intent_digest']
            for session_id in row.get('session_ids',[]):
                session_intents[(row.get('thread_id'),session_id)]=row['intent_digest']
        if row.get('tool')=='wait':
            intents={cell_intents.get((row.get('thread_id'),cell_id))
                     for cell_id in row.get('requested_cell_ids',[])}
            intents.discard(None)
            if len(intents)==1:
                row['intent_digest']=intents.pop()
                for session_id in row.get('session_ids',[]):
                    session_intents[(row.get('thread_id'),session_id)]=row['intent_digest']
        if row.get('tool')=='write_stdin':
            intents={session_intents.get((row.get('thread_id'),session_id))
                     for session_id in row.get('requested_session_ids',[])}
            intents.discard(None)
            if len(intents)==1:row['intent_digest']=intents.pop()
    execution_times={}
    for row in ordered:
        if row.get('tool')=='command_execution':
            execution_times.setdefault(row.get('thread_id'),[]).append(order(row))
    for row in ordered:
        if row.get('tool')!='exec_command' or not row.get('nested'):
            continue
        start=order(row)
        end=order({'timestamp':row.get('completed_timestamp')}) if row.get('completed_timestamp') else start
        covered=sum(start<=stamp<=end for stamp in execution_times.get(row.get('thread_id'),[]))
        if covered:
            row['covered_execution_count']=covered
            row['wrapper_outcome']=row.get('outcome')
            row['outcome']='covered_by_command_execution'
    for row in ordered:
        if row.get('tool')!='exec_command' or not row.get('nested'):continue
        start=order(row)
        end=order({'timestamp':row.get('completed_timestamp')}) if row.get('completed_timestamp') else start
        executions=[candidate for candidate in ordered
                    if candidate.get('tool')=='command_execution'
                    and candidate.get('thread_id')==row.get('thread_id')
                    and candidate.get('intent_digest')==row.get('intent_digest')
                    and start<=order(candidate)<=end]
        if len(executions)==1 and executions[0].get('semantic_nonfailure'):
            row['semantic_result']=executions[0]['semantic_result']
            row['semantic_nonfailure']=True
        if (len(executions)==1 and row.get('bounded_metadata_observed') is True
                and row.get('active_coordinator_skill_read') is True
                and executions[0].get('outcome')=='success'):
            # This is the native receipt of that same exact static read, not
            # a second pre-binding action. Identity and execution interval must
            # both match; ambiguous executions cannot inherit the proof.
            for key in ('pre_binding_static_read','skill_instruction_read',
                        'active_coordinator_skill_read','bounded_wrapper',
                        'bounded_metadata_observed','path_target_class',
                        'path_access_kind','path_policy_decision'):
                if key in row:executions[0][key]=row[key]
    semantic_no_match_wrappers={
        (row.get('thread_id'),row.get('wrapper_argument_digest'),row.get('timestamp')):row['semantic_result']
        for row in ordered if row.get('tool')=='exec_command'
        and row.get('semantic_nonfailure') and row.get('wrapper_argument_digest')
    }
    for row in ordered:
        if (row.get('tool')=='functions.exec'
                and (row.get('thread_id'),row.get('argument_digest'),row.get('timestamp'))
                in semantic_no_match_wrappers):
            row['semantic_result']=semantic_no_match_wrappers[
                (row.get('thread_id'),row.get('argument_digest'),row.get('timestamp'))]
            row['semantic_nonfailure']=True
    return completed_assignment_snapshots(prior_assignments)+ordered


def open_command_sessions(rows):
    opened=set();closed=set()
    for row in rows:
        if row.get('tool')=='exec_command' and row.get('outcome')=='running':
            opened.update(row.get('session_ids',[]))
        if row.get('tool')=='write_stdin' and row.get('outcome') in {'success','stopped','error'}:
            closed.update(row.get('requested_session_ids',[]))
    return sorted(opened-closed)


def open_exec_cells(rows):
    opened=set();closed=set()
    for row in rows:
        if row.get('tool')=='functions.exec' and row.get('outcome')=='running':
            opened.update(row.get('cell_ids',[]))
        if row.get('tool')=='wait' and row.get('outcome') in {'success','stopped','error'}:
            closed.update(row.get('requested_cell_ids',[]))
    return sorted(opened-closed)


def classify_host_failures(rows):
    """Keep every failure visible while recognizing explicit later corrections."""
    terminal_sessions=set();terminal_intents=set()
    wrapper_error_intents={}
    for row in rows:
        if row.get('tool')=='write_stdin' and row.get('outcome') in {'success','stopped'}:
            terminal_sessions.update(row.get('requested_session_ids',[]))
            if row.get('intent_digest'):
                terminal_intents.add((row.get('parent_thread_id') or row.get('thread_id'),row['intent_digest']))
        receipt_outcome=(row.get('wrapper_outcome')
                         if row.get('wrapper_outcome') in {'error','truncated','unverified','pending'}
                         else row.get('outcome'))
        if (row.get('result_digest') and row.get('intent_digest')
                and receipt_outcome=='error'):
            wrapper_error_intents[(row.get('thread_id'),row['result_digest'])]=row['intent_digest']
    later_success=set();later_family_success=set();later_tool_success=set();unresolved=[];resolved=[]
    for row in reversed(rows):
        # functions.exec is a transport wrapper around the nested exec_command
        # receipt. Its wrapper error is duplicate evidence when the nested host
        # command is already recorded and classified below.
        if (row.get('tool')=='functions.exec' and row.get('outcome')=='covered_by_nested'
                and row.get('wrapper_outcome') in {'error','truncated','unverified','pending'}
                and any(candidate.get('thread_id')==row.get('thread_id')
                        and candidate.get('tool')=='exec_command'
                        and candidate.get('result_digest')==row.get('result_digest')
                        for candidate in rows)):
            continue
        effective_outcome=row.get('outcome')
        # Covered wrapper rows remain useful for correlation, but their own transport
        # status must never disappear.  A nested call or host command succeeding does
        # not make a truncated/error wrapper response complete for the model.
        wrapper_outcome=row.get('wrapper_outcome')
        if wrapper_outcome in {'error','truncated','unverified','pending'}:
            effective_outcome=wrapper_outcome
        elif effective_outcome in {'covered_by_nested','covered_by_wrapper','covered_by_command_execution'}:
            continue
        digest=row.get('intent_digest') if row.get('tool') in {'exec_command','command_execution','write_stdin','wait'} else None
        if (not digest and row.get('tool')=='functions.exec'
                and effective_outcome=='error'):
            digest=wrapper_error_intents.get((row.get('thread_id'),row.get('result_digest')))
        family='command' if digest else row.get('tool')
        task_thread=row.get('parent_thread_id') or row.get('thread_id')
        key=(task_thread,family,digest or row.get('argument_digest'))
        family_key=(row.get('thread_id'),row.get('command_family')) if row.get('command_family') else None
        if effective_outcome in {'success','stopped'}:
            later_success.add(key)
            if family_key:later_family_success.add(family_key)
            if (isinstance(row.get('tool'),str)
                    and (row['tool'].startswith('mcp__')
                         or str(row.get('tool_namespace','')).startswith('mcp__'))):
                later_tool_success.add((row.get('thread_id'),row['tool']))
        elif (row.get('tool')=='exec_command' and effective_outcome=='running'
              and terminal_sessions.intersection(row.get('session_ids',[]))):
            later_success.add(key)
        elif effective_outcome in {'error','truncated','unverified','pending'}:
            if row.get('semantic_nonfailure') and row.get('semantic_result') in {'no_match','predicate_false'}:
                continue
            failure_row=dict(row)
            if effective_outcome!=row.get('outcome'):
                failure_row['effective_outcome']=effective_outcome
            intentionally_stopped=(family=='command' and (task_thread,digest) in terminal_intents)
            corrected_family=(row.get('error_code')=='command_exit_127'
                              and family_key in later_family_success if family_key else False)
            corrected_tool=(row.get('thread_id'),row.get('tool')) in later_tool_success
            if key in later_success or intentionally_stopped or corrected_family or corrected_tool:
                reason=('later_exact_success' if key in later_success else
                        'later_command_family_success' if corrected_family else
                        'later_same_tool_success' if corrected_tool else 'intentional_stop')
                resolved.append(dict(failure_row,resolution=reason))
            else:unresolved.append(failure_row)
    return list(reversed(unresolved)),list(reversed(resolved))


def tool_error_history(rows):
    """Keep a safe, chronological record of every observed tool error."""
    _,resolved=classify_host_failures(rows)
    intentional_stops={
        (row.get('timestamp'),row.get('thread_id'),row.get('tool'),row.get('argument_digest'))
        for row in resolved if row.get('resolution')=='intentional_stop'
    }
    history=[]
    for row in rows:
        outcome=row.get('wrapper_outcome') if row.get('wrapper_outcome')=='error' else row.get('outcome')
        if outcome!='error':continue
        if row.get('semantic_nonfailure') and row.get('semantic_result') in {'no_match','predicate_false'}:continue
        identity=(row.get('timestamp'),row.get('thread_id'),row.get('tool'),row.get('argument_digest'))
        if identity in intentional_stops:continue
        history.append({key:row.get(key) for key in (
            'timestamp','timestamp_ns','thread_id','parent_thread_id','role','tool',
            'error_code','argument_digest','result_digest','host_status',
        ) if row.get(key) is not None})
    return history


COORDINATION_TOOLS={'spawn_agent','wait_agent','send_message','followup_task',
                    'send_message_to_thread','mcp__codex_app__send_message_to_thread',
                    'list_agents','interrupt_agent'}


def canonical_tool_name(row):
    """Canonicalize a namespaced host tool without broadening its identity."""
    tool=str(row.get('tool',''))
    namespace=str(row.get('tool_namespace',''))
    if namespace.startswith('mcp__') and tool and not tool.startswith('mcp__'):
        return namespace+'__'+tool
    return tool


def is_cortex_mcp_tool(row):
    """Return whether a row is an invocation of Cortex's own MCP server."""
    tool=canonical_tool_name(row)
    namespace=str(row.get('tool_namespace',''))
    return tool.startswith('mcp__cortex__') or namespace=='mcp__cortex'


def is_orchestration_call(row):
    """Separate Cortex coordination from the delegated project's own tooling."""
    tool=str(row.get('tool',''))
    if row.get('role')=='coordinator':return True
    return (is_cortex_mcp_tool(row) or tool in {'tool_catalogue_search','native_agent_result'}
            or tool in COORDINATION_TOOLS or bool(row.get('cortex_draft_edit'))
            or bool(row.get('skill_instruction_read')))


def orchestration_error_history(rows):
    """Return real tool errors that belong to orchestration itself."""
    orchestration_ids={
        (row.get('timestamp'),row.get('thread_id'),row.get('tool'),row.get('argument_digest'))
        for row in rows if is_orchestration_call(row)
    }
    return [row for row in tool_error_history(rows)
            if (row.get('timestamp'),row.get('thread_id'),row.get('tool'),row.get('argument_digest'))
            in orchestration_ids]


def orchestration_policy_violations(violations):
    """Keep policy findings about delegation, reports, pipeline and Cortex state."""
    prefixes=('coordinator_','worker_final_','cortex_','complex_planning_')
    exact={'forbidden_cortex_draft_deletion',
           'command_wrapper_missing_receipt',
           'forbidden_worker_app_thread_message',
           'senior_consultant_forbidden_project_access',
           'senior_consultant_forbidden_cortex_tool',
           'senior_consultant_report_catalogue_access',
           'senior_consultant_invalid_report_selection',
           'live_model_policy_violation',
           'worker_model_policy_violation',
           'worker_assignment_policy_unverified',
           'worker_tool_after_successful_write_report','worker_draft_created_with_open_command_session',
           'worker_report_published_with_open_command_session'}
    result=[]
    for row in violations:
        violation=row.get('violation')
        # Generic path-policy flags are worker findings. Only a positively
        # classified unauthorized target is acceptance-critical; missing or
        # legacy metadata cannot be treated as proof of orchestration failure.
        cortex_mcp_error=(str(violation).startswith('mcp_') and is_cortex_mcp_tool(row))
        path_unauthorized=(violation=='forbidden_plugin_or_cache_access'
                           and row.get('path_policy_decision')=='unauthorized_access')
        if (violation not in ADVISORY_POLICY_FLAGS
                and (violation in exact or str(violation).startswith(prefixes)
                     or cortex_mcp_error or path_unauthorized)):
            result.append(row)
    return result


def worker_policy_violations(violations):
    """Return worker/path diagnostics retained outside orchestration gates."""
    return [row for row in violations
            if row.get('violation')=='forbidden_plugin_or_cache_access'
            or row.get('path_policy_decision') in {'diagnostic_only','unauthorized_access'}]


AUDIT_CLASSIFICATION_SCHEMA='cortex-evidence-quality-classification-v1'
INCOMPLETE_OUTCOMES={'truncated','unverified','pending','not_dispatched'}
DESKTOP_CURRENT_HOST_ROUTE='current_host_desktop'


def desktop_supported_outcome_receipt(rows, state, *, open_sessions, open_cells):
    """Bind the bounded evidence the current Desktop host can actually emit.

    Desktop has a durable submitted root and observable child activity, but does
    not currently expose an authenticated assignment packet, terminal native
    result, or worker-owned report receipt.  This is not a substitute for those
    receipts on another route.  In this route only, a caller must have committed
    the expected artifact identity before submission; the final audit verifies
    the exact leaf below the isolated workdir rather than trusting a worker
    assertion or an inferred report ID.
    """
    if not isinstance(state,dict) or state.get('qualification_route') != DESKTOP_CURRENT_HOST_ROUTE:
        return None,'not_current_host_desktop_route'
    expected=state.get('desktop_expected_artifact')
    if not (isinstance(expected,dict) and set(expected)=={'path','sha256'}
            and isinstance(expected.get('path'),str)
            and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}',expected['path'])
            and isinstance(expected.get('sha256'),str)
            and re.fullmatch(r'[0-9a-f]{64}',expected['sha256'])):
        return None,'desktop_expected_artifact_missing'
    workdir=Path(state.get('workdir',''))
    try:
        root=workdir.resolve(strict=True)
        leaf=root/expected['path']
        if leaf.is_symlink():return None,'desktop_expected_artifact_missing'
        artifact=leaf.resolve(strict=True)
    except (OSError,ValueError):
        return None,'desktop_expected_artifact_missing'
    if artifact.parent!=root or not artifact.is_file() or artifact.is_symlink():
        return None,'desktop_expected_artifact_missing'
    if hashlib.sha256(artifact.read_bytes()).hexdigest()!=expected['sha256']:
        return None,'desktop_expected_artifact_mismatch'
    if state.get('desktop_transport_receipt')!='success':
        return None,'desktop_transport_receipt_missing'
    if open_sessions or open_cells:
        return None,'desktop_open_work_remaining'
    if any(row.get('truncated') is True or row.get('replayed') is True
           or row.get('replay_marker') is True for row in rows if isinstance(row,dict)):
        return None,'desktop_capture_integrity_invalid'
    if any((row.get('mutation_observed') is True
            or row.get('private_target_access') is True
            or row.get('project_target_access') is True
            or row.get('path_policy_decision')=='unauthorized_access'
            or row.get('path_target_class') in {'plugin','plugin_cache','cache','candidate','registry','internal'})
           for row in rows if isinstance(row,dict)):
        return None,'desktop_unsafe_access_observed'
    roots={row.get('thread_id') for row in rows if isinstance(row,dict)
           and row.get('role')=='coordinator' and row.get('parent_thread_id') is None
           and isinstance(row.get('thread_id'),str) and row.get('thread_id')}
    expected_root=state.get('thread_id')
    if roots!={expected_root}:
        return None,'desktop_root_missing_or_ambiguous'
    creates=[row for row in rows if isinstance(row,dict)
             and row.get('thread_id')==expected_root
             and row.get('tool')=='mcp__cortex__create_task'
             and row.get('direct_public_mcp') is True
             and row.get('outcome')=='success'
             and row.get('host_receipt_observed') is True
             and row.get('host_receipt_outcome')=='success'
             and row.get('replayed') is not True and row.get('truncated') is not True]
    if len(creates)!=1:return None,'desktop_task_missing_or_ambiguous'
    workers={row.get('thread_id') for row in rows if isinstance(row,dict)
             and row.get('parent_thread_id')==expected_root
             and isinstance(row.get('thread_id'),str) and row.get('thread_id')}
    if len(workers)!=1:return None,'desktop_worker_missing_or_ambiguous'
    reports=[row for row in rows if isinstance(row,dict)
             and row.get('thread_id')==expected_root
             and row.get('tool')=='mcp__cortex__write_report'
             and row.get('outcome')=='success'
             and row.get('host_receipt_observed') is True
             and row.get('host_receipt_outcome')=='success'
             and isinstance(row.get('report_id'),str)
             and row.get('replayed') is not True and row.get('truncated') is not True]
    if not reports:return None,'desktop_coordinator_report_missing_or_ambiguous'
    if len(reports)>1:
        # A newest-first pipeline keeps one report identity across editions.
        # Distinct successful drafts prove new publications, not a replay of
        # the initial receipt. The final edition must follow worker activity.
        drafts=[row.get('draft_id') for row in reports]
        if (len({row['report_id'] for row in reports})!=1
                or any(not isinstance(draft,str) or not draft for draft in drafts)
                or len(set(drafts))!=len(drafts)
                or rows.index(reports[-1])<=max(
                    index for index,row in enumerate(rows)
                    if row.get('thread_id') in workers)):
            return None,'desktop_coordinator_report_missing_or_ambiguous'
    return {'status':'complete','thread_id':expected_root,'worker_thread_id':workers.pop(),
            'report_id':reports[-1]['report_id'],'artifact_path':expected['path'],
            'artifact_sha256':expected['sha256'],'host_enforcement_state':'unverified'},None


def desktop_current_host_partition(rows, state, host_failures, policy_violations,
                                 *, open_sessions, open_cells):
    """Keep only historically resolved Desktop gaps out of the final blocker set."""
    outcome,reason=desktop_supported_outcome_receipt(
        rows,state,open_sessions=open_sessions,open_cells=open_cells)
    if outcome is None:
        return list(host_failures),list(policy_violations),[],None,reason
    worker=outcome['worker_thread_id']
    diagnostics=[]
    def diagnostic(row,reason):
        diagnostics.append({**row,'observational_diagnostic':True,'not_applicable':True,
                            'host_enforcement_state':'unverified','diagnostic_reason':reason})
    retained_host=[]
    for row in host_failures:
        # A completed later outcome resolves a polling snapshot, not a pending
        # worker/session/cell at the final observation.
        if row.get('tool')=='wait_agent' and row.get('outcome')=='pending':
            diagnostic(row,'historical_wait_resolved_by_final_desktop_outcome');continue
        # Failed precondition checks may be retained only when they are the
        # observed worker wc/truncate attempts, stayed inside the workdir, and
        # the separately committed artifact bytes now match exactly.
        if (row.get('thread_id')==worker and row.get('tool') in {'exec_command','command_execution'}
                and row.get('error_code')=='command_exit_1'
                and row.get('command_family') in {'wc','truncate'}
                and row.get('mutation_observed') is not True
                and row.get('private_target_access') is not True
                and row.get('project_target_access') is not True
                and row.get('truncated') is not True and row.get('replayed') is not True):
            diagnostic(row,'historical_artifact_check_superseded_by_exact_final_hash');continue
        if observational_worker_skill_read_failure_diagnostic(
                rows,row,state,proven_outcome=outcome):
            diagnostic(row,'failed_safe_declared_resource_read');continue
        retained_host.append(row)
    retained_policy=[]
    for row in policy_violations:
        name=row.get('violation')
        if name=='worker_assignment_policy_unverified':
            diagnostic(row,'unsupported_current_host_assignment_policy');continue
        if name=='worker_skill_load_failed' and any(
                observational_worker_skill_read_failure_diagnostic(
                    rows,item,state,proven_outcome=outcome)
                and item.get('thread_id')==row.get('thread_id')
                and item.get('result_digest')==row.get('result_digest')
                for item in rows):
            diagnostic(row,'failed_safe_declared_resource_read');continue
        retained_policy.append(row)
    return retained_host,retained_policy,diagnostics,outcome,None


def desktop_final_acceptance(outcome, classification, participants):
    """Evidence quality and native lifecycle completion are separate requirements."""
    return (outcome is not None and classification.get('evidence_valid') is True
            and classification.get('score_eligible') is True
            and not classification.get('evidence_integrity_invalidators')
            and not any(row.get('classification')=='product_quality_outcome'
                        for row in classification.get('quality_findings',[]))
            and bool(participants)
            and all(row.get('terminal') is True for row in participants))


def classify_audit_findings(*,failures,hook_failures,host_failures,policy_violations,
                            open_sessions,open_cells,foreign_task_roots=None,
                            invalid_task_topology=None):
    """Separate evidence admissibility from fully observed quality outcomes."""
    invalidators=[];quality=[]
    safe_keys=('timestamp','thread_id','parent_thread_id','role','tool','operation',
               'violation','outcome','effective_outcome','wrapper_outcome',
               'host_status','error_code','error_class','error_stage','argument_digest','result_digest',
               'path_policy_decision','content_delivery_status','authorization_outcome',
               'authorization_capability','authorization_reason','execution_status',
               'host_dispatch_decision','host_dispatch_execution')
    def add(target,source,index,row,classification,reason):
        item={'source':source,'index':index,'classification':classification,'reason':reason}
        if isinstance(row,dict):
            item.update({key:row.get(key) for key in safe_keys if row.get(key) is not None})
        target.append(item)
    def incomplete(row):
        return any(row.get(key) in INCOMPLETE_OUTCOMES
                   for key in ('outcome','effective_outcome','wrapper_outcome'))
    def prevented_before_dispatch(row):
        return (row.get('hook_event') == 'PreToolUse'
                and row.get('action_status') == 'denied'
                and row.get('authorization_outcome') == 'PERMISSION_DENIED'
                and row.get('execution_status') == 'denied_before_dispatch'
                and isinstance(row.get('task_id'),str) and bool(row['task_id'])
                and isinstance(row.get('thread_id'),str) and bool(row['thread_id'])
                and isinstance(row.get('role'),str) and bool(row['role'])
                and row.get('binding_confidence') == 'receipt'
                and row.get('binding_origin') in {'native_hook','native_mcp'}
                and isinstance(row.get('authorization_capability'),str)
                and bool(row['authorization_capability'])
                and isinstance(row.get('authorization_reason'),str)
                and bool(row['authorization_reason']))
    def claimed_pre_dispatch_denial(row):
        return (row.get('hook_event') == 'PreToolUse'
                and row.get('action_status') == 'denied'
                and row.get('authorization_outcome') == 'PERMISSION_DENIED')
    for source,rows in (('mcp_failure',failures),('host_failure',host_failures)):
        for index,row in enumerate(rows):
            if incomplete(row):
                add(invalidators,source,index,row,'unknown_due_to_incomplete_evidence','truncated_or_unverified_observation')
            elif not isinstance(row.get('thread_id'),str) or not row.get('thread_id'):
                add(invalidators,source,index,row,'evidence_integrity_invalidator','unbound_observation')
            else:
                add(quality,source,index,row,'product_quality_outcome','complete_attributable_failure')
    for index,row in enumerate(hook_failures):
        if prevented_before_dispatch(row):
            # The hook observed and stopped the operation.  It is not a failed
            # receipt and never proves host execution or accepted evidence.
            add(quality,'hook_prevented_attempt',index,row,
                'prevented_attempt_diagnostic','authorization_denied_before_dispatch')
        elif claimed_pre_dispatch_denial(row):
            # A partial semantic denial receipt cannot establish that dispatch
            # was prevented.  Keep it visible but make the audit fail closed.
            add(invalidators,'hook_prevented_attempt',index,row,
                'evidence_integrity_invalidator','pre_dispatch_denial_receipt_incomplete')
        else:
            add(invalidators,'hook_failure',index,row,'evidence_integrity_invalidator','observation_hook_failed')
    rejected={'rejected','none','no_content','blocked_before_delivery'}
    delivered={'delivered','returned','protected_content_returned','arm_specific_content_returned'}
    for index,row in enumerate(policy_violations):
        violation=row.get('violation')
        if violation=='pre_binding_host_action' or str(violation).startswith('mcp_first_bootstrap_'):
            add(invalidators,'policy_violation',index,row,
                'evidence_integrity_invalidator','mcp_first_bootstrap_unverified')
            continue
        if violation=='host_dispatch_bypass':
            add(invalidators,'policy_violation',index,row,
                'evidence_integrity_invalidator','host_pre_dispatch_bypassed')
            continue
        if violation in {'task_source_revision_invalid','task_source_revision_nonmonotonic'}:
            add(invalidators,'policy_violation',index,row,
                'evidence_integrity_invalidator','task_local_source_revision_invalid')
            continue
        if incomplete(row) or violation=='worker_assignment_policy_unverified':
            reason=('unverified_worker_assignment' if violation=='worker_assignment_policy_unverified'
                    else 'truncated_or_unverified_policy_observation')
            add(invalidators,'policy_violation',index,row,'unknown_due_to_incomplete_evidence',reason)
            continue
        if violation=='forbidden_plugin_or_cache_access':
            delivery=row.get('content_delivery_status')
            if delivery in rejected:
                add(quality,'policy_violation',index,row,'product_quality_outcome','rejected_forbidden_access')
            elif delivery in delivered:
                add(invalidators,'policy_violation',index,row,'protocol_contamination','protected_or_arm_specific_content_delivered')
            else:
                add(invalidators,'policy_violation',index,row,'unknown_due_to_incomplete_evidence','forbidden_access_delivery_unverified')
            continue
        if not isinstance(row.get('thread_id'),str) or not row.get('thread_id'):
            add(invalidators,'policy_violation',index,row,'evidence_integrity_invalidator','unbound_policy_observation')
        else:
            add(quality,'policy_violation',index,row,'product_quality_outcome','complete_attributable_policy_failure')
    for source,rows in (('open_session',open_sessions),('open_cell',open_cells),
                        ('foreign_task_root',foreign_task_roots or []),
                        ('invalid_task_topology',invalid_task_topology or [])):
        for index,row in enumerate(rows):
            add(invalidators,source,index,row if isinstance(row,dict) else {},
                'evidence_integrity_invalidator','nonterminal_ambiguous_or_foreign_topology')
    return {'schema_version':AUDIT_CLASSIFICATION_SCHEMA,
            'evidence_valid':not invalidators,'score_eligible':not invalidators,
            'evidence_integrity_invalidators':invalidators,'quality_findings':quality}


def native_worker_result_fallback_violations(rows):
    """Validate the observational native-worker fallback without inventing trust.

    A worker result is model-supplied evidence.  It becomes usable only when one
    native spawn, terminal wait, parent task receipt, profile, and assignment
    digest agree exactly and the coordinator subsequently publishes the fixed
    delegation-evidence report label.  Artifact hashes remain asserted fields.
    """
    findings=[]
    results=[row for row in rows if row.get('tool')=='native_agent_result'
             and ('native_worker_result' in row or 'native_worker_result_error' in row)]
    for index,row in enumerate(results):
        body=row.get('native_worker_result')
        if body is None:
            findings.append({'index':index,'thread_id':row.get('thread_id'),'role':row.get('role'),
                             'tool':'native_agent_result','violation':row.get('native_worker_result_error',
                             'native_worker_result_schema_invalid')})
            continue
        if body.get('worker_mcp')!='unavailable':
            continue
        worker=row.get('thread_id');parent=row.get('parent_thread_id')
        def fail(code):
            findings.append({'index':index,'thread_id':worker,'role':row.get('role'),
                             'tool':'native_agent_result','violation':code,
                             'result_digest':body.get('result_digest')})
        if (row.get('outcome')!='success' or body.get('status')!='success'
                or body.get('worker_thread_id')!=worker or body.get('parent_thread_id')!=parent
                or body.get('profile')!=row.get('role') or row.get('truncated') is True
                or row.get('replayed') is True or row.get('replay_marker') is True):
            fail('native_worker_result_correlation_invalid');continue
        duplicates=[candidate for candidate in results
                    if candidate.get('thread_id')==worker
                    and candidate.get('native_worker_result',{}).get('worker_mcp')=='unavailable']
        if len(duplicates)!=1:
            fail('native_worker_result_duplicate');continue
        spawn=[candidate for candidate in rows if candidate.get('tool')=='spawn_agent'
               and candidate.get('thread_id')==parent and candidate.get('outcome')=='success'
               and candidate.get('spawned_thread_id')==worker]
        if len(spawn)!=1 or spawn[0].get('assigned_profile') not in {None,body.get('profile')}:
            fail('native_worker_result_spawn_mismatch');continue
        assignment=spawn[0].get('assignment_digest')
        if not isinstance(assignment,str) or assignment!=body.get('assignment_digest'):
            fail('native_worker_result_assignment_mismatch');continue
        waits=[candidate for candidate in rows if candidate.get('tool')=='wait_agent'
               and candidate.get('thread_id')==parent and candidate.get('outcome')=='success'
               and candidate.get('wait_target_thread_ids')==[worker]]
        if len(waits)!=1:
            fail('native_worker_result_wait_mismatch');continue
        tasks=[candidate for candidate in rows if candidate.get('tool')=='mcp__cortex__create_task'
               and candidate.get('thread_id')==parent and candidate.get('outcome')=='success'
               and candidate.get('task_id')==body.get('task_id')]
        if len(tasks)!=1:
            fail('native_worker_result_task_mismatch');continue
        reports=[candidate for candidate in rows if candidate.get('tool')=='mcp__cortex__write_report'
                 and candidate.get('thread_id')==parent and candidate.get('role')=='coordinator'
                 and candidate.get('outcome')=='success'
                 and candidate.get('delegation_evidence_report') is True]
        if len(reports)!=1:
            fail('native_worker_result_delegation_evidence_missing');continue
        row['worker_mcp_unavailable']=True
        row['artifact_hashes']='asserted'
        row['host_enforcement_state']='unverified'
        row['delegation_evidence_report_id']=reports[0].get('report_id')
    return findings


def current_host_outcome_receipt(rows, state):
    """Bind a completed interactive workload without claiming host enforcement.

    This is intentionally stricter than a product artifact alone: one direct
    bootstrap, one terminal native worker, one task-bound worker publication,
    and one coordinator public report-read must agree on the worker's declared
    artifact hashes.  It returns only bounded identity fields and a reason for
    the first missing/ambiguous link.
    """
    if not isinstance(state,dict) or state.get('bootstrap_route')!=MCP_FIRST_BOOTSTRAP_ROUTE:
        return None,'not_current_host_route'
    if any(row.get('outcome') in INCOMPLETE_OUTCOMES
           or row.get('wrapper_outcome') in INCOMPLETE_OUTCOMES for row in rows):
        return None,'outcome_pending_or_incomplete_call'
    expected=state.get('bootstrap_expected_child_thread_id')
    if not isinstance(expected,str) or not expected:
        return None,'outcome_expected_root_missing'
    creates=[row for row in rows if row.get('tool')=='mcp__cortex__create_task'
             and row.get('direct_public_mcp') is True and row.get('outcome')=='success'
             and row.get('host_receipt_outcome')=='success' and row.get('host_receipt_observed') is True
             and row.get('replayed') is not True and row.get('truncated') is not True]
    if len(creates)!=1:return None,'outcome_create_task_missing_or_ambiguous'
    create=creates[0]
    create_index=next(index for index,item in enumerate(rows) if item is create)
    root=create.get('thread_id');task=create.get('task_id')
    if (not isinstance(root,str) or create.get('parent_thread_id') is not None or root!=expected
            or (task is not None and (not isinstance(task,str) or not task))):
        return None,'outcome_create_task_binding_mismatch'
    # Replay-marked native finals are evidence of a second delivery, even when
    # a valid final is also present.  Do not filter them out before the
    # cardinality checks: an otherwise complete lifecycle must remain
    # ambiguous rather than accepting a replayed worker result.
    replayed_worker_finals=[row for row in rows
                            if row.get('tool')=='native_agent_result'
                            and row.get('parent_thread_id')==root
                            and (row.get('replayed') is True or row.get('replay_marker') is True)]
    if replayed_worker_finals:
        return None,'outcome_native_worker_missing_or_ambiguous'
    worker_rows=[(index,row) for index,row in enumerate(rows)
                 if row.get('tool')=='native_agent_result'
                 and row.get('outcome')=='success' and row.get('parent_thread_id')==root
                 and row.get('truncated') is not True and row.get('replayed') is not True
                 and row.get('replay_marker') is not True]
    workers=[row for _,row in worker_rows]
    # A native worker can receive a genuine follow-up after publishing an
    # earlier report.  That emits another final-result event for the same
    # worker/parent edge; it is a sequential continuation, not a second
    # worker.  Multiple worker identities remain ambiguous.
    worker_threads={row.get('thread_id') for row in workers if isinstance(row.get('thread_id'),str)}
    if not workers or len(worker_threads)!=1 or len(worker_threads)!=len({row.get('thread_id') for row in workers}):
        return None,'outcome_native_worker_missing_or_ambiguous'
    worker=workers[-1];worker_thread=worker.get('thread_id');report_id=worker.get('report_id')
    # Native current-host result metadata can retain the authoritative plural
    # form.  Accept it only when it carries exactly the one reported ID; never
    # let the singleton convenience field hide a duplicate or competing report.
    report_ids=worker.get('report_ids')
    if report_id is None and isinstance(report_ids,list) and len(report_ids)==1:
        report_id=report_ids[0]
    elif report_ids is not None and report_ids != [report_id]:
        return None,'outcome_native_worker_binding_mismatch'
    # Every superseded final must itself name one distinct, observed worker
    # report.  This prevents a duplicate final event from being silently
    # accepted merely because it shares a worker thread with the terminal one.
    prior_report_ids=[]
    for _,prior in worker_rows[:-1]:
        prior_id=prior.get('report_id');prior_ids=prior.get('report_ids')
        if prior_id is None and isinstance(prior_ids,list) and len(prior_ids)==1:
            prior_id=prior_ids[0]
        elif prior_ids is not None and prior_ids != [prior_id]:
            return None,'outcome_native_worker_binding_mismatch'
        if not isinstance(prior_id,str) or re.fullmatch(r'r_[0-9a-f]{12}',prior_id) is None:
            return None,'outcome_native_worker_missing_or_ambiguous'
        prior_report_ids.append(prior_id)
    if len(set(prior_report_ids))!=len(prior_report_ids) or report_id in prior_report_ids:
        return None,'outcome_native_worker_missing_or_ambiguous'
    body=worker.get('native_worker_result')
    opaque_current_host_result=(
        body is None and task is None and isinstance(worker.get('agent_path'),str)
        and bool(worker['agent_path']) and isinstance(report_id,str)
        and re.fullmatch(r'r_[0-9a-f]{12}',report_id) is not None)
    if not isinstance(worker_thread,str):
        return None,'outcome_native_worker_binding_mismatch'
    if opaque_current_host_result:
        expected_artifacts=None
    else:
        if (not isinstance(body,dict) or body.get('status')!='success'
                or body.get('task_id')!=task or body.get('worker_thread_id')!=worker_thread):
            return None,'outcome_native_worker_binding_mismatch'
        artifacts=body.get('artifacts')
        if not isinstance(artifacts,list) or not artifacts:
            return None,'outcome_artifact_reconciliation_missing'
        expected_artifacts=sorted({(hashlib.sha256(item['reference'].encode()).hexdigest()[:12],item['sha256'])
                                   for item in artifacts
                                   if isinstance(item,dict) and set(item)=={'reference','sha256'}
                                   and isinstance(item.get('reference'),str)
                                   and isinstance(item.get('sha256'),str)
                                   and re.fullmatch(r'[0-9a-f]{64}',item['sha256'])})
        if len(expected_artifacts)!=len(artifacts):
            return None,'outcome_artifact_reconciliation_missing'
    # A replay-marked worker publication is likewise retained as a hard
    # ambiguity.  This check must run before the publication eligibility filter
    # so a duplicate cannot disappear beside the valid publication.
    replayed_publications=[row for row in rows
                           if row.get('tool')=='mcp__cortex__write_report'
                           and row.get('thread_id')==worker_thread
                           and (row.get('replayed') is True or row.get('replay_marker') is True)]
    if replayed_publications:
        return None,'outcome_worker_report_missing_or_ambiguous'
    # Every successful publication from the bound worker belongs to one
    # observed native final in this lifecycle.  Validate cardinality before
    # narrowing to the terminal report ID; otherwise a distinct extra report
    # can be silently discarded by the terminal-ID filter below.
    successful_worker_publications=[row for row in rows
                                    if row.get('tool')=='mcp__cortex__write_report'
                                    and row.get('thread_id')==worker_thread
                                    and row.get('outcome')=='success']
    if len(successful_worker_publications)!=len(worker_rows):
        return None,'outcome_worker_report_missing_or_ambiguous'
    publication_rows=[(index,row) for index,row in enumerate(rows)
                      if row.get('tool')=='mcp__cortex__write_report'
                      and row.get('thread_id')==worker_thread
                      and row.get('outcome')=='success' and row.get('host_receipt_outcome')=='success'
                      and row.get('host_receipt_observed') is True and row.get('replayed') is not True
                      and row.get('replay_marker') is not True and row.get('truncated') is not True
                      and isinstance(row.get('report_id'),str)
                      and re.fullmatch(r'r_[0-9a-f]{12}',row['report_id'])]
    publications=[row for _,row in publication_rows]
    if report_id is None:
        terminal_start=(worker_rows[-2][0] if len(worker_rows)>1 else create_index)
        terminal_publications=[item['report_id'] for index,item in publication_rows
                               if terminal_start < index < worker_rows[-1][0]]
        if len(terminal_publications)!=1:
            return None,'outcome_worker_report_missing_or_ambiguous'
        report_id=terminal_publications[0]
    final_report_ids=[*prior_report_ids,report_id]
    if any(not isinstance(item,str) or re.fullmatch(r'r_[0-9a-f]{12}',item) is None
           for item in final_report_ids):
        return None,'outcome_worker_report_missing_or_ambiguous'
    for position,((final_index,_),final_report_id) in enumerate(zip(worker_rows,final_report_ids)):
        preceding_final_index=(worker_rows[position-1][0]
                               if position else create_index)
        matching=[index for index,item in publication_rows if item['report_id']==final_report_id]
        if len(matching)!=1 or not preceding_final_index < matching[0] < final_index:
            return None,'outcome_worker_report_missing_or_ambiguous'
    if report_id is not None:
        publications=[row for row in publications if row['report_id']==report_id]
    if len(publications)!=1:return None,'outcome_worker_report_missing_or_ambiguous'
    # Current native final bodies may omit a redundant report ID.  In the
    # observational route only, the exact one task-bound publication supplies
    # that identity after the worker/result/profile/task correlation above.
    # Missing or competing publication remains a hard outcome failure.
    report_id=publications[0]['report_id']
    reconciliations=[row for row in rows if row.get('tool')=='mcp__cortex__read_report'
                     and row.get('thread_id')==root and row.get('report_id')==report_id
                     and row.get('outcome')=='success' and row.get('host_receipt_outcome')=='success'
                     and row.get('host_receipt_observed') is True and row.get('replayed') is not True
                     and row.get('truncated') is not True
                     and (expected_artifacts is None or row.get('reported_artifact_bindings')==expected_artifacts)]
    if len(reconciliations)!=1:return None,'outcome_artifact_reconciliation_missing'
    if expected_artifacts is None:
        bindings=reconciliations[0].get('reported_artifact_bindings')
        expected_artifacts=sorted({tuple(item) for item in bindings
                                  if isinstance(item,(tuple,list)) and len(item)==2
                                  and isinstance(item[0],str) and re.fullmatch(r'[0-9a-f]{12}',item[0])
                                  and isinstance(item[1],str) and re.fullmatch(r'[0-9a-f]{64}',item[1])}) \
                           if isinstance(bindings,list) else []
        if not expected_artifacts or len(expected_artifacts)!=len(bindings):
            return None,'outcome_artifact_reconciliation_missing'
    return {'status':'complete','thread_id':root,'task_id':task,'worker_thread_id':worker_thread,
            'worker_profile':(body.get('profile') if isinstance(body,dict) else worker.get('role')),
            'report_id':report_id,'artifact_binding_count':len(expected_artifacts),
            'host_enforcement_state':'unverified',
            **({'task_binding':'opaque_root_report_correlation'} if task is None else {})},None


def observational_read_report_failure_diagnostic(rows, row, state=None):
    """Recognize one harmless current-host report lookup after full outcome proof.

    A malformed *lookup operand* is not a malformed evidence receipt.  This is
    intentionally narrower than generic error recovery: it accepts only one
    completed public ``read_report`` error with ``invalid_arguments``, explicit
    no-mutation metadata, and a separate complete outcome that has already
    bound the real publication and artifact hashes.  It never hides a failed
    write, an unbound/ambiguous report, a truncated row, or an unsafe target.
    """
    if not isinstance(row,dict):return False
    if not isinstance(state,dict):
        state={'bootstrap_route':MCP_FIRST_BOOTSTRAP_ROUTE,
               'bootstrap_expected_child_thread_id':next((item.get('thread_id') for item in rows
                   if item.get('tool')=='mcp__cortex__create_task' and item.get('direct_public_mcp') is True),None)}
    outcome,_=current_host_outcome_receipt(rows,state)
    if outcome is None:return False
    tool=canonical_tool_name(row)
    if not tool and row.get('operation')=='read_report':tool='mcp__cortex__read_report'
    if tool!='mcp__cortex__read_report' or row.get('outcome')!='error':return False
    code=row.get('error_code') or row.get('host_error_code')
    if code!='invalid_arguments':return False
    if (row.get('mutation_observed') is not False or row.get('truncated') is True
            or row.get('replayed') is True or row.get('replay_marker') is True
            or row.get('wrapper_outcome') in INCOMPLETE_OUTCOMES
            or row.get('private_target_access') is True
            or row.get('project_target_access') is True):return False
    matching=[item for item in rows
              if canonical_tool_name(item)=='mcp__cortex__read_report'
              and item.get('outcome')=='error'
              and (item.get('error_code') or item.get('host_error_code'))=='invalid_arguments'
              and item.get('mutation_observed') is False
              and item.get('truncated') is not True and item.get('replayed') is not True
              and item.get('replay_marker') is not True
              and item.get('wrapper_outcome') not in INCOMPLETE_OUTCOMES
              and item.get('private_target_access') is not True
              and item.get('project_target_access') is not True]
    return len(matching)==1


def observational_worker_skill_read_failure_diagnostic(rows, row, state, proven_outcome=None):
    """Recognize equivalent safe declared-read failures after outcome proof.

    A failed inspection of a registered public skill/reference leaf is diagnostic
    only after a separate complete exact assigned-SKILL receipt exists. It never
    creates that receipt or excuses a worker project action before the receipt.
    Every failed record must remain side-effect-free and share one attributable
    worker, profile, literal operation/path identity, and complete bounded result.
    """
    outcome=proven_outcome
    if outcome is None:
        outcome,_=current_host_outcome_receipt(rows,state)
    if outcome is None or not isinstance(row,dict):return False

    # A terminal failure is demoted only by affirmative safety evidence.  Do
    # not turn an omitted, future, or replay-marked field into a safe result by
    # using a deny-list predicate such as ``is not True``.
    def exact_safe_observation(item):
        return isinstance(item,dict) and all(
            item.get(marker) is False for marker in (
                'replayed','replay_marker','truncated','private_target_access',
                'project_target_access','mutation_observed'))

    expected_profile=outcome.get('worker_profile')
    receipts=[item for item in rows if (
        isinstance(item,dict)
        and item.get('thread_id')==outcome.get('worker_thread_id')
        and item.get('parent_thread_id')==outcome.get('thread_id')
        and item.get('worker_skill_complete') is True
        and isinstance(item.get('worker_skill_profile'),str)
        and (expected_profile is None or item.get('worker_skill_profile')==expected_profile)
        and item.get('worker_skill_assignment_receipt')=='complete_exact_assigned'
        and item.get('outcome') in {'success','covered_by_command_execution'}
        and item.get('wrapper_outcome')=='success'
        and exact_safe_observation(item))]
    if len(receipts)!=1:return False
    expected_profile=receipts[0]['worker_skill_profile']

    def related(item):
        return (
            isinstance(item,dict)
            and item.get('thread_id')==outcome.get('worker_thread_id')
            and item.get('parent_thread_id')==outcome.get('thread_id')
            and item.get('worker_skill_receipt_required') is True
            and item.get('skill_instruction_read') is True
            # A nested tool row is changed to ``covered_by_command_execution``
            # once the host supplies the authoritative terminal receipt.  Keep
            # its declaration-bound safety metadata eligible for the same
            # completed failure classification.
            and item.get('outcome') in {'error','covered_by_command_execution'})

    def safe_declared_read(item):
        return (
            isinstance(item,dict)
            and item.get('tool') in {'exec_command','read_file'}
            # Bind each failed row to the terminal worker's exact registered
            # profile. Same-thread activity from another profile is not the
            # declared read whose independently successful receipt was proven.
            and item.get('role')==expected_profile
            and item.get('worker_skill_profile') in {None,expected_profile}
            and item.get('path_policy_provenance')=='observer_literal_marker'
            and item.get('path_target_class')=='approved_instruction_or_static_mention'
            and item.get('path_access_kind')=='approved_instruction_read'
            and item.get('path_policy_decision')=='allowed'
            and isinstance(item.get('result_digest'),str)
            and re.fullmatch(r'[0-9a-f]{12}',item['result_digest']) is not None
            and exact_safe_observation(item)
            # A diagnostic requires an explicit, supported completed wrapper
            # result.  Absent, failed, incomplete, or future/unknown wrapper
            # states cannot prove that the declared read completed safely.
            and item.get('wrapper_outcome')=='success'
        )

    def matches(item):
        return (
            related(item)
            and safe_declared_read(item)
            # A direct failed read has its own complete execution receipt.  It
            # cannot inherit completion from a terminal command record: the
            # only supported direct state is one executed, non-zero result.
            and item.get('execution_status')=='executed'
            and isinstance(item.get('exit_code'),int)
            and not isinstance(item.get('exit_code'),bool)
            and item.get('exit_code')!=0)

    def command_execution_matches(item):
        """Bind one failed native command receipt to its safe nested read.

        Desktop records a shell tool invocation and its authoritative
        ``CommandExecution`` exit separately.  The latter has the failure
        status but intentionally carries no raw command/path details.  It is a
        diagnostic only when exactly one same-worker, same-intent nested read
        already supplies the declaration-bound read identity and safety facts.
        """
        if not (
                isinstance(item,dict)
                and item.get('tool')=='command_execution'
                and item.get('outcome')=='error'
                and item.get('thread_id')==outcome.get('worker_thread_id')
                and item.get('parent_thread_id')==outcome.get('thread_id')
                and item.get('role')==expected_profile
                and isinstance(item.get('intent_digest'),str)
                and exact_safe_observation(item)
                # The terminal receipt participates in the same completed
                # wrapper proof as its nested declaration-bound source.
                and item.get('wrapper_outcome')=='success'
                and isinstance(item.get('exit_code'),int)
                and not isinstance(item.get('exit_code'),bool)
                and item.get('exit_code')!=0):
            return False
        # Cardinality must cover every same-worker, same-intent terminal
        # receipt, not only terminal rows that already look safe.  Otherwise a
        # duplicate unsafe terminal could be silently ignored while its safe
        # sibling is demoted to a diagnostic.
        terminal_rows=[terminal for terminal in rows if (
            isinstance(terminal,dict)
            and terminal.get('thread_id')==item.get('thread_id')
            and terminal.get('parent_thread_id')==item.get('parent_thread_id')
            and terminal.get('role')==expected_profile
            and terminal.get('tool')=='command_execution'
            and terminal.get('intent_digest')==item.get('intent_digest'))]
        if not any(terminal is item for terminal in terminal_rows):
            terminal_rows.append(item)
        if len(terminal_rows)!=1:
            return False

        # Keep competing nested reads in the correlation set before applying
        # their safety predicate.  A missing marker, dispatch, incomplete
        # wrapper, or unsafe observation is still relevant evidence and must
        # prevent the terminal from hiding the competing row.
        sources=[source for source in rows if (
            isinstance(source,dict)
            and source.get('thread_id')==item.get('thread_id')
            and source.get('parent_thread_id')==item.get('parent_thread_id')
            and source.get('role')==expected_profile
            and source.get('tool')=='exec_command'
            and source.get('intent_digest')==item.get('intent_digest'))]
        if len(sources)!=1:
            return False
        source=sources[0]
        return (
            source.get('outcome')=='covered_by_command_execution'
            # The nested receipt supplies the only read-result identity.  It
            # must therefore carry the one supported completed execution
            # state; incomplete, absent, and unknown states cannot establish
            # an equivalent safe declared-read for the terminal failure.
            and source.get('execution_status')=='executed'
            # The terminal receipt has no declaration-read metadata of its
            # own.  Its nested source must therefore retain both exact
            # declaration markers as well as the path-safety facts.
            and related(source)
            and safe_declared_read(source))

    def identity(item):
        return tuple(item.get(key) for key in (
            'thread_id','parent_thread_id','role','worker_skill_profile',
            'tool','operation','path_policy_provenance','path_target_class',
            'path_access_kind','path_policy_decision','path_argument_digest',
            'path_workdir_digest','path_command_intent_digest','argument_digest',
            'wrapper_argument_digest','intent_digest','result_digest',
            'execution_status','exit_code','error_code',
        ))

    if command_execution_matches(row):return True
    if not matches(row):return False
    related_rows=[item for item in rows if related(item)]
    # Direct diagnostics have no terminal-to-nested correlation exception. A
    # second, incomplete, unknown, or unsafe declared-read record is ambiguous
    # evidence and must remain blocking even when it shares every identity bit.
    return (len(related_rows)==1 and matches(related_rows[0])
            and identity(related_rows[0])==identity(row))


def observational_policy_partition(rows, state, violations):
    """Partition current-host receipt gaps from still-blocking audit findings.

    This is deliberately an observer-only relaxation.  It never authorizes an
    action, changes the emitted policy findings, or turns an asserted native
    result into host enforcement.  In the bounded MCP-first route only, a
    complete correlated ``cortex-native-worker-result-v1`` can explain why the
    current host did not expose a separate assignment-policy attestation. The
    exact assigned worker-SKILL receipt remains mandatory. A public
    Cortex result can likewise explain a missing server event only when a later
    same-thread, complete publication result binds the observation.  Everything
    malformed, replayed, failed, truncated, private, or otherwise unbound stays
    in the blocking partition.
    """
    if not isinstance(state, dict) or state.get('bootstrap_route') != MCP_FIRST_BOOTSTRAP_ROUTE:
        return list(violations), []
    outcome,_=current_host_outcome_receipt(rows,state)
    def result_only_publication(violation):
        thread=violation.get('thread_id');tool=violation.get('tool')
        if not isinstance(thread, str) or not isinstance(tool, str):
            return False
        calls=[(index,row) for index,row in enumerate(rows)
               if row.get('thread_id') == thread and row.get('tool') == tool]
        if len(calls) != 1:
            return False
        index,call=calls[0]
        if not (tool.startswith('mcp__cortex__')
                and call.get('outcome') == 'success'
                and call.get('host_receipt_outcome') == 'success'
                and call.get('host_receipt_observed') is True
                and call.get('result_receipt_observed') is True
                and call.get('server_observed') is not True
                and call.get('replayed') is not True
                and call.get('truncated') is not True
                and call.get('wrapper_outcome') not in INCOMPLETE_OUTCOMES):
            return False
        publications=[row for row in rows[index + 1:]
                      if row.get('thread_id') == thread
                      and row.get('tool') == 'mcp__cortex__write_report'
                      and row.get('outcome') == 'success'
                      and row.get('host_receipt_outcome') == 'success'
                      and row.get('host_receipt_observed') is True
                      and row.get('result_receipt_observed') is True
                      and isinstance(row.get('report_id'), str)
                      and row.get('replayed') is not True
                      and row.get('truncated') is not True
                      and row.get('wrapper_outcome') not in INCOMPLETE_OUTCOMES]
        return len(publications) == 1

    blocking=[];diagnostics=[]
    unsupported_current_host_labels={
        'worker_assignment_policy_unverified',
        'mcp_first_bootstrap_unverified',
    }
    for violation in violations:
        name=violation.get('violation')
        # These two names record capabilities that the installed current host
        # cannot expose.  They are always visible diagnostics in this route,
        # never evidence, a score contribution, host enforcement, an integrity
        # invalidator, or an acceptance shortcut.  Supported outcome and safety
        # defects remain in the ordinary blocking partition below.
        unsupported_by_current_host=name in unsupported_current_host_labels
        event_gap=(name == 'cortex_call_missing_server_event'
                   and result_only_publication(violation))
        outcome_gap=(outcome is not None and (
            name in {'worker_final_without_report_id'}))
        harmless_lookup=(name=='mcp_tool_error_observed'
                         and observational_read_report_failure_diagnostic(rows,violation,state))
        safe_declared_read_failure=(name=='worker_skill_load_failed' and any(
            observational_worker_skill_read_failure_diagnostic(rows,item,state)
            and item.get('thread_id')==violation.get('thread_id')
            and item.get('result_digest')==violation.get('result_digest')
            for item in rows))
        if unsupported_by_current_host or event_gap or outcome_gap or harmless_lookup or safe_declared_read_failure:
            diagnostics.append({**violation, 'observational_diagnostic': True,
                                'host_enforcement_state': 'unverified',
                                **({'not_applicable':True,
                                    'unsupported_by_current_host':True}
                                   if unsupported_by_current_host else {}),
                                **({'diagnostic_reason':'failed_safe_declared_resource_read'}
                                   if safe_declared_read_failure else {}),
                                **({'outcome_receipt':outcome} if outcome is not None else {})})
        else:
            blocking.append(violation)
    return blocking,diagnostics


def call_policy_violations(rows):
    rows=list(rows)
    violations=[];clarification_parents=set();published=set();active_sessions={};active_cells={};coordinator_waited=set()
    completed={};worker_parents={};worker_roles={};latest_report={};owned_reports={};issued_drafts={}
    capacity_blocked=set();capacity_snapshot=set();pending_replies=set();worker_skill_receipts=set()
    for source_row in rows:
        # Host receipts can represent a tool as separate namespace/name fields.
        # Work on a copy so every downstream policy branch sees the canonical
        # Cortex identity while the safe original namespace remains attached.
        row=dict(source_row)
        canonical=canonical_tool_name(row)
        if canonical:row['tool']=canonical
        # Older observation streams may contain choreography hints. They remain
        # useful metadata, but only outcome/state violations can fail an audit.
        flags=[flag for flag in row.get('policy_flags',[]) if flag not in ADVISORY_POLICY_FLAGS]
        thread=row.get('thread_id')
        role=row.get('role')
        tool=row.get('tool')
        model=row.get('model');effort=row.get('reasoning_effort')
        worker=(role not in {'coordinator','runtime',None})
        receipt=(worker and row.get('worker_skill_complete') is True
                 and row.get('outcome') in {'success','covered_by_command_execution'}
                 and row.get('wrapper_outcome','success')=='success')
        assigned=(role if isinstance(role,str) and assigned_worker_profile(
            '$cortex:worker-'+role.replace('_','-'))==role else None)
        if receipt:
            if assigned is None or row.get('worker_skill_profile') != assigned:
                flags.append('worker_skill_route_mismatch')
            else:
                worker_skill_receipts.add(thread)
        worker_project_tool=(tool in {'exec_command','write_stdin','command_execution',
                                      'read_file','write_file','apply_patch','terminal','js'}
                             or isinstance(tool,str) and tool.startswith('mcp__'))
        skill_read_attempt=(worker and row.get('skill_instruction_read') is True)
        if (skill_read_attempt and row.get('outcome') == 'error'
                and row.get('wrapper_outcome') not in INCOMPLETE_OUTCOMES):
            # An approved skill route that returns a complete error is failed
            # receipt acquisition, not a project operation.  It cannot credit
            # the worker; the later project action remains fail-closed below.
            flags.append('worker_skill_load_failed')
        if (worker and row.get('worker_skill_receipt_required') is True
                and worker_project_tool and tool!='functions.exec'
                and not skill_read_attempt
                and thread not in worker_skill_receipts):
            flags.append('worker_project_action_before_skill_receipt')
        if tool=='mcp__cortex__create_draft' and row.get('outcome')=='success' and row.get('draft_id'):
            issued_drafts.setdefault(thread,set()).add(row['draft_id'])
        if role=='senior_consultant' and tool=='apply_patch':
            targets=set(row.get('edited_draft_ids',[]))
            if not targets or not targets<=issued_drafts.get(thread,set()) or not row.get('ordinary_draft_edit'):
                flags.append('senior_consultant_forbidden_project_access')
        if role=='senior_consultant' and tool=='send_message':
            parent=row.get('parent_thread_id')
            if not parent or (row.get('target_thread_id')!=parent and row.get('target_agent')!='/root'):
                flags.append('senior_consultant_forbidden_project_access')
        if (role not in {'coordinator','runtime',None}
                and tool in {'send_message_to_thread',
                             'mcp__codex_app__send_message_to_thread'}
                and 'forbidden_worker_app_thread_message' not in flags):
            flags.append('forbidden_worker_app_thread_message')
        if role not in {'runtime',None}:
            if role=='senior_consultant':
                if model is not None and model not in LIVE_CONSULTANT_MODELS:
                    flags.append('live_model_policy_violation')
            elif model is not None and model!=LIVE_MODEL:
                flags.append('live_model_policy_violation')
            if role=='coordinator' and effort is not None and effort!=LIVE_COORDINATOR_EFFORT:
                flags.append('live_model_policy_violation')
            if role=='senior_consultant' and effort is not None and effort not in LIVE_CONSULTANT_EFFORTS:
                flags.append('live_model_policy_violation')
            if role not in {'coordinator','senior_consultant'} and effort is not None and effort not in LIVE_WORKER_EFFORTS:
                flags.append('live_model_policy_violation')
        if tool=='spawn_agent':
            profile=row.get('assigned_profile')
            opaque=row.get('assignment_content_unavailable') is True
            # The standard consultant route is fully observable in native
            # parameters. This verifies routing/isolation, not hidden prose,
            # escalation rationale, evidence selection or assignment quality.
            default_consultant_route=(opaque
                and profile=='senior_consultant'
                and row.get('profile_evidence')=='native_task_name'
                and row.get('task_name')=='senior_consultant'
                and row.get('fork_turns')=='none'
                and row.get('requested_model')=='gpt-5.6-sol'
                and row.get('requested_reasoning_effort')=='medium')
            # In isolated live runs every executor has the same explicit Luna
            # policy. Require a linked native child, completed skill loading and
            # matching actual model/effort instead of pretending to read its
            # encrypted assignment. Hidden rationale remains unavailable.
            observed_profile=row.get('observed_worker_profile')
            registered_executor=(
                isinstance(observed_profile,str)
                and observed_profile not in {'worker','senior_consultant'}
                and assigned_worker_profile(
                    '$cortex:worker-'+observed_profile.replace('_','-'))==observed_profile)
            actual_route=(opaque
                and row.get('worker_route_evidence')=='native_child_and_complete_skill'
                and row.get('spawned_thread_id')
                and row.get('native_child_path_verified') is True
                and row.get('validated_parent_edge') is True
                and row.get('worker_skill_receipt')=='complete_success'
                and registered_executor
                and row.get('fork_turns')=='none'
                and row.get('observed_worker_model')==LIVE_MODEL
                and row.get('observed_worker_effort') in LIVE_WORKER_EFFORTS)
            requested_fields_explicit=(
                isinstance(row.get('requested_model'),str)
                and bool(row.get('requested_model'))
                and isinstance(row.get('requested_reasoning_effort'),str)
                and bool(row.get('requested_reasoning_effort')))
            allowed_models=LIVE_CONSULTANT_MODELS if profile=='senior_consultant' else {None,LIVE_MODEL}
            allowed_efforts=LIVE_CONSULTANT_EFFORTS if profile=='senior_consultant' else {None,*LIVE_WORKER_EFFORTS}
            visible_request_valid=(
                requested_fields_explicit
                and row.get('requested_model') in allowed_models
                and row.get('requested_reasoning_effort') in allowed_efforts)
            observed_executor_route=(actual_route
                and requested_fields_explicit
                and row.get('requested_model')==LIVE_MODEL
                and row.get('requested_reasoning_effort') in LIVE_WORKER_EFFORTS
                and row.get('observed_worker_model')==row.get('requested_model')
                and row.get('observed_worker_effort')==row.get('requested_reasoning_effort'))
            unavailable_actual_route=(
                actual_route and not requested_fields_explicit
                and row.get('requested_model') is None
                and row.get('requested_reasoning_effort') is None)
            if unavailable_actual_route:
                row['route_policy_provenance']='requested_route_unavailable_actual_route_verified'
            route_policy_verified=(
                (opaque and (default_consultant_route or observed_executor_route
                             or unavailable_actual_route))
                or (not opaque and visible_request_valid))
            if not route_policy_verified:
                flags.append('worker_assignment_policy_unverified')
            if (not opaque or profile is not None) and row.get('requested_model') not in allowed_models:
                flags.append('live_model_policy_violation')
            if row.get('requested_reasoning_effort') not in allowed_efforts:
                flags.append('live_model_policy_violation')
        # The fixed live-test route above remains intentionally narrow. This
        # separate product-policy audit accepts the user-requested override but
        # rejects coordinator-selected worker routes outside the Luna/Terra/Sol
        # matrix, including the Sol-for-implementation shortcut.
        worker_route=(tool=='spawn_agent' or role not in {'coordinator','runtime',None})
        route_model=row.get('requested_model') if tool=='spawn_agent' else model
        route_effort=row.get('requested_reasoning_effort') if tool=='spawn_agent' else effort
        route_class=row.get('task_class') or row.get('policy_class')
        route_metadata=(
            (tool=='spawn_agent' and (route_class is not None or route_model is not None or
                                      route_effort is not None))
            or row.get('policy_evidence') is not None
            or row.get('worker_policy_enforced') is True
        )
        if worker_route and route_metadata and not row.get('assignment_content_unavailable'):
            flags.extend(worker_model_policy(
                route_model,route_effort,route_class or 'ordinary',
                explicit_user_override=bool(row.get('explicit_user_override') or
                                            row.get('user_requested_model')),
                require_explicit=route_class is not None or row.get('worker_policy_enforced') is True,
                implementation_model=row.get('implementation_model'),
                implementation_effort=row.get('implementation_effort')))
        if tool in {'exec_command','write_stdin'} and row.get('wrapper_outcome')=='unverified':
            flags.append('command_wrapper_missing_receipt')
        if tool=='native_assignment_snapshot':
            published.add(thread);latest_report[thread]=row['report_id']
            owned_reports[thread]=set(row.get('owned_report_ids',[row['report_id']]))
            completed[thread]=row.get('timestamp') or ''
            worker_parents[thread]=row.get('parent_thread_id');worker_roles[thread]=role
            continue
        if role not in {'coordinator','runtime',None} and row.get('parent_thread_id'):
            worker_parents[thread]=row['parent_thread_id']
            worker_roles[thread]=role
        reassigned=False
        if tool=='native_agent_result' and row.get('parent_thread_id'):
            # A real terminal worker event permits another capacity attempt.
            parent=row['parent_thread_id']
            capacity_blocked.discard(parent);capacity_snapshot.discard(parent)
        if role=='coordinator' and tool=='close_agent' and row.get('outcome')=='success':
            capacity_blocked.discard(thread);capacity_snapshot.discard(thread)
        if role=='coordinator' and tool=='followup_task' and row.get('outcome')=='success':
            target=row.get('target_thread_id')
            # Both publication and its final handoff must precede the assignment
            # request, not merely its delayed transport response.
            requested=row.get('requested_timestamp') or row.get('timestamp') or ''
            if (target in published and target in completed
                    and worker_parents.get(target)==thread
                    and requested>=completed[target]):
                # A profile does not identify a shared file/device resource.
                # Actual overlapping ownership is a coordinator/reviewer decision.
                published.remove(target);completed.pop(target)
                reassigned=True
            elif target in published or not target:
                flags.append('coordinator_followup_without_completed_assignment')
        if (role=='coordinator' and tool=='send_message'
                and row.get('target_thread_id') in completed):
            flags.append('coordinator_message_to_completed_worker')
        if tool=='native_user_input' and role=='coordinator':
            coordinator_waited.discard(thread)
        if tool=='native_agent_result' and not row.get('report_id') and row.get('parent_thread_id'):
            clarification_parents.add(row['parent_thread_id'])
        if (tool=='send_message' and role not in {'coordinator','runtime'}
                and row.get('outcome')=='success' and row.get('parent_thread_id')
                and (row.get('target_thread_id')==row['parent_thread_id']
                     or (row.get('target_agent')=='/root'
                         and row['parent_thread_id'] in coordinator_waited))):
            pending_replies.add((row['parent_thread_id'],thread))
        if row.get('original_request_preserved') is False:
            flags.append('coordinator_original_request_changed')
        sessions=active_sessions.setdefault(thread,set())
        cells=active_cells.setdefault(thread,set())
        if cells and tool!='wait' and not row.get('nested'):
            flags.append('tool_called_before_exec_cell_terminal')
        if tool=='functions.exec' and row.get('outcome')=='running':
            cells.update(row.get('cell_ids',[]))
        if tool=='wait' and row.get('outcome') in {'success','stopped','error'}:
            cells.difference_update(row.get('requested_cell_ids',[]))
        if tool=='exec_command' and row.get('outcome')=='running':
            sessions.update(row.get('session_ids',[]))
        if tool=='write_stdin' and row.get('outcome') in {'success','stopped','error'}:
            sessions.difference_update(row.get('requested_session_ids',[]))
        if role=='coordinator':
            if tool=='spawn_agent':
                if thread in capacity_blocked:
                    flags.append('coordinator_spawn_retry_without_capacity_change')
                if row.get('error_code')=='agent_limit_reached':
                    capacity_blocked.add(thread)
                coordinator_waited.discard(thread)
            elif tool=='wait_agent':coordinator_waited.add(thread)
            elif tool=='list_agents':
                if thread in capacity_blocked:
                    if thread in capacity_snapshot:
                        flags.append('coordinator_repeated_capacity_snapshot')
                    capacity_snapshot.add(thread)
                # Native lifecycle/status observation is internal coordination
                # and does not write a worker message into the app thread.
                # Keep it legal after a wait; thread-visible worker messaging
                # is audited separately by the app-route checks above.
            elif tool in {'send_message','followup_task'} and thread in coordinator_waited:
                if reassigned:coordinator_waited.discard(thread)
                elif (tool=='send_message'
                      and (thread,row.get('target_thread_id')) in pending_replies):
                    if row.get('outcome')=='success':
                        pending_replies.remove((thread,row['target_thread_id']))
                elif thread in clarification_parents:clarification_parents.remove(thread)
                else:flags.append('coordinator_unsolicited_message_after_wait')
        if (row.get('role')!='runtime' and row.get('tool')=='mcp__cortex__read_report'
                and row.get('requested_limit',0)>4000):
            flags.append('oversized_report_page')
        if (thread in published and row.get('role') not in {'coordinator','runtime'}
                and row.get('tool') not in {'functions.exec','native_agent_result'}):
            flags.append('worker_tool_after_successful_write_report')
        if (role not in {'coordinator','runtime'} and sessions
                and tool=='mcp__cortex__create_draft'):
            flags.append('worker_draft_created_with_open_command_session')
        if (role not in {'coordinator','runtime'} and sessions
                and tool=='mcp__cortex__write_report'):
            flags.append('worker_report_published_with_open_command_session')
        if tool.startswith('mcp__cortex__') and not row.get('server_observed',True):
            flags.append('cortex_call_missing_server_event')
        if (is_cortex_mcp_tool(row)
                and row.get('outcome')=='error'
                and row.get('host_receipt_outcome')!='success'):
            flags.append('mcp_tool_error_observed')
        if (is_cortex_mcp_tool(row)
                and role not in {'runtime',None}
                and row.get('argument_digest') is not None
                and not row.get('host_receipt_observed')):
            flags.append('mcp_call_missing_host_receipt')
        if (row.get('host_dispatch_decision') == 'PERMISSION_DENIED'
                and row.get('host_dispatch_execution') == 'executed'):
            flags.append('host_dispatch_bypass')
        if tool=='native_agent_result' and row.get('outcome')=='success':
            # `report_ids`, when present, is the complete parsed final-result
            # reference set.  Never let a singleton convenience field conceal
            # additional, missing, or foreign references in that set.
            report_ids=(row.get('report_ids',[]) if 'report_ids' in row
                        else ([row['report_id']] if row.get('report_id') else []))
            fallback=(isinstance(row.get('native_worker_result'),dict)
                      and row['native_worker_result'].get('worker_mcp')=='unavailable')
            if fallback:
                # The coordinator-authored delegation-evidence publication is
                # checked by the closed fallback validator below.  Do not make
                # unavailable worker MCP masquerade as a missing worker report.
                pass
            elif not report_ids:
                flags.append('worker_final_without_report_id')
            elif (len(report_ids)!=1 or report_ids[0]!=latest_report.get(thread)
                  or report_ids[0] not in owned_reports.get(thread,set())):
                flags.append('worker_final_with_unobserved_report')
            else:
                completed[thread]=row.get('timestamp') or ''
        if row.get('tool')=='mcp__cortex__write_report' and row.get('outcome')=='success':
            published.add(thread)
            if row.get('report_id'):
                latest_report[thread]=row['report_id']
                owned_reports.setdefault(thread,set()).add(row['report_id'])
        for flag in sorted(set(flags)):
            violation=dict(timestamp=row.get('timestamp'),timestamp_ns=row.get('timestamp_ns'),
                           thread_id=thread,role=row.get('role'),tool=row.get('tool'),violation=flag)
            for key in ('tool_namespace','path_policy_provenance','path_target_class','path_access_kind',
                        'path_policy_decision','path_argument_digest','path_workdir_digest',
                        'path_command_intent_digest','argument_digest','result_digest','intent_digest',
                        'outcome','wrapper_outcome','host_status','host_receipt_outcome',
                        'exit_code','truncated','host_dispatch_decision','host_dispatch_execution'):
                if key in row:violation[key]=row[key]
            violations.append(violation)
    for finding in task_source_revision_violations(rows):
        violation=dict(thread_id=finding['thread_id'],role='runtime',
                       tool='mcp__cortex__source_revision',
                       violation=finding['violation'])
        if finding.get('task_id') is not None:
            violation['task_id']=finding['task_id']
        violations.append(violation)
    violations.extend(native_worker_result_fallback_violations(rows))
    return violations


def write_state(path,state):
    temporary=path.with_suffix('.tmp')
    temporary.write_text(json.dumps(state));os.chmod(temporary,0o600);os.replace(temporary,path)


def desktop_window(pid):
    xdotool=shutil.which('xdotool')
    if not xdotool:raise RuntimeError('xdotool is required to submit the prepared Desktop prompt')
    found=subprocess.run([xdotool,'search','--onlyvisible','--name','^ChatGPT$'],capture_output=True,text=True)
    matches=[]
    for window in found.stdout.split():
        owner=subprocess.run([xdotool,'getwindowpid',window],capture_output=True,text=True)
        if owner.returncode==0 and owner.stdout.strip()==str(pid):matches.append(window)
    if len(matches)!=1:
        raise RuntimeError(f'exactly one visible ChatGPT window owned by isolated pid {pid} is required; found {len(matches)}')
    return xdotool,matches[0]


def wait_desktop_window(pid,deadline=None):
    """Find one owned Desktop window without exceeding the caller's monotonic budget."""
    if deadline is None:
        deadline=time.monotonic()+DESKTOP_READY_TIMEOUT_SECONDS
    while time.monotonic()<deadline:
        try:return desktop_window(pid)
        except RuntimeError:
            remaining=deadline-time.monotonic()
            if remaining<=0:break
            time.sleep(min(DESKTOP_READY_POLL_SECONDS,remaining))
    raise RuntimeError('isolated Desktop window did not become uniquely available before the readiness deadline')


def desktop_thread_ids(workdir,started_at):
    database=Path.home()/'.cortex-dev/.codex/state_5.sqlite'
    if not database.is_file():return set()
    connection=sqlite3.connect(f'file:{database}?mode=ro',uri=True)
    try:
        return {row[0] for row in connection.execute(
            'SELECT id FROM threads WHERE cwd=? AND created_at>=?',
            (workdir,int(started_at)-2),
        )}
    finally:connection.close()


def desktop_task_thread_ids(state):
    """Resolve the exact submitted Desktop task tree from durable native edges."""
    return desktop_task_inventory(state)[0]


def desktop_task_inventory(state):
    """Return the selected tree, competing roots, and fatal recent topology defects."""
    database=Path.home()/'.cortex-dev/.codex/state_5.sqlite'
    if not database.is_file():return set(),[],[]
    connection=sqlite3.connect(f'file:{database}?mode=ro',uri=True)
    try:
        threads={row[0] for row in connection.execute(
            'SELECT id FROM threads WHERE cwd=? AND created_at>=?',
            (state['workdir'],int(state.get('thread_created_since',state.get('started_at',0)))-2))}
        edge_rows=list(connection.execute(
            'SELECT parent_thread_id,child_thread_id FROM thread_spawn_edges'))
    finally:connection.close()
    relevant=[(parent,child) for parent,child in edge_rows
              if parent in threads or child in threads]
    invalid=[];parents={}
    for parent,child in relevant:
        if not parent or not child:
            invalid.append('malformed_edge_identity')
            continue
        parents.setdefault(child,[]).append(parent)
        if parent==child:invalid.append('self_parent:'+child)
        if parent in threads and child not in threads:
            invalid.append('edge_child_outside_recent_inventory:'+child)
    for child,values in parents.items():
        if len(values)!=len(set(values)):
            invalid.append('duplicate_edge:'+child)
        if len(set(values))>1:
            invalid.append('multiple_parents:'+child)
    edges={child:values[0] for child,values in parents.items()
           if len(set(values))==1 and child in threads}

    cycle_nodes=set()
    for start in threads:
        order=[];positions={};node=start
        while node in threads and node in edges:
            if node in positions:
                cycle_nodes.update(order[positions[node]:]);break
            positions[node]=len(order);order.append(node);node=edges[node]
    for node in sorted(cycle_nodes):invalid.append('parent_cycle:'+node)

    scoped=task_thread_scope(state.get('thread_id'),threads,edges)
    foreign=threads-scoped
    foreign_roots={thread for thread in foreign if edges.get(thread) not in foreign}
    # A cyclic component has no natural root. Listing its members prevents the
    # foreign component from disappearing behind an empty roots array.
    foreign_roots.update(cycle_nodes & foreign)
    return scoped,sorted(foreign_roots),sorted(set(invalid))


def window_geometry(xdotool,window):
    result=subprocess.run([xdotool,'getwindowgeometry','--shell',window],capture_output=True,text=True,check=True)
    values=dict(line.split('=',1) for line in result.stdout.splitlines() if '=' in line)
    return tuple(int(values[key]) for key in ('X','Y','WIDTH','HEIGHT'))


DESKTOP_PROPERTY_WARNING='XGetWindowProperty[_NET_WM_DESKTOP] failed (code=1)'
DESKTOP_COMPOSER_HYDRATION_SECONDS=3.0
DESKTOP_READY_OBSERVATIONS=2
DESKTOP_READY_POLL_SECONDS=.25
DESKTOP_READY_TIMEOUT_SECONDS=60.0


def _owned_desktop_window(xdotool,window,pid):
    result=subprocess.run([xdotool,'getwindowpid',window],capture_output=True,text=True)
    if result.returncode!=0 or result.stdout.strip()!=str(pid):
        raise RuntimeError('isolated Desktop window ownership changed during activation')


def activate_desktop_window(xdotool,window,pid,state=None,state_file=None):
    """Activate the owned window, with one narrowly gated X11 focus fallback."""
    result=subprocess.run([xdotool,'windowactivate','--sync',window],capture_output=True,text=True)
    warning=(result.stderr or '').strip()
    if result.returncode==0:
        activation={'method':'windowactivate','returncode':0}
        try:
            _owned_desktop_window(xdotool,window,pid)
        except RuntimeError:
            activation['fallback']='failed_ownership'
            if state is not None and state_file is not None:
                state['desktop_activation']=activation;write_state(state_file,state)
            raise
        active=subprocess.run([xdotool,'getactivewindow'],capture_output=True,text=True)
        if active.returncode!=0 or active.stdout.strip()!=str(window):
            activation['active_window']='mismatch'
            if state is not None and state_file is not None:
                state['desktop_activation']=activation;write_state(state_file,state)
            raise RuntimeError('window activation did not make the owned Desktop window active')
    elif warning != DESKTOP_PROPERTY_WARNING:
        activation={'method':'windowactivate','returncode':result.returncode,
                    'error':DESKTOP_PROPERTY_WARNING if DESKTOP_PROPERTY_WARNING in warning else 'activation_failed'}
        if state is not None and state_file is not None:
            state['desktop_activation']=activation;write_state(state_file,state)
        raise RuntimeError('isolated Desktop window activation failed')
    else:
        # xdotool can query _NET_WM_DESKTOP while the valid Electron window has
        # no readable property. Only this exact warning permits a focus-only
        # fallback, and ownership is checked on both sides of the focus call.
        activation={'method':'windowfocus_fallback','returncode':result.returncode,
                    'warning':DESKTOP_PROPERTY_WARNING,'fallback':'attempted'}
        if state is not None and state_file is not None:
            state['desktop_activation']=activation;write_state(state_file,state)
        try:
            _owned_desktop_window(xdotool,window,pid)
        except RuntimeError:
            activation['fallback']='failed_ownership'
            if state is not None and state_file is not None:
                state['desktop_activation']=activation;write_state(state_file,state)
            raise
        focused=subprocess.run([xdotool,'windowfocus','--sync',window],capture_output=True,text=True)
        if focused.returncode!=0:
            activation['fallback']='failed_focus';
            if state is not None and state_file is not None:
                state['desktop_activation']=activation;write_state(state_file,state)
            raise RuntimeError('isolated Desktop window focus fallback failed')
        active=subprocess.run([xdotool,'getactivewindow'],capture_output=True,text=True)
        if active.returncode!=0 or active.stdout.strip()!=str(window):
            activation['fallback']='failed_active_window';
            if state is not None and state_file is not None:
                state['desktop_activation']=activation;write_state(state_file,state)
            raise RuntimeError('focus fallback did not make the owned Desktop window active')
        try:
            _owned_desktop_window(xdotool,window,pid)
        except RuntimeError:
            activation['fallback']='failed_ownership'
            if state is not None and state_file is not None:
                state['desktop_activation']=activation;write_state(state_file,state)
            raise
        activation['fallback']='succeeded'
    if state is not None and state_file is not None:
        state['desktop_activation']=activation;write_state(state_file,state)
    return activation


def wait_prepared_desktop_readiness(state,state_file):
    """Wait for a stable owned prepared window before the one send shortcut.

    Desktop has no supported composer-element locator.  The narrow substitute is
    an owned window that remains the active window across consecutive observations
    after a conservative URI hydration interval.  This function never sends a
    key and does not turn elapsed time into a delivery receipt; it only prevents
    an immediate shortcut from racing the prepared composer.
    """
    started_at=state.get('started_at')
    if not isinstance(started_at,(int,float)):
        raise RuntimeError('Desktop start receipt lacks a valid timestamp')
    started_monotonic=state.get('started_monotonic')
    if isinstance(started_monotonic,(int,float)):
        deadline=started_monotonic+DESKTOP_READY_TIMEOUT_SECONDS
    else:
        # Legacy state has only the wall-clock start receipt.  Translate its
        # remaining budget once; all subsequent nested waits use this monotonic
        # deadline and cannot restart a fresh sixty-second lookup.
        deadline=time.monotonic()+max(0.0,started_at+DESKTOP_READY_TIMEOUT_SECONDS-time.time())
    stable_window=None
    observations=0
    last_error=None
    while True:
        if identity(state['pid'])!=state.get('start'):
            raise RuntimeError('isolated Desktop process is not active during prepared-composer readiness')
        now=time.monotonic()
        try:
            xdotool,window=wait_desktop_window(state['pid'],deadline)
            activate_desktop_window(xdotool,window,state['pid'],state,state_file)
            active=subprocess.run([xdotool,'getactivewindow'],capture_output=True,text=True)
            if active.returncode!=0 or active.stdout.strip()!=str(window):
                raise RuntimeError('owned Desktop window is not active during prepared-composer readiness')
            _owned_desktop_window(xdotool,window,state['pid'])
            observations=observations+1 if window==stable_window else 1
            stable_window=window
            hydrated=(time.time()-started_at)>=DESKTOP_COMPOSER_HYDRATION_SECONDS
            state['desktop_readiness']={
                'window':window,
                'observations':observations,
                'hydrated':hydrated,
                'observed_at':now,
            }
            write_state(state_file,state)
            if hydrated and observations>=DESKTOP_READY_OBSERVATIONS:
                state['desktop_readiness']['ready_at']=now
                write_state(state_file,state)
                return xdotool,window
            last_error='Desktop prepared composer is still hydrating'
        except (RuntimeError,subprocess.SubprocessError) as exc:
            stable_window=None;observations=0;last_error=str(exc)
        if time.monotonic()>=deadline:
            state['desktop_readiness']={'status':'timeout','reason':last_error or 'readiness unavailable'}
            write_state(state_file,state)
            raise RuntimeError('Desktop prepared composer did not become stably ready before submission')
        time.sleep(DESKTOP_READY_POLL_SECONDS)


def submit_prepared_desktop_prompt(state,state_file):
    """Submit the URI-prepared prompt without guessing a compositor coordinate.

    Current Codex Desktop exposes an owned X11 window and durable task records;
    it does not expose a supported composer-element locator.  ``start`` supplies
    the literal prompt in the ``codex://threads/new`` URI, leaving that prepared
    composer as the focused child of the owned window.  Clicking a fixed pixel
    position was neither a composer proof nor portable across current window
    layouts, and could instead steal the prepared child's focus.  Keep the
    actual supported transport deliberately small: activate the exact owned
    window, send plain Return once, then require exactly one durable new thread.
    """
    if state.get('desktop_submission_status')=='ambiguous':
        raise RuntimeError('Desktop submission is ambiguous; inspect receipts before any further input')
    xdotool,window=wait_prepared_desktop_readiness(state,state_file)
    before=desktop_thread_ids(state['workdir'],state['started_at'])
    # The baseline lookup can take long enough for another window to steal
    # focus. Re-establish the same owned active window immediately before the
    # sole plain Return; ``activate_desktop_window`` verifies both ownership
    # and active-window identity on this final boundary.
    activate_desktop_window(xdotool,window,state['pid'],state,state_file)
    submitted_at=time.time()
    # Readiness has already proved that the owned Desktop window is active.
    # Send the one plain Return through that active focus chain so its prepared
    # URI composer child receives it; targeting the top-level window can bypass
    # the focused child and leave no durable task receipt.
    subprocess.run([xdotool,'key','Return'],check=True)
    created=set();prompt_receipts=set()
    for _ in range(60):
        created=desktop_thread_ids(state['workdir'],state['started_at'])-before
        if len(created)>1:
            state.update(desktop_submission_status='ambiguous',
                         desktop_submission_task_ids=sorted(created),
                         desktop_submission_reason='task_receipt_count_mismatch',
                         desktop_submission_at=submitted_at)
            write_state(state_file,state)
            break
        if len(created)==1:
            candidate_state={**state,'thread_id':next(iter(created))}
            try:
                prompt_receipts=desktop_prompt_receipts(candidate_state,state['prepared_prompt'])
            except RuntimeError:
                state.update(desktop_submission_status='ambiguous',
                             desktop_submission_task_ids=sorted(created),
                             desktop_submission_reason='prompt_receipt_missing',
                             desktop_submission_at=submitted_at)
                write_state(state_file,state)
                raise
            if len(prompt_receipts)==1:break
            if (state.get('desktop_submission_status')!='ambiguous'
                    or state.get('desktop_submission_task_ids')!=sorted(created)):
                state.update(desktop_submission_status='ambiguous',
                             desktop_submission_task_ids=sorted(created),
                             desktop_submission_reason='prompt_receipt_missing',
                             desktop_submission_at=submitted_at)
                write_state(state_file,state)
        time.sleep(.25)
    if len(created)!=1:
        raise RuntimeError(f'Desktop submission produced {len(created)} new task receipts; inspect receipts before any further input')
    if len(prompt_receipts)!=1:
        raise RuntimeError('Desktop submission has no unique exact prepared-prompt receipt; inspect receipts before any further input')
    state['prompt_sent']=True
    state['desktop_window']=window
    state['thread_id']=created.pop()
    state['desktop_submission_status']='success'
    state['desktop_submission_task_ids']=[state['thread_id']]
    state['desktop_transport_receipt']='success'
    state.setdefault('first_submission_at',submitted_at)
    write_state(state_file,state)
    return state['desktop_window']


def _desktop_prompt_turn(entry,thread_id):
    """Return one exact native user-turn text/id from a bound Desktop rollout."""
    if not isinstance(entry,dict):return None
    payload=entry.get('payload')
    if not isinstance(payload,dict):return None
    # Preserve the legacy event envelope used by older Desktop rollouts.
    if entry.get('type')=='event_msg' and payload.get('type')=='item_completed':
        if payload.get('thread_id')!=thread_id:return None
        item=payload.get('item')
        if not isinstance(item,dict) or item.get('type')!='UserMessage':return None
        message_id=item.get('id')
        if not isinstance(message_id,str):return None
        content=item.get('content')
        if not isinstance(content,list):return None
        parts=[]
        for part in content:
            if (not isinstance(part,dict) or part.get('type')!='text'
                    or not isinstance(part.get('text'),str)):
                return None
            parts.append(part['text'])
        return '\n'.join(parts),message_id
    # These are the same current native-turn payload forms accepted by the
    # audit parser. The rollout path is already bound to this exact task; when
    # a host includes an additional thread identity, it must agree as well.
    if entry.get('type') not in {'response_item','event_msg'}:return None
    if payload.get('thread_id') is not None and payload.get('thread_id')!=thread_id:return None
    if payload.get('type')=='message' and payload.get('role')=='user':
        content=payload.get('content')
        message_id=payload.get('id')
        if not isinstance(content,list) or not isinstance(message_id,str):return None
        parts=[]
        for part in content:
            if not isinstance(part,dict) or not isinstance(part.get('text'),str):return None
            parts.append(part['text'])
        return ''.join(parts),message_id
    if payload.get('type')=='user_message' and isinstance(payload.get('message'),str):
        message_id=payload.get('id')
        if not isinstance(message_id,str):return None
        return payload['message'],message_id
    return None


def desktop_prompt_receipts(state,prompt):
    """Read only typed user-message identities for the exact retained task."""
    database=Path.home()/'.cortex-dev/.codex/state_5.sqlite'
    connection=sqlite3.connect(f'file:{database}?mode=ro',uri=True)
    try:
        row=connection.execute('SELECT rollout_path FROM threads WHERE id=? AND cwd=?',
                               (state['thread_id'],state['workdir'])).fetchone()
    finally:connection.close()
    if not row:raise RuntimeError('retained Desktop task is unavailable')
    ids=set()
    try:
        stream=Path(row[0]).open(encoding='utf-8')
    except OSError:
        return ids
    with stream:
        for line in stream:
            try:entry=json.loads(line)
            except ValueError:continue
            parsed=_desktop_prompt_turn(entry,state['thread_id'])
            if parsed is None:continue
            text,message_id=parsed
            # The real Desktop editor appends one paragraph newline. Accept that
            # observed serialization only; changed characters or extra whitespace
            # still invalidate the literal-delivery receipt.
            if text in {prompt,prompt+'\n'}:ids.add(message_id)
    return ids


def steer_desktop(state,state_file,prompt_file,composer_x,composer_y):
    """One literal insertion at an operator-observed composer; no readiness inference."""
    if not state.get('prompt_sent') or not state.get('thread_id'):
        raise RuntimeError('send the initial prepared prompt first')
    prompt=prompt_file.read_text(encoding='utf-8').rstrip('\r\n')
    # xdotool type is used only for the ASCII fixture route; no clipboard mutation.
    if not prompt or len(prompt)>32000 or not prompt.isascii():
        raise RuntimeError('steering transport requires a bounded ASCII fixture prompt')
    digest=hashlib.sha256(prompt.encode()).hexdigest()
    if digest in state.get('steering_deliveries',{}):
        raise RuntimeError('steering already attempted; inspect receipts and composer instead of replaying')
    xdotool,window=desktop_window(state['pid'])
    x,y,width,height=window_geometry(xdotool,window)
    if not (0<=composer_x<width and 0<=composer_y<height):
        raise RuntimeError('observed composer position lies outside the owned window')
    before=desktop_prompt_receipts(state,prompt)
    state.setdefault('steering_deliveries',{})[digest]='attempted';write_state(state_file,state)
    subprocess.run([xdotool,'windowactivate','--sync',window],check=True)
    subprocess.run([xdotool,'mousemove',str(x+composer_x),str(y+composer_y),'click','1'],check=True)
    # Let the observed composer receive focus before synthesizing characters;
    # the exact native receipt below, not this delay, establishes delivery.
    time.sleep(.25)
    subprocess.run([xdotool,'type','--clearmodifiers','--delay','15','--',prompt],check=True)
    subprocess.run([xdotool,'key','--window',window,'ctrl+Return'],check=True)
    for _ in range(60):
        new=desktop_prompt_receipts(state,prompt)-before
        if new:break
        time.sleep(.25)
    if len(new)!=1:raise RuntimeError('steering has no unique exact user-message receipt; inspect before any further input')
    state['steering_deliveries'][digest]='received';write_state(state_file,state)
    print('Submitted steering once to the retained Desktop task; one exact user-message receipt observed.')


def main():
    p=argparse.ArgumentParser();sub=p.add_subparsers(dest='action',required=True)
    s=sub.add_parser('start');s.add_argument('--workdir',type=Path,required=True);s.add_argument('--prompt-file',type=Path)
    s.add_argument('--rubber-duck-opt-in',action='store_true',help='explicitly allow only mcp-rubber-duck')
    s.add_argument('--expected-result-sha256')
    s.add_argument('--expected-result-path',default='RESULT.md')
    s=sub.add_parser('steer');s.add_argument('--prompt-file',type=Path,required=True);s.add_argument('--composer-x',type=int,required=True);s.add_argument('--composer-y',type=int,required=True)
    sub.add_parser('status');sub.add_parser('send');e=sub.add_parser('events');e.add_argument('--limit',type=int);h=sub.add_parser('hooks');h.add_argument('--limit',type=int);c=sub.add_parser('calls');c.add_argument('--limit',type=int);sub.add_parser('usage');sub.add_parser('audit');sub.add_parser('stop')
    args=p.parse_args();
    if getattr(args,'rubber_duck_opt_in',False): os.environ['CORTEX_RUBBER_DUCK_OPT_IN']='1'
    private();state_file=STATE/'session.json'
    if args.action=='start':
        if state_file.exists():
            old=json.loads(state_file.read_text())
            if identity(old['pid'])==old['start']:raise RuntimeError('Desktop test process is already active')
        workdir=args.workdir.resolve(strict=True)
        store=project_store(workdir)
        subprocess.run([str(ROOT/'scripts/cortex-dev'),'--prepare-only'],cwd=workdir,check=True)
        binary=Path(os.environ.get('CORTEX_DESKTOP_BINARY','/usr/bin/chatgpt')).resolve(strict=True)
        if not binary.is_file() or not os.access(binary,os.X_OK):raise RuntimeError('Actual Desktop executable unavailable')
        ensure_git_workspace(workdir)
        profile=Path(tempfile.mkdtemp(prefix='profile-',dir=STATE));events=Path(tempfile.mkdtemp(prefix='events-',dir=STATE))
        prompt=None
        if args.prompt_file is not None:
            prompt_path=args.prompt_file.resolve(strict=True)
            if prompt_path.is_symlink() or not prompt_path.is_file():
                raise RuntimeError('prompt file must be a regular non-symlink file')
            prompt=prompt_path.read_text(encoding='utf-8').strip()
            if not prompt:raise RuntimeError('prompt file must not be empty')
        if args.expected_result_sha256 is not None and not re.fullmatch(r'[0-9a-f]{64}',args.expected_result_sha256):
            raise RuntimeError('expected RESULT.md SHA-256 must be 64 lowercase hexadecimal characters')
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}',args.expected_result_path):
            raise RuntimeError('expected result must be one regular filename in the project root')
        log=STATE/'desktop.log'
        fd=os.open(log,os.O_CREAT|os.O_WRONLY|os.O_TRUNC|os.O_NOFOLLOW,0o600)
        isolated_config=configure_workspace_network()
        try:
            command=[str(binary),'--user-data-dir='+str(profile)]
            if prompt is None:command.extend(['--open-project',str(workdir)])
            else:command.append('codex://threads/new?'+urllib.parse.urlencode({'path':str(workdir),'prompt':prompt}))
            try:
                child=subprocess.Popen(command,env=environment(profile,events),stdout=fd,stderr=fd,start_new_session=True)
            except Exception:
                restore_workspace_network(isolated_config)
                raise
        finally:os.close(fd)
        state=dict(pid=child.pid,start=identity(child.pid),started_at=time.time(),started_monotonic=time.monotonic(),trial_started_at=time.time(),profile=str(profile),events=str(events),store=str(store),workdir=str(workdir),prompt_supplied=prompt is not None,isolated_config=str(isolated_config))
        if prompt is not None:state['prepared_prompt']=prompt
        if args.expected_result_sha256 is not None:
            state.update(qualification_route=DESKTOP_CURRENT_HOST_ROUTE,
                         desktop_expected_artifact={'path':args.expected_result_path,'sha256':args.expected_result_sha256})
        if prompt is not None:
            state['original_request_sha256']=original_request_digest(prompt)
            state['desktop_editor_source_sha256']=original_request_digest(desktop_editor_source(prompt))
        write_state(state_file,state)
        print('Actual Desktop launched with disposable profile; pid='+str(child.pid))
    else:
        state=json.loads(state_file.read_text())
        alive=identity(state['pid'])==state['start']
        if args.action=='status':print(json.dumps(dict(alive=alive,pid=state['pid'],profile=state['profile'])))
        elif args.action=='steer':
            if not alive:raise RuntimeError('isolated Desktop process is not active')
            steer_desktop(state,state_file,args.prompt_file,args.composer_x,args.composer_y)
        elif args.action=='send':
            if not alive:raise RuntimeError('isolated Desktop process is not active')
            if not state.get('prompt_supplied'):raise RuntimeError('start with --prompt-file before send')
            if state.get('desktop_submission_status')=='ambiguous':
                raise RuntimeError('Desktop submission is ambiguous; inspect receipts before any further input')
            if state.get('prompt_sent'):raise RuntimeError('prepared Desktop prompt was already sent')
            submit_prepared_desktop_prompt(state,state_file)
            print('Submitted the prepared prompt to the exact isolated Desktop window and observed one new task receipt; pid='+str(state['pid']))
        elif args.action=='events':
            if args.limit is not None and (args.limit<1 or args.limit>5000):raise RuntimeError('events limit must be from 1 through 5000')
            rows=observed_events(state['events'],desktop_task_thread_ids(state));rows=rows[-args.limit:] if args.limit is not None else rows
            for row in rows:print(json.dumps(row))
        elif args.action=='hooks':
            if args.limit is not None and (args.limit<1 or args.limit>5000):raise RuntimeError('hooks limit must be from 1 through 5000')
            rows=observed_hook_events(state['events'],desktop_task_thread_ids(state));rows=rows[-args.limit:] if args.limit is not None else rows
            for row in rows:print(json.dumps(row))
        elif args.action=='usage':
            usage=participant_token_usage(state);print(json.dumps(usage))
            if usage.get('status')=='invalid_topology':
                raise RuntimeError('Desktop usage accounting found invalid task topology')
        elif args.action=='calls':
            if args.limit is not None and (args.limit<1 or args.limit>10000):raise RuntimeError('calls limit must be from 1 through 10000')
            rows=observed_tool_calls(state);rows=rows[-args.limit:] if args.limit is not None else rows
            for row in rows:print(json.dumps(row))
        elif args.action=='audit':
            task_threads,foreign_task_roots,invalid_task_topology=desktop_task_inventory(state)
            rows=observed_events(state['events'],task_threads)
            failures=[row for row in rows if row.get('operation')!='initialize' and row.get('outcome')!='success']
            hook_rows=observed_hook_events(state['events'],task_threads)
            hook_failures=[row for row in hook_rows if row.get('outcome')!='success']
            host_rows=observed_tool_calls(state)
            host_failures,resolved_host_failures=classify_host_failures(host_rows)
            error_history=tool_error_history(host_rows)
            orchestration_errors=orchestration_error_history(host_rows)
            open_sessions=open_command_sessions(host_rows)
            open_cells=open_exec_cells(host_rows)
            policy_violations=call_policy_violations(host_rows)
            host_failures,audit_policy,observational_diagnostics,desktop_outcome,desktop_outcome_reason=desktop_current_host_partition(
                host_rows,state,host_failures,policy_violations,
                open_sessions=open_sessions,open_cells=open_cells)
            orchestration_policies=orchestration_policy_violations(audit_policy)
            worker_policies=worker_policy_violations(audit_policy)
            orchestration_host_failures=[row for row in host_failures if is_orchestration_call(row)]
            threads={(row.get('thread_id'),row.get('parent_thread_id')) for row in rows if row.get('thread_id')}
            classification=classify_audit_findings(failures=failures,hook_failures=hook_failures,
                host_failures=host_failures,policy_violations=audit_policy,
                open_sessions=open_sessions,open_cells=open_cells,
                foreign_task_roots=foreign_task_roots,invalid_task_topology=invalid_task_topology)
            participants=participant_token_usage(state).get('participants',[])
            accepted=desktop_final_acceptance(desktop_outcome,classification,participants)
            observational=({'status':'observational_accept','host_enforcement_state':'unverified',
                            'outcome_receipt':desktop_outcome}
                           if accepted else
                           {'status':'BLOCK','host_enforcement_state':'unverified',
                            'reason':desktop_outcome_reason or 'desktop_audit_incomplete'})
            audit_exit_code=0 if accepted else 1
            print(json.dumps(dict(mcp_events=len(rows),hook_actions=len(hook_rows),host_calls=len(host_rows),threads=len(threads),foreign_task_roots=foreign_task_roots,invalid_task_topology=invalid_task_topology,operations=dict(Counter(row.get('operation','unknown') for row in rows)),failures=failures,hook_failures=hook_failures,tool_error_history=error_history,orchestration_error_history=orchestration_errors,host_failures=host_failures,orchestration_host_failures=orchestration_host_failures,resolved_host_failures=resolved_host_failures,policy_violations=audit_policy,observational_diagnostics=observational_diagnostics,worker_policy_violations=worker_policies,orchestration_policy_violations=orchestration_policies,open_sessions=open_sessions,open_cells=open_cells,observational_qualification=observational,audit_exit_code=audit_exit_code,**classification)))
            if classification['evidence_integrity_invalidators']:
                raise RuntimeError('Desktop audit found incomplete, unbound, contaminated, or non-terminal evidence')
            if audit_exit_code:
                raise RuntimeError('Desktop audit did not establish a complete current-host observational outcome')
        else:
            if alive:
                os.killpg(state['pid'],signal.SIGTERM)
                for _ in range(30):
                    if identity(state['pid'])!=state['start']:break
                    time.sleep(.1)
                else:raise RuntimeError('Desktop test process has not stopped; disposable profile retained')
            restore_workspace_network(Path(state['isolated_config']))
            for key in ['profile','events']:
                path=Path(state[key])
                if path.parent!=STATE or path.is_symlink():raise RuntimeError('Unsafe Desktop cleanup path')
                shutil.rmtree(path)
            (STATE/'desktop.log').unlink(missing_ok=True);state_file.unlink()
            print('Stopped only the isolated Desktop process and removed its disposable artifacts.')

_PUBLIC_DESKTOP_ACTIONS={'start','send','status','steer','events','hooks','usage','calls','audit','stop'}


def public_desktop_failure(action,error):
    """Classify a helper failure without exposing exception text or private data.

    The returned vocabulary is intentionally small and stable.  It gives the
    operator enough information to choose cleanup, retry, or focus recovery,
    while never serializing paths, commands, subprocess output, or logs.
    """
    action=action if action in _PUBLIC_DESKTOP_ACTIONS else 'unknown'
    detail=str(error).lower()
    if action=='start':
        if 'already active' in detail:
            return {'operation':'start','category':'state','reason':'already_active','recovery':'inspect'}
        if any(marker in detail for marker in ('workdir must','prompt file','expected result')):
            return {'operation':'start','category':'input','reason':'invalid_input','recovery':'fix_input'}
        if isinstance(error,subprocess.CalledProcessError) or 'prepare' in detail:
            return {'operation':'start','category':'preparation','reason':'candidate_preparation_failed','recovery':'cleanup_retry'}
        if any(marker in detail for marker in ('executable unavailable','desktop executable')):
            return {'operation':'start','category':'launch','reason':'executable_unavailable','recovery':'fix_environment'}
        if any(marker in detail for marker in ('config','dependency directory','network')):
            return {'operation':'start','category':'environment','reason':'isolated_environment_unavailable','recovery':'cleanup_retry'}
        return {'operation':'start','category':'launch','reason':'desktop_launch_failed','recovery':'cleanup_retry'}
    if action=='send':
        if isinstance(error,FileNotFoundError) or 'session.json' in detail:
            return {'operation':'send','category':'state','reason':'session_unavailable','recovery':'cleanup'}
        if 'not active' in detail:
            return {'operation':'send','category':'state','reason':'desktop_not_active','recovery':'cleanup'}
        if 'start with --prompt-file' in detail:
            return {'operation':'send','category':'input','reason':'prompt_not_prepared','recovery':'restart'}
        if 'already sent' in detail:
            return {'operation':'send','category':'state','reason':'already_submitted','recovery':'inspect'}
        if 'produced ' in detail and 'new task receipts' in detail:
            if re.search(r'produced\s+[2-9][0-9]*\s+new task receipts',detail):
                return {'operation':'send','category':'submission','reason':'submission_ambiguous','recovery':'inspect'}
            return {'operation':'send','category':'submission','reason':'task_receipt_count_mismatch','recovery':'retry'}
        if 'no unique exact prepared-prompt receipt' in detail:
            return {'operation':'send','category':'submission','reason':'submission_ambiguous','recovery':'inspect'}
        if 'submission is ambiguous' in detail:
            return {'operation':'send','category':'submission','reason':'submission_ambiguous','recovery':'inspect'}
        if any(marker in detail for marker in ('activation','focus','active window','ownership')):
            return {'operation':'send','category':'focus','reason':'owned_window_not_ready','recovery':'focus'}
        return {'operation':'send','category':'transport','reason':'desktop_send_failed','recovery':'inspect'}
    return {'operation':action,'category':'operation','reason':'desktop_operation_failed','recovery':'inspect'}


def public_desktop_failure_message(action,error):
    failure=public_desktop_failure(action,error)
    return ('Desktop test operation failed; operation={operation}; category={category}; '
            'reason={reason}; recovery={recovery}.').format(**failure)


if __name__=='__main__':
    try:main()
    except Exception as error:
        action=next((value for value in sys.argv[1:] if value in _PUBLIC_DESKTOP_ACTIONS),'unknown')
        raise SystemExit(public_desktop_failure_message(action,error)) from None
