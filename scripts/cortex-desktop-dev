ROOT=Path(__file__).resolve().parents[1]
STATE=Path(tempfile.gettempdir())/f'cortex-markdown-desktop-{os.getuid()}'
CONFIG_BACKUP=STATE/'config.toml.before-live-test'
LIVE_MODEL='gpt-5.6-luna'
LIVE_COORDINATOR_EFFORT='high'
LIVE_WORKER_EFFORTS={'medium','high'}
WORKER_MODELS={
    'ordinary': 'gpt-5.6-luna',
    'complex': 'gpt-5.6-terra',
    'security-analysis-microtask': 'gpt-5.6-sol',
}
WORKER_MODEL_CHOICES={
    **{key:{value} for key,value in WORKER_MODELS.items()},
    'research': {'gpt-5.6-luna'},
    'exploration': {'gpt-5.6-luna'},
    'analysis': {'gpt-5.6-luna'},
    'review': {'gpt-5.6-terra'},
    'security-implementation': {'gpt-5.6-luna','gpt-5.6-terra'},
}
WORKER_EFFORTS={
    'gpt-5.6-luna': {'medium','high','xhigh','max'},
    'gpt-5.6-terra': {'medium','high','xhigh','max'},
    'gpt-5.6-sol': {'medium','high','xhigh'},
}
EFFORT_ORDER=('medium','high','xhigh','max')
ADVISORY_POLICY_FLAGS={
    'unsafe_cortex_draft_template_literal','insufficient_diagnostic_output_budget',
    'worker_project_tool_before_cortex_bootstrap','worker_report_catalogue_in_fresh_thread',
    'worker_pipeline_read_in_fresh_thread','summary_exceeds_operating_target',
    'draft_template_profile_mismatch','coordinator_delegation_before_pipeline_publication',
    'browser_before_local_url_ready','batched_browser_mutations',
    'forbidden_browser_tab_attachment','repeated_browser_tab_creation',
    'browser_origin_switch','browser_origin_not_http_verified',
}
