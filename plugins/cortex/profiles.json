    {"name":"planner","filename":"planner.toml","sandbox":"read-only","route_category":"automatic","gates":["plan"]},
    {"name":"qa_engineer","filename":"qa-engineer.toml","sandbox":"workspace-write","route_category":"automatic","gates":["qa"]},
