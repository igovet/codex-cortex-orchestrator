{
  "description": "Cortex activation guardrails for explicitly selected routes.",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 \"$PLUGIN_ROOT/hooks/cortex_activation.py\"", "timeout": 5, "additionalContextLimit": 0}]},
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]}
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLUGIN_ROOT/hooks/cortex_activation.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLUGIN_ROOT/hooks/cortex_activation.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLUGIN_ROOT/hooks/cortex_activation.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 3}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 \"$PLUGIN_ROOT/hooks/cortex_activation.py\"", "timeout": 5}]},
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]}
    ],
    "PostCompact": [
      {"hooks": [{"type": "command", "command": "/usr/bin/python3 -B \"$PLUGIN_ROOT/hooks/cortex_lifecycle_observer.py\"", "timeout": 5}]}
    ]
  }
}
