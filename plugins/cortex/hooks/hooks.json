{
  "description": "Local Cortex source capture, recovery hints, compact receipts, exact registered-file integrity checks and deny-only pre-dispatch boundaries. Requires ordinary Codex hook trust.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 1000
          }
        ],
        "matcher": "^(resume|compact)$"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ],
        "matcher": "^(Bash|exec_command|write_stdin|terminal|read_file|write_file|apply_patch|spawn_agent|Agent|mcp__cortex__.*|mcp__cortex_.*)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ],
        "matcher": "^(Bash|exec_command|write_stdin|terminal|read_file|write_file|apply_patch|mcp__codex_app__send_message_to_thread|send_message_to_thread)$"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/cortex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
